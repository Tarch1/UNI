						local g_thm="Grub-Sekiro" ; mkdir -p /mnt/boot/grub/themes ; cp -r "${SCRIPT_DIR}/Bootloader/$g_thm" /mnt/boot/grub/themes/
						local g_res="1920x1080,1024x768,auto" ; if [[ "$VBTsel" -eq 1 ]]; then g_res="1024x768,auto" ; fi
						sed -i -e "/GRUB_DISABLE_OS_PROBER=/ s/#//g" -e "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/" -e "s/^#GRUB_GFXMODE=.*/GRUB_GFXMODE=$g_res/" -e '/GRUB_THEME=/c GRUB_THEME="/boot/grub/themes/'"$g_thm"'/theme.txt"' -e "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"${grub_extra}\"|" /mnt/etc/default/grub
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 quiet splash $nvdrm\"/" /mnt/etc/default/grub ; fi
						CR grub-mkconfig -o /boot/grub/grub.cfg
						;;
		efistub)        CR efibootmgr -d "$e_dev" -p "${e_num:-1}" -c -L "${OS} Linux ($FS)" -l "\\$kname" -u "$initrd_flags $c_flags" --verbose
						;;
		limine)         mkdir -p /mnt/boot/EFI/BOOT ; cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/
						printf 'timeout: 3\n\n/Linux (%s)\n    protocol: linux\n    kernel_path: boot():/%s\n' "$OS" "$kname" > /mnt/boot/limine.conf
						if [[ -n "$ucode_img" ]]; then printf '    module_path: boot():/%s\n' "$ucode_img" >> /mnt/boot/limine.conf ; fi
						printf '    module_path: boot():/%s\n    cmdline: %s\n' "$irfs" "$c_flags" >> /mnt/boot/limine.conf
						CR efibootmgr -c -d "$e_dev" -p "${e_num:-1}" -L "Limine Bootloader" -l '\EFI\BOOT\BOOTX64.EFI'
						;;
		systemd-boot)   CR bootctl --path=/boot install
						printf 'default arch.conf\ntimeout 3\nconsole-mode max\neditor no\n' > /mnt/boot/loader/loader.conf
						printf 'title Arch Linux\nlinux /%s\n' "$kname" > /mnt/boot/loader/entries/arch.conf
						if [[ -n "$ucode_img" ]]; then printf 'initrd /%s\n' "$ucode_img" >> /mnt/boot/loader/entries/arch.conf ; fi
						printf 'initrd /%s\noptions %s\n' "$irfs" "$c_flags" >> /mnt/boot/loader/entries/arch.conf
						;;
		uki)            mkdir -p /mnt/boot/EFI/BOOT ; printf '%s\n' "$c_flags" > /mnt/boot/cmdline.txt
						CR ukify build --linux=/boot/${kname} --initrd=/boot/${irfs} ${ucode_img:+--microcode=/boot/${ucode_img}} --cmdline=@/boot/cmdline.txt --output=/boot/EFI/BOOT/BOOTX64.EFI
						rm -f /mnt/boot/cmdline.txt
						CR efibootmgr -c -d "$e_dev" -p "${e_num:-1}" -L "Arch Linux (UKI)" -l '\EFI\BOOT\BOOTX64.EFI'
						;;
	esac
}
PKGcheck () {

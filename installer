#!/bin/bash
[[ "$(id -u)" -ne 0 ]] && { echo 'Please run as root.' >&2; exit 1; }
export -n LANGUAGE 2>/dev/null || true
if ! ping -c 1 -W 3 8.8.8.8 &>/dev/null; then echo "Network connection required. Please connect to the internet." ; exit 1 ; fi
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/menu" ]]; then source "${SCRIPT_DIR}/menu" ; else echo "[!] Error: 'menu' file missing!" ; exit 1 ; fi
exec &> >(stdbuf -oL -eL tee -a /tmp/install_$(date +%Y%m%d_%H%M%S).log)
set -E
trap 'SHOWerror' ERR

CR () { "$chroot" /mnt "$@" ; }
CR_USER () { CR sudo -u "$UN" bash -c "$1" ; }
unmount_drive () {
	local disk="$1" dev type mp sw dm_name
	[[ -b "$disk" ]] || return 0
	echo "[i] Releasing mounts, swap and mappings on $disk..."
	while read -r dev type; do
		[[ -n "$dev" ]] || continue
		if grep -qs "^${dev}[[:space:]]" /proc/swaps; then
			swapoff "$dev" 2>/dev/null || true
		fi
		while read -r mp; do
			[[ -n "$mp" && "$mp" != "/" && "$mp" != /run/* ]] || continue
			while read -r sw; do
				[[ -n "$sw" ]] && swapoff "$sw" 2>/dev/null || true
			done < <(awk -v m="$mp" 'NR>1 && $2=="file" && ($1==m || index($1, m"/")==1) {print $1}' /proc/swaps)
			if command -v fuser &>/dev/null; then fuser -km "$mp" 2>/dev/null || true ; fi
			umount -R "$mp" 2>/dev/null || umount -R -l "$mp" 2>/dev/null || true
		done < <(findmnt -rn -o TARGET "$dev" 2>/dev/null | tac || true)
		dm_name="${dev##*/}"
		if [[ "$dev" == /dev/dm-* && -r "/sys/block/${dm_name}/dm/name" ]]; then
			dm_name="$(<"/sys/block/${dm_name}/dm/name")"
		fi
		case "$type" in
			lvm)					if command -v lvchange &>/dev/null; then lvchange -an "$dev" 2>/dev/null || true ; fi
									if command -v dmsetup &>/dev/null; then dmsetup remove -f "$dm_name" 2>/dev/null || true ; fi
									;;
			crypt)					if command -v cryptsetup &>/dev/null; then cryptsetup close "$dm_name" 2>/dev/null || true ; fi
									if command -v dmsetup &>/dev/null; then dmsetup remove -f "$dm_name" 2>/dev/null || true ; fi
									;;
			raid*)					if command -v mdadm &>/dev/null; then mdadm --stop "$dev" 2>/dev/null || true ; fi
									;;
			dm|linear|multipath)	if command -v dmsetup &>/dev/null; then dmsetup remove -f "$dm_name" 2>/dev/null || true ; fi
									;;
		esac
	done < <(lsblk -rnpo NAME,TYPE "$disk" 2>/dev/null | tac || true)
	udevadm settle || true
}
part_path () {
	local p="" ; if [[ "$1" =~ [0-9]$ ]]; then p="p" ; fi
	printf '%s%s%s' "$1" "$p" "$2"
}
luks_open_new () {
	local dev="$1" name="$2" extra="${3:-}" rota="" open_opts=()
	wipefs -a "$dev" 2>/dev/null || true
	printf '%s' "$PASS" | cryptsetup luksFormat --type luks2 ${extra:+$extra} -q "$dev" -d -
	rota=$(lsblk -dnpo ROTA "$dev" 2>/dev/null | tr -d ' ' || true)
	if [[ "$rota" == "0" ]]; then
		open_opts=( --allow-discards --perf-no_read_workqueue --perf-no_write_workqueue --persistent )
	fi
	printf '%s' "$PASS" | cryptsetup open "${open_opts[@]}" "$dev" "$name" -d -
}
Check_required_files () {
	local files=( Bootloader/Refind/themes/Blur-theme/theme.conf Bootloader/Grub-Sekiro/{theme.txt,sekiro_1920x1080.png,select_c.png} Bootloader/Grub-Eiffel/{theme.txt,eiffel_tower_under_construction.png,select_c.png} Conf_files/Quickshell/{qs-session,shell.qml} Conf_files/Wallpapers/theming )
	local miss=()
	for a in "${files[@]}"; do if [[ ! -f "${SCRIPT_DIR}/$a" ]]; then miss+=("$a") ; fi ; done
	if [[ ${#miss[@]} -gt 0 ]]; then echo 'Required file(s) missing:' "${miss[@]}" ; exit 1 ; fi
}
SHOWerror () {
	local err_code=$? ; local call_stack=""
	for (( i=1; i<${#FUNCNAME[@]}-1; i++ )); do
		local func="${FUNCNAME[$i]}" ; local line="${BASH_LINENO[$i-1]}"
		call_stack="${func}(line:${line}) -> $call_stack"
	done
	local err_line="${BASH_LINENO[0]}"
	local err_msg="Error in ${call_stack% -> *} \nActual failure at line: $err_line (Exit code: $err_code)"
	echo -e "$err_msg" >> Errors
	echo -e "\n[CRITICAL ERROR DETECTED]\n$err_msg"
	YesNoSel "Do you want to continue the installation anyway? (Fix: 'nano +$err_line installer')"
	if [[ "$CC" -eq 1 ]]; then echo "OK, still going..." ; else echo "OK, exit." ; exit 1 ; fi
}
DiskPartition() {
	if [[ -z "$DRIVE" ]]; then echo "No drive selected. Closing installation!" ; exit 1 ; fi
	if [[ $(wc -l < /proc/swaps) -gt 1 ]]; then echo "[i] Found active Swap. Disabling..." ; swapoff -a 2>/dev/null || true ; fi
	if grep -qs '/tmp/btrpool' /proc/mounts; then umount -R /tmp/btrpool 2>/dev/null || umount -R -l /tmp/btrpool 2>/dev/null || true ; fi
	if grep -qs '/mnt' /proc/mounts; then
		echo "[i] Found active mount point in /mnt. Unmounting..."
		if command -v fuser &>/dev/null; then fuser -km /mnt 2>/dev/null || true ; fi
		umount -R /mnt 2>/dev/null || umount -R -l /mnt 2>/dev/null || true
	fi
	if command -v vgchange &>/dev/null; then vgchange -an 2>/dev/null || true ; fi
	for dev in /dev/mapper/crypt*; do [[ -b "$dev" ]] && { cryptsetup close "${dev##*/}" 2>/dev/null || dmsetup remove -f "${dev##*/}" 2>/dev/null || true; } || true ; done
	local live_pkgs=()
	if ! command -v sgdisk &>/dev/null; then live_pkgs+=(gptfdisk) ; fi
	if ! command -v parted &>/dev/null; then live_pkgs+=(parted) ; fi
	if ! command -v mkfs.fat &>/dev/null; then live_pkgs+=(dosfstools) ; fi
	if [[ "$FS" == "ext4" || "${ADD_FS:-}" == "ext4" ]] && { ! command -v mkfs.ext4 &>/dev/null || ! command -v filefrag &>/dev/null; }; then live_pkgs+=(e2fsprogs) ; fi
	if [[ "$FS" == "btrfs" || "${ADD_FS:-}" == "btrfs" ]] && ! command -v mkfs.btrfs &>/dev/null; then live_pkgs+=(btrfs-progs) ; fi
	if [[ "${CRYPT:-0}" -eq 1 ]] && ! command -v cryptsetup &>/dev/null; then live_pkgs+=(cryptsetup) ; fi
	if [[ "${LVM:-0}" -eq 1 ]] && ! command -v vgcreate &>/dev/null; then live_pkgs+=(lvm2) ; fi
	if [[ "$ADD_SETUP" -eq 1 && "$ADD_FORMAT" -eq 1 ]]; then
		if [[ "$ADD_FS" == "ntfs" ]] && ! command -v mkfs.ntfs &>/dev/null; then
			if [[ "${OS,,}" == "void" ]]; then live_pkgs+=(ntfs-3g) ; else live_pkgs+=(ntfs-3g ntfsprogs) ; fi
		elif [[ "$ADD_FS" == "exfat" ]] && ! command -v mkfs.exfat &>/dev/null; then
			if $PKGmanager$PKGchk exfat-utils &>/dev/null; then $PKGmanager$PKGrmv$PKGfrc "${PKGrsk[@]}" exfat-utils || true ; fi
			live_pkgs+=(exfatprogs)
		fi
	fi
	if [[ ${#live_pkgs[@]} -gt 0 ]]; then $PKGmanager$PKGinst "${PKGskp[@]}" "${live_pkgs[@]}" ; fi
	unmount_drive "$DRIVE"
	for d in "$DRIVE"?* "$DRIVE"; do [[ -b "$d" ]] && wipefs -af "$d" 2>/dev/null || true ; done
	sgdisk -ozZ "$DRIVE"
	SWAP_PART=""
	if [[ "${LVM:-0}" -eq 0 && "$SWAP" == "partition" ]]; then
		local swap_gb="${SWAP_DIM:-4}"
		if (( swap_gb < 1 )); then swap_gb=4 ; fi
		if [[ "$FW" -eq 0 ]]; then
			parted -s "$DRIVE" -- mktable gpt mkpart "ESP" fat32 2MiB 514MiB mkpart "LINUX-ROOT" 514MiB -"${swap_gb}GiB" mkpart "SWAP" -"${swap_gb}GiB" 100% mkpart "BIOS" 1MiB 2MiB set 1 boot on set 3 swap on set 4 bios_grub on
		else
			parted -s "$DRIVE" -- mktable gpt mkpart "ESP" fat32 1MiB 513MiB mkpart "LINUX-ROOT" 513MiB -"${swap_gb}GiB" mkpart "SWAP" -"${swap_gb}GiB" 100% set 1 esp on set 3 swap on
		fi
		SWAP_PART="$(part_path "$DRIVE" 3)"
	else
		local lvm_flag=()
		if [[ "${LVM:-0}" -eq 1 && "${CRYPT:-0}" -eq 0 ]]; then lvm_flag=( set 2 lvm on ) ; fi
		if [[ "$FW" -eq 0 ]]; then
			parted -s "$DRIVE" -- mktable gpt mkpart "ESP" fat32 2MiB 514MiB mkpart "LINUX-ROOT" 514MiB 100% mkpart "BIOS" 1MiB 2MiB set 1 boot on set 3 bios_grub on "${lvm_flag[@]}"
		else
			parted -s "$DRIVE" -- mktable gpt mkpart "ESP" fat32 1MiB 513MiB mkpart "LINUX-ROOT" 513MiB 100% set 1 esp on "${lvm_flag[@]}"
		fi
	fi
	udevadm settle || true
	BOOT_PART="$(part_path "$DRIVE" 1)" ; ROOT_PART="$(part_path "$DRIVE" 2)" ; DEVICE="${DRIVE##*/}"
	echo "DRIVE=$DRIVE DEVICE=$DEVICE"
	if [[ "$ADD_SETUP" -eq 1 && "$ADD_FORMAT" -eq 1 && -n "$ADD_DRIVE" ]]; then
		unmount_drive "$ADD_DRIVE"
		for d in "$ADD_DRIVE"?* "$ADD_DRIVE"; do [[ -b "$d" ]] && wipefs -af "$d" 2>/dev/null || true ; done
		sgdisk -ozZ "$ADD_DRIVE"
		parted -s "$ADD_DRIVE" -- mktable gpt mkpart "DATA" 1MiB 100%
		udevadm settle || true
		ADD_PARTS=("$(part_path "$ADD_DRIVE" 1)")
	fi
	echo 'We can proceed with the formatting of file system'
	sleep 1 ; echo -e " BP=$BOOT_PART RP=$ROOT_PART SP=${SWAP_PART:-none} AP=${ADD_PARTS[*]} PID=$PID" ; lsblk -f
}
FileSystemFormat() {
	BootLabel='EFI' ; RootLabel='ROOT' ; modules=() ; binaries='' ; CRYPT_ADD_MAP=()
	CRYPT_ROOT_UUID="" ; CRYPT_ROOT_NAME="" ; TARGET_ROOT="" ; TARGET_SWAP=""
	SWAPID="" ; SWAP_UUID="" ; SWAP_PARTUUID="" ; ROOT_FS_UUID=""
	RESUME_DEV="" ; RESUME_OFFSET="" ; EPHEMERAL_SWAP=0
	local eff_pid="$PID"
	mkfs.fat -F32 -n "$BootLabel" "$BOOT_PART"
	BOOTID="$(blkid -s "$PID" -o value "$BOOT_PART")"

	if [[ "${CRYPT:-0}" -eq 1 || "${LVM:-0}" -eq 1 ]]; then
		if [[ "$PID" == "PARTUUID" ]]; then eff_pid="UUID" ; fi
	fi

	local pv_dev="$ROOT_PART"
	if [[ "${CRYPT:-0}" -eq 1 ]]; then
		if [[ "${LVM:-0}" -eq 1 ]]; then CRYPT_ROOT_NAME="cryptlvm" ; else CRYPT_ROOT_NAME="cryptroot" ; fi
		luks_open_new "$ROOT_PART" "$CRYPT_ROOT_NAME"
		CRYPT_ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"
		pv_dev="/dev/mapper/$CRYPT_ROOT_NAME"
	fi

	if [[ "${LVM:-0}" -eq 1 ]]; then
		pvcreate -ff -y "$pv_dev"
		vgcreate vg0 "$pv_dev"
		if [[ "$SWAP" == "lvm" ]]; then
			lvcreate -L "${SWAP_DIM}G" -n swap vg0
			TARGET_SWAP="/dev/vg0/swap"
		fi
		lvcreate -l 100%FREE -n root vg0
		TARGET_ROOT="/dev/vg0/root"
	else
		TARGET_ROOT="$pv_dev"
		if [[ "$SWAP" == "partition" ]]; then
			if [[ "${CRYPT:-0}" -eq 1 ]]; then
				EPHEMERAL_SWAP=1
				wipefs -a "$SWAP_PART" 2>/dev/null || true
				SWAP_PARTUUID="$(blkid -s PARTUUID -o value "$SWAP_PART")"
			else
				TARGET_SWAP="$SWAP_PART"
			fi
		fi
	fi

	UNIfstab="$PID=$BOOTID /boot vfat defaults 0 2\n"
	if [[ -n "$TARGET_SWAP" ]]; then
		mkswap -L SWAP "$TARGET_SWAP" ; udevadm settle || true
		SWAPID="$(blkid -s "$eff_pid" -o value "$TARGET_SWAP")"
		SWAP_UUID="$(blkid -s UUID -o value "$TARGET_SWAP")"
		UNIfstab+="$eff_pid=$SWAPID none swap defaults 0 0\n"
	fi

	case "$FS" in
		ext4)	mkfs.ext4 -F -L "$RootLabel" "$TARGET_ROOT"
				ROOTID="$(blkid -s "$eff_pid" -o value "$TARGET_ROOT")"
				ROOT_FS_UUID="$(blkid -s UUID -o value "$TARGET_ROOT")"
				mount "$TARGET_ROOT" /mnt
				UNIfstab+="$eff_pid=$ROOTID / ext4 defaults 0 1\n"
				if [[ "$SWAP" == "swapfile" ]]; then
					if ! mkswap -U clear --size "${SWAP_DIM}G" --file /mnt/swapfile 2>/dev/null; then
						dd if=/dev/zero of=/mnt/swapfile bs=1M count=$(( SWAP_DIM * 1024 )) status=progress
						chmod 600 /mnt/swapfile
						mkswap -U clear /mnt/swapfile
					fi
					swapon /mnt/swapfile
					UNIfstab+="/swapfile none swap defaults 0 0\n"
					if [[ "${HIB:-0}" -eq 1 ]]; then
						RESUME_OFFSET="$(filefrag -v /mnt/swapfile | awk -F: '$1 ~ /^[[:space:]]*0$/ {gsub(/^[[:space:]]+|\.\..*/, "", $3); print $3; exit}')"
					fi
				fi
				;;
		btrfs)	modules=(btrfs) ; binaries='btrfs'
				local options='noatime,compress=zstd,space_cache=v2,discard=async'
				mkfs.btrfs -fL "$RootLabel" "$TARGET_ROOT"
				ROOTID="$(blkid -s "$eff_pid" -o value "$TARGET_ROOT")"
				ROOT_FS_UUID="$(blkid -s UUID -o value "$TARGET_ROOT")"
				mkdir -p /tmp/btrpool ; mount "$TARGET_ROOT" /tmp/btrpool
				for sv_map in "@:/" "@home:/home" "@var_log:/var/log" "@var_cache:/var/cache" "@snapshots:/.snapshots"; do
					local sv="${sv_map%%:*}" d_path="${sv_map#*:}"
					btrfs su cr "/tmp/btrpool/$sv"
					mkdir -p "/mnt$d_path"
					mount -o "defaults,$options,subvol=$sv" "$TARGET_ROOT" "/mnt$d_path"
					UNIfstab+="$eff_pid=$ROOTID $d_path btrfs $options,subvol=$sv 0 0\n"
				done
				if [[ "$SWAP" == "swapfile" ]]; then
					btrfs su cr /tmp/btrpool/@swap
					mkdir -p /mnt/swap
					mount -o "defaults,noatime,subvol=@swap" "$TARGET_ROOT" /mnt/swap
					UNIfstab+="$eff_pid=$ROOTID /swap btrfs noatime,subvol=@swap 0 0\n"
				fi
				umount /tmp/btrpool ; rmdir /tmp/btrpool
				if [[ "$SWAP" == "swapfile" ]]; then
					btrfs filesystem mkswapfile --size "${SWAP_DIM}g" --uuid clear /mnt/swap/swapfile
					swapon /mnt/swap/swapfile
					UNIfstab+="/swap/swapfile none swap defaults 0 0\n"
					if [[ "${HIB:-0}" -eq 1 ]]; then
						RESUME_OFFSET="$(btrfs inspect-internal map-swapfile -r /mnt/swap/swapfile)"
					fi
				fi
				;;
	esac

	EFF_PID="$eff_pid"
	if [[ -n "$TARGET_SWAP" ]]; then swapon "$TARGET_SWAP" ; fi
	if [[ "${HIB:-0}" -eq 1 ]]; then
		if [[ "$SWAP" == "swapfile" ]]; then RESUME_DEV="UUID=$ROOT_FS_UUID"
		elif [[ -n "$SWAP_UUID" ]]; then RESUME_DEV="UUID=$SWAP_UUID" ; fi
	fi

	mkdir -p /mnt/boot ; mount "$BOOT_PART" /mnt/boot
	if [[ "$ADD_SETUP" -eq 1 && ${#ADD_PARTS[@]} -gt 0 ]]; then
		for idx in "${!ADD_PARTS[@]}"; do
			local part="${ADD_PARTS[$idx]}" cname="cryptdata$((idx+1))"
			local target_add="$part"
			if [[ "$ADD_FORMAT" -eq 1 ]]; then
				if [[ "${CRYPT:-0}" -eq 1 ]]; then
					luks_open_new "$part" "$cname"
					target_add="/dev/mapper/$cname"
					CRYPT_ADD_MAP+=("$cname:$(blkid -s UUID -o value "$part")")
				fi
				local flags=(-f -L)
				if [[ "$ADD_FS" == "ext4" ]]; then flags=(-F -L) ; elif [[ "$ADD_FS" == "ntfs" ]]; then flags=(-f -F -L) ; elif [[ "$ADD_FS" == "exfat" ]]; then flags=(-n) ; fi
				mkfs."$ADD_FS" "${flags[@]}" "$ADD_LABEL" "$target_add"
			else
				if grep -qs "^$part " /proc/mounts; then umount "$part" ; fi
				if [[ "$(blkid -s TYPE -o value "$part" 2>/dev/null || true)" == "crypto_LUKS" ]]; then
					if [[ "${CRYPT:-0}" -eq 1 && -n "$PASS" ]] && printf '%s' "$PASS" | cryptsetup luksOpen "$part" "$cname" -d - 2>/dev/null; then
						CRYPT_ADD_MAP+=("$cname:$(blkid -s UUID -o value "$part")")
					else
						local old_pass=""
						while true; do
							IFS= read -rs -p "Enter existing LUKS passphrase for $part: " old_pass </dev/tty ; echo >/dev/tty
							if [[ -n "$old_pass" ]] && printf '%s' "$old_pass" | cryptsetup luksOpen "$part" "$cname" -d - 2>/dev/null; then break ; fi
							echo "Wrong passphrase, try again..."
						done
						if [[ "${CRYPT:-0}" -eq 1 && -n "$PASS" ]]; then
							install -m 600 /dev/null /tmp/luks_old.key ; install -m 600 /dev/null /tmp/luks_new.key
							printf '%s' "$old_pass" > /tmp/luks_old.key ; printf '%s' "$PASS" > /tmp/luks_new.key
							if cryptsetup luksAddKey -q "$part" /tmp/luks_new.key -d /tmp/luks_old.key && cryptsetup luksRemoveKey -q "$part" /tmp/luks_old.key; then
								CRYPT_ADD_MAP+=("$cname:$(blkid -s UUID -o value "$part")")
							else
								echo "[!] Warning: failed to unify LUKS passphrase on $part. Skipping auto-unlock entry."
							fi
							rm -f /tmp/luks_old.key /tmp/luks_new.key
						fi
					fi
					target_add="/dev/mapper/$cname"
				fi
			fi
			local mnt_name="HDD"
			if [[ ${#ADD_PARTS[@]} -gt 1 ]]; then
				local plbl ; plbl=$(blkid -s LABEL -o value "$target_add" 2>/dev/null | tr ' ' '_' || true)
				if [[ -n "$plbl" && ! -d "/mnt/media/$plbl" ]]; then mnt_name="$plbl" ; else mnt_name="HDD$((idx+1))" ; fi
			fi
			mkdir -p "/mnt/media/$mnt_name" ; mount "$target_add" "/mnt/media/$mnt_name"
			local add_pid add_type ; add_type=$(blkid -s TYPE -o value "$target_add" || echo auto)
			if ! add_pid=$(blkid -s "$eff_pid" -o value "$target_add") || [[ -z "$add_pid" ]]; then
				add_pid=$(blkid -s UUID -o value "$target_add") ; UNIfstab+="UUID=$add_pid /media/$mnt_name $add_type defaults,noatime,nofail 0 2\n"
			else
				UNIfstab+="$eff_pid=$add_pid /media/$mnt_name $add_type defaults,noatime,nofail 0 2\n"
			fi
		done
	fi
	lsblk -f
}
BaseSystemInstall () {
	if [[ "${OS,,}" == "void" ]]; then
		if [[ "${VOIDINSTALL}" == "XBPS" ]]; then mkdir -p /mnt/var/db/xbps/keys ; cp -r /var/db/xbps/keys/* /mnt/var/db/xbps/keys/ 2>/dev/null || true ; $PKGstrap base-system </dev/tty >/dev/tty 2>&1
		elif [[ "${VOIDINSTALL}" == "ROOTFS" ]]; then
			local tb="void-x86_64" ; if [[ "${LIBRARY}" == "MUSL" ]]; then tb+="-musl" ; fi ; tb+="-ROOTFS.tar.xz"
			if [[ -f "${SCRIPT_DIR}/Conf_files/${tb}" ]]; then tar -xJf "${SCRIPT_DIR}/Conf_files/${tb}" -C /mnt
			else
				local latest_tb ; latest_tb=$(curl -s "https://repo-default.voidlinux.org/live/current/" | grep -oE "void-x86_64$( [[ "${LIBRARY}" == "MUSL" ]] && echo "-musl" )-ROOTFS-[0-9]+\.tar\.xz" | head -n1 || true)
				local dl_url="https://voidlinux.org/static/${tb}" ; if [[ -n "$latest_tb" ]]; then dl_url="https://repo-default.voidlinux.org/live/current/${latest_tb}" ; fi
				curl -Lo "/tmp/${tb}" "$dl_url" ; tar -xJf "/tmp/${tb}" -C /mnt ; rm -f "/tmp/${tb}"
			fi
		fi
		for d in dev proc sys run; do mkdir -p /mnt/$d ; mount --bind /$d /mnt/$d ; done
		mount --make-rslave /mnt/sys
		if [[ "$FW" -eq 1 ]]; then mkdir -p /mnt/sys/firmware/efi/efivars ; mount --bind /sys/firmware/efi/efivars /mnt/sys/firmware/efi/efivars || true ; fi
		cp -L /etc/resolv.conf /mnt/etc/resolv.conf || true
	else
		local BasePKG=( "${kernel[@]}" "${baselinux[@]}" "${logind[@]}" "${microcode[@]}" "${btrfsutility[@]}" )
		$PKGstrap "${BasePKG[@]}" </dev/tty >/dev/tty 2>&1
	fi
}
FStabGen () {
	if [[ "${CRYPT:-0}" -eq 1 && ( ${#CRYPT_ADD_MAP[@]} -gt 0 || "${EPHEMERAL_SWAP:-0}" -eq 1 ) ]]; then
		: > /mnt/etc/crypttab
		if [[ "${OS,,}" == "artix" && "$init_sys" == "openrc" ]]; then : > /mnt/etc/conf.d/dmcrypt ; fi
		if [[ ${#CRYPT_ADD_MAP[@]} -gt 0 ]]; then
			install -m 600 /dev/null /mnt/etc/crypt_key.bin
			dd if=/dev/urandom bs=64 count=1 of=/mnt/etc/crypt_key.bin status=none
			for ce in "${CRYPT_ADD_MAP[@]}"; do
				local c_name="${ce%%:*}" c_uuid="${ce#*:}"
				printf '%s' "$PASS" | cryptsetup luksAddKey -q "/dev/disk/by-uuid/$c_uuid" /mnt/etc/crypt_key.bin -d -
				printf '%s UUID=%s /etc/crypt_key.bin luks,nofail\n' "$c_name" "$c_uuid" >> /mnt/etc/crypttab
				if [[ "${OS,,}" == "artix" && "$init_sys" == "openrc" ]]; then
					printf "target='%s'\nsource='/dev/disk/by-uuid/%s'\nkey='/etc/crypt_key.bin'\n\n" "$c_name" "$c_uuid" >> /mnt/etc/conf.d/dmcrypt
				fi
			done
		fi
		if [[ "${EPHEMERAL_SWAP:-0}" -eq 1 && -n "$SWAP_PARTUUID" ]]; then
			printf 'cryptswap PARTUUID=%s /dev/urandom swap,cipher=aes-xts-plain64,size=512,sector-size=4096\n' "$SWAP_PARTUUID" >> /mnt/etc/crypttab
			if [[ "${OS,,}" == "artix" && "$init_sys" == "openrc" ]]; then
				printf "swap='cryptswap'\nsource='/dev/disk/by-partuuid/%s'\noptions='-c aes-xts-plain64 -s 512 --sector-size 4096'\n\n" "$SWAP_PARTUUID" >> /mnt/etc/conf.d/dmcrypt
			fi
		fi
	fi
	if [[ -f /mnt/etc/fstab ]]; then mv -f /mnt/etc/fstab /mnt/etc/old-fstab ; fi
	if [[ "${OS,,}" == "void" ]]; then printf '%b' "$UNIfstab" > /mnt/etc/fstab
	else "$FSTABgen" -t "$EFF_PID" /mnt >> /mnt/etc/fstab ; fi
	if [[ "${EPHEMERAL_SWAP:-0}" -eq 1 ]]; then
		printf '/dev/mapper/cryptswap none swap defaults 0 0\n' >> /mnt/etc/fstab
	fi
	sed -i -e '/\/media\// s/relatime/noatime,nofail/' \
		-e '/exfat/ s/user_id=[0-9]*,group_id=[0-9]*/uid=1000,gid=1000,umask=0002,nofail/g' \
		-e '/exfat/ s/,default_permissions//g' \
		-e '/exfat/ s/,allow_other//g' \
		-e '/exfat/ s/[[:space:]]0[[:space:]]2$/ 0 0/' /mnt/etc/fstab
	if [[ "${OS,,}" == "artix" && "$init_sys" == "openrc" && "$SWAP" == "swapfile" && "$FS" == "btrfs" && -f /mnt/etc/conf.d/swap ]]; then
		sed -i -e 's/^#rc_before="!localmount"/rc_before="!localmount"/' \
			-e 's/^#rc_need="localmount"/rc_need="localmount"/' /mnt/etc/conf.d/swap
		if ! grep -q '^rc_before="!localmount"' /mnt/etc/conf.d/swap; then printf 'rc_before="!localmount"\n' >> /mnt/etc/conf.d/swap ; fi
		if ! grep -q '^rc_need="localmount"' /mnt/etc/conf.d/swap; then printf 'rc_need="localmount"\n' >> /mnt/etc/conf.d/swap ; fi
	fi
	cat /mnt/etc/fstab
}

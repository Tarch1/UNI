	baselinux=(base-devel) ; if [[ "$os_l" == "void" ]]; then baselinux+=(base-system) ; else baselinux+=(base) ; fi ; if [[ "$os_l" == "artix" ]]; then baselinux+=("${init_sys}") ; fi
	baseutils=(bash-completion vim nano wget git binutils cryptsetup rsync which) ; if [[ "$os_l" == "void" ]]; then baseutils+=(man-pages) ; else baseutils+=(man-db) ; fi
	bluetooth=(bluez) ; if [[ "$UI" != "Quickshell" ]]; then bluetooth+=(blueman) ; fi
	if [[ "$os_l" != "void" ]]; then bluetooth+=(bluez-utils bluetui) ; fi ; if [[ "$os_l" == "artix" ]]; then bluetooth+=("bluez-${init_sys}" bluez-cups) ; fi
	bootloaderutility=(efibootmgr os-prober) ; if [[ "$os_l" != "void" ]]; then bootloaderutility+=(sbsigntools) ; fi
	if [[ "$FS" == "btrfs" ]]; then btrfsutility=(snapper btrfs-progs) ; else btrfsutility=() ; fi
	if [[ "$DE" == "COSMIC" ]]; then desktop=(cosmic xdg-desktop-portal-cosmic)
	elif [[ "$DE" == "GNOME" ]]; then desktop=(gnome gnome-tweaks xdg-desktop-portal-gnome)
	elif [[ "$DE" == "KDE" ]]; then desktop=(plasma-meta dolphin konsole xdg-desktop-portal-kde)
	elif [[ "$DE" == "LXQt" ]]; then desktop=(lxqt xdg-desktop-portal-lxqt)
	elif [[ "$DE" =~ ^(Hyprland|Niri)$ ]]; then
		if [[ "$DE" == "Hyprland" ]]; then desktop=(hyprland xdg-desktop-portal-hyprland)
		else desktop=(niri xdg-desktop-portal-gnome xwayland-satellite) ; fi
		desktop+=(hypridle polkit-kde-agent xdg-desktop-portal-gtk qt6-wayland)
		if [[ "$UI" == "Quickshell" ]]; then
			desktop+=(quickshell qt6-svg qt6-5compat qt6-imageformats qt6-multimedia)
			if [[ "$os_l" != "void" ]]; then desktop+=(qt6-multimedia-ffmpeg) ; fi
		else
			desktop+=(fuzzel waybar swaync hyprlock)
			if [[ "$DE" == "Hyprland" ]]; then desktop+=(hyprpaper) ; fi
		fi
	else desktop=() ; fi
	if [[ "$dm_l" == "gdm" ]]; then displaymanager=(gdm)
	elif [[ "$dm_l" == "greetd" ]]; then if [[ "$UI" == "Quickshell" ]]; then displaymanager=(greetd) ; else displaymanager=(greetd greetd-tuigreet) ; fi
	elif [[ "$dm_l" == "lightdm" ]]; then displaymanager=(lightdm lightdm-gtk-greeter lightdm-gtk-greeter-settings)
	elif [[ "$dm_l" == "ly" ]]; then displaymanager=(ly)
	elif [[ "$dm_l" == "sddm" ]]; then displaymanager=(sddm)
	else displaymanager=() ; fi
	if [[ "$os_l" == "artix" && ! "$dm_l" =~ ^(none|quickshell)$ ]]; then displaymanager+=("${dm_l}-${init_sys}") ; fi
	filemanager=(yazi pcmanfm-qt tumbler file-roller android-tools qt6ct papirus-icon-theme librsvg adwaita-icon-theme) ; if [[ "$os_l" != "void" ]]; then filemanager+=(gvfs-mtp) ; fi
	if [[ "$os_l" == "void" ]]; then fonts=(nerd-fonts) ; else fonts=(ttf-jetbrains-mono-nerd) ; fi
	fs=(dialog mtools parted gptfdisk dosfstools ntfs-3g exfatprogs)
	if [[ "$os_l" != "void" ]]; then fs+=(ntfsprogs) ; fi
	if [[ "$FS" == "ext4" ]]; then fs+=(e2fsprogs) ; fi
	if [[ "$FS" == "btrfs" || "${ADD_FS:-}" == "btrfs" ]]; then fs+=(btrfs-progs) ; fi
	if [[ "${CRYPT:-0}" -eq 1 ]]; then fs+=(cryptsetup) ; fi
	if [[ "${LVM:-0}" -eq 1 ]]; then fs+=(lvm2) ; fi
	grub=() ; grubbtrfs=() ; limine=() ; refind=() ; uki=()
	case "$bl_l" in
		grub)   grub=(grub) ; if [[ "$FS" == "btrfs" && "$os_l" != "void" ]]; then grubbtrfs=(grub-btrfs) ; fi ;;
		limine) limine=(limine) ;;
		refind) refind=(refind) ;;
		uki)    uki=(systemd-ukify) ;;
	esac
	if [[ "$os_l" == "void" ]]; then hardwareacceleration=(mesa-dri mesa-vaapi mesa-vulkan-radeon) ; else hardwareacceleration=(vkd3d) ; if [[ "$CPU_TYPE" == "Intel" ]]; then hardwareacceleration+=(intel-media-driver) ; fi ; fi
	kernel=("${KERNEL}" "${KERNEL}-headers") ; if [[ "$os_l" == "void" ]]; then kernel+=(linux-firmware-network) ; else kernel+=(linux-firmware) ; fi
	if [[ "$IRF" =~ ^(booster|dracut|mkinitcpio)$ ]]; then kernel+=("$IRF") ; fi
	if [[ "$os_l" == "artix" ]]; then logind=(elogind elogind-"${init_sys}" "${init_sys}"-settingsd) ; elif [[ "$os_l" == "void" ]]; then logind=(seatd elogind) ; else logind=() ; fi
	net=(iwd chrony) ; if [[ "$os_l" == "void" ]]; then net+=(NetworkManager) ; else net+=(networkmanager) ; fi ; if [[ "$os_l" == "artix" ]]; then net+=("iwd-${init_sys}" "chrony-${init_sys}" "networkmanager-${init_sys}") ; fi
	print=(cups cups-pdf) ; if [[ "$os_l" == "void" ]]; then print+=(avahi-daemon cups-filters) ; else print+=(avahi system-config-printer) ; fi ; if [[ "$os_l" == "artix" ]]; then print+=("avahi-${init_sys}" "cups-${init_sys}") ; fi
	utility=(imv featherpad ffmpeg libqalculate fd btop fwupd fastfetch grim slurp wf-recorder wlsunset libnotify wl-clipboard xclip swappy brightnessctl playerctl pavucontrol xorg-xwayland)
	if [[ "$UI" == "Quickshell" && ( "$os_l" == "arch" || ( "$os_l" == "artix" && "${ARCHREPO:-0}" == "1" ) ) ]]; then utility+=(python-onnxruntime-cpu python-pillow python-numpy) ; fi
	if [[ "$DE" == "Niri" && "$UI" != "Quickshell" ]]; then utility+=(awww) ; fi
	if [[ "$os_l" != "void" ]]; then utility+=(lact cowfortune pacman-contrib) ; fi
	if [[ "$os_l" == "artix" && "${CRYPT:-0}" -eq 1 ]]; then utility+=("cryptsetup-${init_sys}") ; fi
	if [[ "$os_l" == "artix" && "${LVM:-0}" -eq 1 ]]; then utility+=("lvm2-${init_sys}") ; fi
	if [[ "$os_l" == "arch" && "${ZRAM:-0}" -eq 1 ]]; then utility+=(zram-generator) ; fi
	if [[ "$IS_LAPTOP" -eq 1 ]]; then
		if [[ "$os_l" == "arch" && "$DE" =~ ^(KDE|GNOME|COSMIC)$ ]]; then utility+=(power-profiles-daemon)
		else utility+=(tlp) ; if [[ "$os_l" == "artix" ]]; then utility+=("tlp-${init_sys}") ; fi ; fi
		if [[ "$CPU_TYPE" == "Intel" ]]; then utility+=(thermald) ; if [[ "$os_l" == "artix" ]]; then utility+=("thermald-${init_sys}") ; fi ; fi
	fi
	if [[ "$VBTsel" -eq 1 ]]; then
		if [[ "$VM_TYPE" == "qemu" ]]; then utility+=(spice-vdagent)
		elif [[ "$VM_TYPE" == "vmware" ]]; then if [[ "$os_l" == "void" ]]; then utility+=(open-vm-tools gtkmm) ; else utility+=(open-vm-tools gtkmm3) ; fi
		elif [[ "$VM_TYPE" == "vbox" ]]; then if [[ "$os_l" == "void" ]]; then utility+=(virtualbox-ose-guest) ; else utility+=(virtualbox-guest-utils) ; fi
		fi
	fi
	if [[ "${GPUMANAGERsel,,}" =~ ^(envycontrol|cardwire)$ ]]; then utility+=("${GPUMANAGERsel,,}") ; fi
	if [[ "$os_l" == "void" ]]; then vulkan=(vulkan-loader) ; else vulkan=(vulkan-icd-loader vulkan-mesa-layers) ; if [[ "$CPU_TYPE" == "Intel" ]]; then vulkan+=(vulkan-intel) ; fi ; fi
	if [[ "$os_l" == "void" ]]; then
		VOID_REPOS=(void-repo-nonfree) ; if [[ "$LIBRARY" == "GLIBC" ]]; then VOID_REPOS+=(void-repo-multilib void-repo-multilib-nonfree) ; fi
		$PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${VOID_REPOS[@]}" ; $PKGmanager$PKGinst$PKGupd
	fi
	echo "Checking remote package availability..."
	declare -A repo_map=()
	if [[ "$os_l" == "void" ]]; then while read -r pkg; do [[ -n "$pkg" ]] && repo_map["$pkg"]=1 ; done < <($PKGmanager$PKGchk -R -s "" | awk '{print $2}' | sed 's/-[0-9].*//') ; else while read -r pkg; do [[ -n "$pkg" ]] && repo_map["$pkg"]=1 ; done < <($PKGmanager$PKGinst"lq") ; fi
	local y="amddrivers apps archive audio baselinux baseutils bluetooth bootloaderutility btrfsutility desktop displaymanager filemanager fonts fs grub grubbtrfs hardwareacceleration kernel limine logind microcode net nvidiadrivers print refind uki utility vulkan" ; local miss=()
	for group in $y; do local -n current_group="$group" ; if [[ ${#current_group[@]} -eq 0 ]]; then continue ; fi ; local valid_pkgs=() ; for pkg in "${current_group[@]}"; do if [[ -n "${repo_map[$pkg]:-}" ]]; then valid_pkgs+=("$pkg") ; else miss+=("$pkg") ; fi ; done ; current_group=("${valid_pkgs[@]}") ; done
	if [[ ${#miss[@]} -gt 0 ]]; then echo -e "\n[!] WARNING: Unavailable packages:\n$(printf ' - %s\n' "${miss[@]}" | sort -u)\n" ; printf '%s\n' "${miss[@]}" | sort -u > pkg_missed ; YesNoSel "Are these packages CRITICAL for installation? (Yes = Abort / No = Skip and continue)" ; if [[ "$CC" -eq 1 ]]; then echo "[-] Installation aborted by user." ; exit 0 ; else echo "[*] Missing packages removed." ; fi ; fi
}

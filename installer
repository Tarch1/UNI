		void)	Services+=( iwd NetworkManager chronyd cupsd dbus elogind avahi-daemon bluetoothd seatd ) ;;
	esac
	if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then if [[ "${OSsel,,}" == "arch" && "$DEsel" =~ ^(KDE|GNOME|COSMIC)$ ]]; then Services+=( power-profiles-daemon ) ; else Services+=( tlp ) ; fi ; if [[ "$CPU_TYPE" == "Intel" ]]; then Services+=( thermald ) ; fi ; fi

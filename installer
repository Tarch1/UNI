		else
			local nv_main="nvidia-dkms"
			if [[ "$NVsel" == "OPEN" ]]; then if [[ "$KERNEL" == "linux" ]]; then nv_main="nvidia-open" ; else nv_main="nvidia-open-dkms" ; fi
			elif [[ "$NVsel" == "PROPRIETARY" ]]; then if [[ "$KERNEL" == "linux" ]]; then nv_main="nvidia" ; elif [[ "$KERNEL" == "linux-lts" ]]; then nv_main="nvidia-lts" ; fi ; fi
			nvidiadrivers=("${nv_main}" nvidia-prime nvidia-settings nvidia-utils lib32-nvidia-utils opencl-nvidia lib32-opencl-nvidia libxnvctrl libvdpau libva-nvidia-driver)

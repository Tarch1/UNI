		esac
	fi
	for s in "${Services[@]}"; do
		case "${OSsel,,}:$init_sys" in
			void:*)			CR ln -sf /etc/sv/"$s" /etc/runit/runsvdir/default/ ;;
			arch:*)			CR systemctl enable "$s" ;;
			artix:runit)	CR ln -sf /etc/runit/sv/"$s" /etc/runit/runsvdir/default/ ;;
			artix:s6)		CR touch /etc/s6/adminsv/default/contents.d/"$s" ;;

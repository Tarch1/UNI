#!/bin/bash
[[ "$(id -u)" -ne 0 ]] && { echo 'Please run as root.' >&2; exit 1; }
if ! ping -c 1 -W 3 8.8.8.8 &>/dev/null; then echo "Network connection required. Please connect to the internet." ; exit 1 ; fi
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec &> >(stdbuf -oL -eL tee -a /tmp/install_$(date +%Y%m%d_%H%M%S).log)
set -E
trap 'SHOWerror $LINENO ${FUNCNAME[0]:-main}' ERR

SHOWerror () {
	local err_line="$1" ; local err_func="$2" ; local err_msg="$err_func : line $err_line"
	echo "$err_msg" >> Errors
	YesNoSel "Error in $err_msg. Fix: 'nano +$err_line installer'. Continue?"
	if [[ "$CC" -eq 1 ]]; then echo "OK, still going..." ; else echo "OK, exit." ; exit 1 ; fi
}
Check_required_files () {
	local files=( menu Bootloader/Refind/themes/Blur-theme/theme.conf Bootloader/Grub-Sekiro/{theme.txt,sekiro_1920x1080.png,select_c.png} Bootloader/Grub-Eiffel/{theme.txt,eiffel_tower_under_construction.png,select_c.png} )
	local miss=()
	for a in "${files[@]}"; do if [[ ! -f "${SCRIPT_DIR}/$a" ]]; then miss+=("$a") ; fi ; done
	if [[ ${#miss[@]} -gt 0 ]]; then echo 'Required file(s) missing:' "${miss[@]}" ; exit 1 ; else source "${SCRIPT_DIR}/menu" ; fi
}
DiskPartition() {
	if grep -qs '/mnt' /proc/mounts; then echo "[i] Found active mount point in /mnt. Unmounting..." ; umount -R /mnt ; fi
	if [[ $(wc -l < /proc/swaps) -gt 1 ]]; then echo "[i] Found active Swap. Disabling..." ; swapoff -a ; fi
	local mapper_devs=( 'cryptroot' 'cryptswap' 'cryptdata' )
	for dev in "${mapper_devs[@]}"; do if [[ -b "/dev/mapper/$dev" ]]; then echo "[i] Found active LUKS volume (/dev/mapper/$dev). Closing..." ; cryptsetup close "$dev" ; fi ; done
	if $PKGmanager$PKGchk ntfs-3g &>/dev/null; then $PKGmanager$PKGrmv$PKGfrc "${PKGrsk[@]}" ntfs-3g || true ; fi
	$PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${fs[@]}"
	for p in "$DRIVE"?*; do if grep -qs "^$p " /proc/mounts; then echo "[i] Unmounting active partition $p..." ; umount "$p" ; fi ; done
	sgdisk -ozZ "$DRIVE"
	local total_ram_gb=$(( ($(free -m | awk '/^Mem:/{print $2}') + 1023) / 1024 ))
	local swap_gb
	if [[ "$total_ram_gb" -le 8 ]]; then swap_gb=$(( total_ram_gb + 1 )) ; elif [[ "$total_ram_gb" -le 32 ]]; then swap_gb=$total_ram_gb ; else swap_gb=32 ; fi
	parted -sf "$DRIVE" -- mktable gpt mkpart "ESP" fat32 1MiB 513MiB mkpart "LINUX-ROOT" 513MiB -"${swap_gb}GiB" mkpart "SWAP" -"${swap_gb}GiB" 100% set 1 esp on set 3 swap on
	udevadm settle || true
	local p=""
	if [[ "$DRIVE" =~ [0-9]$ ]]; then p="p" ; fi
	BOOT_PART="${DRIVE}${p}1" ; ROOT_PART="${DRIVE}${p}2" ; SWAP_PART="${DRIVE}${p}3" ; DEVICE="${DRIVE##*/}"
	echo "DRIVE=$DRIVE DEVICE=$DEVICE"
	if [[ "$ADD_SETUP" -eq 1 && -n "$ADDITIONAL_DRIVE" ]]; then
		for ap in "$ADDITIONAL_DRIVE"?*; do if grep -qs "^$ap " /proc/mounts; then echo "[i] Unmounting $ap..." ; umount "$ap" ; fi ; done
		sgdisk -ozZ "$ADDITIONAL_DRIVE"
		parted -sf "$ADDITIONAL_DRIVE" -- mktable gpt mkpart "DATA" 1MiB 100%
		udevadm settle || true
		local ap_p=""
		if [[ "$ADDITIONAL_DRIVE" =~ [0-9]$ ]]; then ap_p="p" ; fi
		ADD_PART="${ADDITIONAL_DRIVE}${ap_p}1"
	fi
	if [[ -z "$DRIVE" || -z "$DEVICE" ]]; then echo "No partition were created, check the installer. Closing installation!" ; exit 1 ; else echo 'We can proceed with the formatting of file system' ; fi
	sleep 1 ; echo -e " BP=$BOOT_PART RP=$ROOT_PART AP=$ADD_PART PID=$PIDsel" ; lsblk -f
}
FileSystemFormat() {
	BootLabel='EFI'; RootLabel='ROOT'
	mkfs.fat -F32 -n "$BootLabel" "$BOOT_PART"
	BOOTID="$(blkid -s "$PIDsel" -o value "$BOOT_PART")"
	if [[ "$LUKS_ENC" -eq 1 ]]; then
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$ROOT_PART" -d -
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$ROOT_PART" cryptroot -d -
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$SWAP_PART" -d -
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$SWAP_PART" cryptswap -d -
		TARGET_ROOT="/dev/mapper/cryptroot"; TARGET_SWAP="/dev/mapper/cryptswap"
		CRYPT_ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"; CRYPT_SWAP_UUID="$(blkid -s UUID -o value "$SWAP_PART")"
	else
		TARGET_ROOT="$ROOT_PART"; TARGET_SWAP="$SWAP_PART"
	fi
	mkswap "$TARGET_SWAP"
	SWAPID="$(blkid -s "$PIDsel" -o value "$TARGET_SWAP")"
	UNIfstab="$PIDsel=$BOOTID /boot vfat defaults 0 2\n$PIDsel=$SWAPID none swap defaults 0 0\n"
	case "$FSsel" in
		ext4)	mkfs.ext4 -L "$RootLabel" "$TARGET_ROOT"
				ROOTID="$(blkid -s "$PIDsel" -o value "$TARGET_ROOT")"
				mount "$TARGET_ROOT" /mnt
				UNIfstab+="$PIDsel=$ROOTID / ext4 defaults 0 1\n"
				;;
		btrfs)	modules=(btrfs); binaries='btrfs'
				local SUBVolumes=( 'home' 'var_log' 'var_cache' 'snapshots' )
				local options='noatime,compress=zstd,space_cache=v2,discard=async'
				mkfs.btrfs -fL "$RootLabel" "$TARGET_ROOT"
				ROOTID="$(blkid -s "$PIDsel" -o value "$TARGET_ROOT")"
				mkdir -p /tmp/btrpool; mount "$TARGET_ROOT" /tmp/btrpool
				btrfs su cr /tmp/btrpool/@
				mount -o defaults,"$options",subvol=@ "$TARGET_ROOT" /mnt
				UNIfstab+="$PIDsel=$ROOTID / btrfs $options,subvol=@ 0 0\n"
				for c in "${SUBVolumes[@]}"; do
					btrfs su cr /tmp/btrpool/@"$c"
					local d_path="/$c"
					if [[ "$c" == "snapshots" ]]; then d_path="/.$c"; elif [[ "$c" == "var_log" ]]; then d_path="/var/log"; elif [[ "$c" == "var_cache" ]]; then d_path="/var/cache"; fi
					mkdir -p "/mnt$d_path"; mount -o defaults,"$options",subvol=@"$c" "$TARGET_ROOT" "/mnt$d_path"
					UNIfstab+="$PIDsel=$ROOTID $d_path btrfs $options,subvol=@$c 0 0\n"
				done
				umount /tmp/btrpool; rmdir /tmp/btrpool
				;;
	esac
	export BOOTID ROOTID SWAPID TARGET_ROOT TARGET_SWAP CRYPT_ROOT_UUID CRYPT_SWAP_UUID
	swapon "$TARGET_SWAP"
	mkdir -p /mnt/boot; mount "$BOOT_PART" /mnt/boot
	if [[ "$ADD_SETUP" -eq 1 && -n "$ADD_PART" ]]; then
		local TARGET_ADD="$ADD_PART"
		if [[ "$LUKS_ENC" -eq 1 && "$ADD_FORMAT" -eq 1 ]]; then
			echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$ADD_PART" -d -
			echo -n "$LUKS_PASS" | cryptsetup luksOpen "$ADD_PART" cryptdata -d -
			TARGET_ADD="/dev/mapper/cryptdata"; CRYPT_ADD_UUID="$(blkid -s UUID -o value "$ADD_PART")"; export CRYPT_ADD_UUID
		elif [[ "$LUKS_ENC" -eq 1 ]]; then TARGET_ADD="/dev/mapper/cryptdata"; fi
		if [[ "$ADD_FORMAT" -eq 1 ]]; then
			local flags=(-f -L)
			if [[ "$ADD_FS" == "ext4" ]]; then flags=(-F -L); elif [[ "$ADD_FS" == "exfat" ]]; then flags=(-n); fi
			mkfs."$ADD_FS" "${flags[@]}" "$ADD_LABEL" "$TARGET_ADD"
		fi
		mkdir -p /mnt/media/HDD; mount "$TARGET_ADD" /mnt/media/HDD
		local add_pid; if ! add_pid=$(blkid -s "$PIDsel" -o value "$TARGET_ADD"); then add_pid="$TARGET_ADD"; fi
		local add_type; if ! add_type=$(blkid -s TYPE -o value "$TARGET_ADD"); then add_type="auto"; fi
		UNIfstab+="$PIDsel=$add_pid /media/HDD $add_type defaults,noatime,nofail 0 2\n"
	fi
	lsblk -f
}
ArchTixSystemInstall () {
	local BasePKG=( "${kernel[@]}" "${baselinux[@]}" "${logind[@]}" )
	if [[ -n "$UCODEsel" ]]; then BasePKG+=( "$UCODEsel" ) ; fi
	if [[ "$FSsel" == "btrfs" ]]; then BasePKG+=( "${btrfsutility[@]}" ) ; fi
	"$PKGstrap" /mnt "${BasePKG[@]}"
	if [[ -f /mnt/etc/pacman.conf ]]; then sed -i 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' /mnt/etc/pacman.conf ; fi
}
VoidSystemInstall () {
	local v_repo="https://voidlinux.org"
	if [[ "${LIBsel}" == "MUSL" ]]; then v_repo+="/musl" ; fi
	if [[ "${VImethod}" == "XBPS" ]]; then
		mkdir -p /mnt/var/db/xbps/keys ; cp -r /var/db/xbps/keys/* /mnt/var/db/xbps/keys/ 2>/dev/null || true
		$PKGstrap base-system
	elif [[ "${VImethod}" == "ROOTFS" ]]; then
		local tb="void-x86_64"
		if [[ "${LIBsel}" == "MUSL" ]]; then tb+="-musl" ; fi
		tb+="-ROOTFS.tar.xz"
		if [[ -f "${SCRIPT_DIR}/Conf_files/${tb}" ]]; then tar -xJf "${SCRIPT_DIR}/Conf_files/${tb}" -C /mnt
		else curl -Lo "/tmp/${tb}" "${v_repo}/static/${tb}" ; tar -xJf "/tmp/${tb}" -C /mnt ; rm -f "/tmp/${tb}" ; fi
	fi
	for d in dev proc sys run; do mkdir -p /mnt/$d ; mount --bind /$d /mnt/$d ; done
	mount --make-rslave /mnt/sys
	if [[ "$UEFImode" -eq 1 ]]; then mkdir -p /mnt/sys/firmware/efi/efivars ; mount --bind /sys/firmware/efi/efivars /mnt/sys/firmware/efi/efivars ; fi
	cp /etc/resolv.conf /mnt/etc/resolv.conf || true
}
CrypttabGen () {
	if [[ "$LUKS_ENC" -ne 1 ]]; then return 0 ; fi
	echo -n "$LUKS_PASS" > /mnt/etc/crypt_key.bin ; chmod 600 /mnt/etc/crypt_key.bin
	echo -n "$LUKS_PASS" | cryptsetup luksAddKey -q "$SWAP_PART" /mnt/etc/crypt_key.bin -d -
	if [[ "${OSsel,,}" == "artix" && "$init_sys" == "openrc" ]]; then echo -e "target='cryptswap'\nsource='/dev/disk/by-uuid/$CRYPT_SWAP_UUID'\nkey='/etc/crypt_key.bin'" > /mnt/etc/conf.d/dmcrypt
	else echo "cryptswap UUID=$CRYPT_SWAP_UUID /etc/crypt_key.bin luks" > /mnt/etc/crypttab ; fi
	if [[ -n "$CRYPT_ADD_UUID" ]]; then
		echo -n "$LUKS_PASS" | cryptsetup luksAddKey -q "$ADDITIONAL_DRIVE" /mnt/etc/crypt_key.bin -d -
		if [[ "${OSsel,,}" == "artix" && "$init_sys" == "openrc" ]]; then echo -e "\ntarget='cryptdata'\nsource='/dev/disk/by-uuid/$CRYPT_ADD_UUID'\nkey='/etc/crypt_key.bin'" >> /mnt/etc/conf.d/dmcrypt
		else echo "cryptdata UUID=$CRYPT_ADD_UUID /etc/crypt_key.bin luks,nofail" >> /mnt/etc/crypttab ; fi
	fi
}
FStabGen () {
	if [[ -f /mnt/etc/fstab ]]; then mv -f /mnt/etc/fstab /mnt/etc/old-fstab ; fi
	if [[ "${OSsel,,}" == "void" ]]; then echo -e "$UNIfstab" > /mnt/etc/fstab
	else "$FSTABgen" -t "$PIDsel" /mnt >> /mnt/etc/fstab ; fi
	cat /mnt/etc/fstab
}
SetupEnvironment () {
	local k_map="${keylayout:-KEYMAP=it}"
	if [[ "$k_map" != KEYMAP=* ]]; then k_map="KEYMAP=$k_map" ; fi
	echo "$HNsel" > /mnt/etc/hostname
	echo -e "127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t$HNsel.localdomain\t$HNsel" >> /mnt/etc/hosts
	echo "$k_map" > /mnt/etc/vconsole.conf
	if [[ "${OSsel,,}" == "void" ]]; then
		echo "LANG=$LOCsel" > /mnt/etc/locale.conf ; echo 'HARDWARECLOCK="UTC"' >> /mnt/etc/rc.conf
		"$chroot" /mnt ln -sf /usr/share/zoneinfo/"$TZsel" /etc/localtime
	else
		sed -i "/\($LOCsel\|$LANGsel\)/ s/#//g" /mnt/etc/locale.gen
		echo -e "LANG=$LOCsel\nLANGUAGE=$LANGsel\nLC_TIME=$LOCsel\nLC_ADDRESS=$LOCsel\nLC_MESSAGES=$LOCsel\nLC_CTYPE=C" >> /mnt/etc/locale.conf
		if [[ -n "$keypath" ]]; then echo "$k_map" > /mnt/"$keypath" ; fi
		"$chroot" /mnt bash -c "ln -sf /usr/share/zoneinfo/$TZsel /etc/localtime; hwclock --systohc --utc || true; locale-gen"
	fi
}
PackageConfig () {
	if [[ "${OSsel,,}" == "void" ]]; then
		local v_repos=(void-repo-nonfree)
		if [[ "$LIBsel" == "GLIBC" ]]; then v_repos+=(void-repo-multilib void-repo-multilib-nonfree) ; fi
		"$chroot" /mnt $PKGmanager$PKGinst "${PKGskp[@]}" xbps-allow-references "${v_repos[@]}"
	fi
	if [[ "${OSsel,,}" == "arch" ]]; then sed -i '/\[multilib]/,/mirrorlist/ s/#//' /mnt/etc/pacman.conf ; fi
	if [[ "${OSsel,,}" == "artix" ]]; then sed -i '/\[lib32]/,/mirrorlist/ s/#//' /mnt/etc/pacman.conf ; if [[ "$ARCHrepo" == "1" ]]; then ArchRepoSetup /mnt/etc/pacman.conf ; fi ; fi
	if [[ -f /mnt/etc/pacman.conf ]]; then sed -i -e '/\(Color\|ParallelDownloads\)/ s/#//' -e '/ParallelDownloads/a ILoveCandy' /mnt/etc/pacman.conf ; fi
	"$chroot" /mnt $PKGmanager$PKGinst$PKGupd
}
PackageInstall () {
	local FinalPKGs=( "${baseutils[@]}" "${fs[@]}" "${bootloaderutility[@]}" "${btrfsutility[@]}" "${grub[@]}" "${refind[@]}" "${limine[@]}" "${uki[@]}" "${net[@]}" "${audio[@]}" "${bluetooth[@]}" "${print[@]}" "${apps[@]}" "${utility[@]}" "${filemanager[@]}" "${archive[@]}" "${desktop[@]}" "${displaymanager[@]}" "${logind[@]}" "${fonts[@]}" )
	if [[ "$VBTsel" -eq 1 ]]; then
		if [[ "${OSsel,,}" != "void" ]]; then FinalPKGs=( "${baselinux[@]}" "${FinalPKGs[@]}" ) ; fi
	else
		FinalPKGs+=( "${microcode[@]}" "${kernel[@]}" "${hardwareacceleration[@]}" "${vulkan[@]}" )
		if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then FinalPKGs+=( "${nvidiadrivers[@]}" ) ; fi
		if [[ -v amddrivers && ${#amddrivers[@]} -gt 0 ]]; then FinalPKGs+=( "${amddrivers[@]}" ) ; fi
		if [[ "${OSsel,,}" != "void" ]]; then FinalPKGs+=( "${baselinux[@]}" "${grubbtrfs[@]}" ) ; fi
	fi
	if [[ "${OSsel,,}" == "void" ]]; then "$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${FinalPKGs[@]}"
	else "$chroot" /mnt $PKGmanager$PKGinst$PKGupd"u" "${PKGskp[@]}" "${FinalPKGs[@]}" ; fi
}
PKGcheck () {
	echo "Initializing package groups..."
	if [[ ! -v amddrivers ]]; then amddrivers=() ; fi
	if [[ ! -v nvidiadrivers ]]; then nvidiadrivers=() ; fi
	apps=(kitty telegram-desktop firefox) ; if [[ "${OSsel,,}" != "void" ]]; then apps+=(profile-sync-daemon) ; fi
	archive=(bzip2 cpio gzip xz 7zip tar unrar zip unzip zstd)
	audio=(pipewire wireplumber) ; if [[ "${OSsel,,}" != "void" ]]; then audio+=(pipewire-pulse pipewire-alsa pipewire-jack sof-firmware) ; fi
	baselinux=(base-devel) ; if [[ "${OSsel,,}" == "void" ]]; then baselinux+=(base-system) ; else baselinux+=(base) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then baselinux+=("${init_sys,,}") ; fi
	baseutils=(bash-completion vim nano wget git binutils cryptsetup rsync) ; if [[ "${OSsel,,}" == "void" ]]; then baseutils+=(man-pages) ; else baseutils+=(man-db) ; fi
	bluetooth=(bluez) ; if [[ "${OSsel,,}" != "void" ]]; then bluetooth+=(bluez-utils bluetui blueman) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then bluetooth+=("bluez-${init_sys,,}" bluez-cups) ; fi
	bootloaderutility=(efibootmgr os-prober) ; if [[ "${OSsel,,}" != "void" ]]; then bootloaderutility+=(sbsigntools) ; fi
	if [[ "${OSsel,,}" != "void" ]]; then booster=(booster) ; else booster=() ; fi
	if [[ "$FSsel" == "btrfs" ]]; then btrfsutility=(snapper btrfs-progs) ; else btrfsutility=() ; fi
	if [[ "$DEsel" == "COSMIC" ]]; then desktop=(cosmic xdg-desktop-portal-cosmic)
	elif [[ "$DEsel" == "GNOME" ]]; then desktop=(gnome gnome-tweaks xdg-desktop-portal-gnome)
	elif [[ "$DEsel" == "Hyprland" ]]; then desktop=(hyprland fuzzel waybar swaync hyprlock hypridle polkit-kde-agent xdg-desktop-portal-hyprland xdg-desktop-portal-gtk)
	elif [[ "$DEsel" == "KDE" ]]; then desktop=(plasma-meta dolphin konsole xdg-desktop-portal-kde)
	elif [[ "$DEsel" == "LXQt" ]]; then desktop=(lxqt xdg-desktop-portal-lxqt)
	elif [[ "$DEsel" == "Niri" ]]; then desktop=(niri fuzzel waybar swaync hyprlock hypridle polkit-kde-agent xdg-desktop-portal-gnome xdg-desktop-portal-gtk xwayland-satellite)
	else desktop=() ; fi
	if [[ "${DMsel,,}" == "gdm" ]]; then displaymanager=(gdm)
	elif [[ "${DMsel,,}" == "greetd" ]]; then displaymanager=(greetd greetd-tuigreet)
	elif [[ "${DMsel,,}" == "lightdm" ]]; then displaymanager=(lightdm lightdm-gtk-greeter lightdm-gtk-greeter-settings)
	elif [[ "${DMsel,,}" == "ly" ]]; then displaymanager=(ly)
	elif [[ "${DMsel,,}" == "sddm" ]]; then displaymanager=(sddm)
	else displaymanager=() ; fi
	if [[ "${OSsel,,}" == "artix" && "${DMsel,,}" != "none" ]]; then displaymanager+=("${DMsel,,}-${init_sys,,}") ; fi
	filemanager=(yazi pcmanfm-qt tumbler file-roller android-tools) ; if [[ "${OSsel,,}" != "void" ]]; then filemanager+=(gvfs-mtp) ; fi
	if [[ "${OSsel,,}" == "void" ]]; then fonts=(nerd-fonts) ; else fonts=(ttf-jetbrains-mono-nerd) ; fi
	fs=(dialog mtools parted gptfdisk dosfstools ntfs-3g)
	if [[ "${BLsel,,}" == "grub" ]]; then grub=(grub) ; else grub=() ; fi
	if [[ "$FSsel" == "btrfs" && "${OSsel,,}" != "void" ]]; then grubbtrfs=(grub-btrfs) ; else grubbtrfs=() ; fi
	if [[ "${OSsel,,}" == "void" ]]; then hardwareacceleration=(mesa-dri mesa-vaapi mesa-vulkan-radeon) ; else hardwareacceleration=(intel-media-driver vkd3d) ; fi
	kernel=("${KSel}" "${KSel}-headers") ; if [[ "${OSsel,,}" == "void" ]]; then kernel+=(linux-firmware-network) ; else kernel+=(linux-firmware) ; fi
	if [[ "${OSsel,,}" != "void" ]]; then if [[ "$IRFSetup" == "booster" ]]; then kernel+=(booster) ; elif [[ "$IRFSetup" == "dracut" ]]; then kernel+=(dracut) ; fi ; fi
	if [[ "${BLsel,,}" == "limine" ]]; then limine=(limine) ; else limine=() ; fi
	if [[ "${OSsel,,}" == "artix" ]]; then logind=(elogind elogind-"${init_sys,,}" "${init_sys,,}"-settingsd) ; elif [[ "${OSsel,,}" == "void" ]]; then logind=(seatd) ; else logind=() ; fi
	if [[ -n "$UCODEsel" ]]; then microcode=("$UCODEsel") ; else microcode=() ; fi
	net=(iwd chrony) ; if [[ "${OSsel,,}" == "void" ]]; then net+=(NetworkManager) ; else net+=(networkmanager) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then net+=("chrony-${init_sys,,}" "networkmanager-${init_sys,,}") ; fi
	print=(cups cups-pdf avahi) ; if [[ "${OSsel,,}" == "void" ]]; then print+=(cups-filters) ; else print+=(system-config-printer) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then print+=("avahi-${init_sys,,}" "cups-${init_sys,,}") ; fi
	if [[ "${BLsel,,}" == "refind" ]]; then refind=(refind) ; else refind=() ; fi
	if [[ "${BLsel,,}" == "uki" ]]; then uki=(systemd-ukify) ; else uki=() ; fi
	utility=(imv featherpad libqalculate fd btop fwupd fastfetch grim slurp wl-clipboard swappy awww xorg-xwayland)
	if [[ "${OSsel,,}" != "void" ]]; then utility+=(lact cowfortune pacman-contrib) ; fi
	if [[ "${OSsel,,}" == "artix" && "$LUKS_ENC" -eq 1 ]]; then utility+=("cryptsetup-${init_sys,,}") ; fi
	if ls /sys/class/power_supply/BAT* &>/dev/null; then
		if [[ "${OSsel,,}" == "arch" ]]; then utility+=(power-profiles-daemon) ; else utility+=(tlp) ; if [[ "${OSsel,,}" == "artix" ]]; then utility+=("tlp-${init_sys,,}") ; fi ; fi
		if [[ "$UCODEsel" == "intel-ucode" ]]; then utility+=(thermald) ; if [[ "${OSsel,,}" == "artix" ]]; then utility+=("thermald-${init_sys,,}") ; fi ; fi
	fi
	if [[ "$VBTsel" -eq 1 ]]; then if [[ "${OSsel,,}" == "void" ]]; then utility+=(virtualbox-os-guest) ; else utility+=(virtualbox-guest-utils) ; fi ; fi
	if [[ "${GPUMANAGERsel,,}" == "envycontrol" ]]; then utility+=(envycontrol) ; elif [[ "${GPUMANAGERsel,,}" == "cardwire" ]]; then utility+=(cardwire) ; fi
	if [[ "${OSsel,,}" == "void" ]]; then vulkan=(vulkan-loader) ; else vulkan=(vulkan-icd-loader vulkan-intel vulkan-mesa-layers) ; fi
	if [[ "${OSsel,,}" == "void" ]]; then local v_live_repos=(void-repo-nonfree) ; if [[ "$LIBsel" == "GLIBC" ]]; then v_live_repos+=(void-repo-multilib void-repo-multilib-nonfree) ; fi ; $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${v_live_repos[@]}" || true ; fi
	echo "Downloading remote package indexes..."
	local remote_repo_list="/tmp/remote_pkgs.list"
	if [[ "${OSsel,,}" == "void" ]]; then $PKGmanager$PKGchk -R -s "" | awk '{print $2}' | sed 's/-[0-9].*//' | sort -u > "$remote_repo_list" ; else $PKGmanager$PKGinst$PKGupd"lq" | sort -u > "$remote_repo_list" ; fi
	local y="amddrivers apps archive audio baselinux baseutils bluetooth bootloaderutility booster btrfsutility desktop displaymanager filemanager fonts fs grub grubbtrfs hardwareacceleration kernel limine logind microcode net nvidiadrivers print refind uki utility vulkan"
	local miss=()
	for group in $y; do local -n current_group="$group" ; local valid_pkgs=() ; for pkg in "${current_group[@]}"; do if grep -qx "$pkg" "$remote_repo_list"; then valid_pkgs+=("$pkg") ; else miss+=("$pkg") ; fi ; done ; current_group=("${valid_pkgs[@]}") ; done
	rm -f "$remote_repo_list"
	if [[ ${#miss[@]} -gt 0 ]]; then
		echo -e "\n[!] WARNING: Unavailable packages:\n$(printf ' - %s\n' "${miss[@]}" | sort -u)\n" ; printf '%s\n' "${miss[@]}" | sort -u > pkg_missed
		YesNoSel "Are these packages CRITICAL for installation? (Yes = Abort / No = Skip and continue)"
		if [[ "$CC" -eq 1 ]]; then echo "[-] Installation aborted by user." ; exit 0 ; else echo "[*] Missing packages removed." ; fi
	fi
}
KernelSetup () {
	if [[ "$UCODEsel" == "intel-ucode" ]]; then mkdir -p /mnt/etc/modprobe.d ; echo 'options i915 enable_fbc=1 fastboot=0 enable_dc=4' > /mnt/etc/modprobe.d/i915.conf ; fi
	if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then
		if [[ "${OSsel,,}" == "artix" ]]; then "$chroot" /mnt $PKGmanager$PKGinst$PKGupd"u" "${PKGskp[@]}" "nvidia-utils-${init_sys}" ; fi
		modules+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm) ; echo -e "options nvidia-drm modeset=1 fbdev=1\noptions nvidia NVreg_DynamicPowerManagement=0x02 NVreg_UsePageAttributeTable=1 NVreg_EnablePCIeGen3=1" > /mnt/etc/modprobe.d/nvidia.conf
	fi
	case "$IRFSetup" in
		dracut)			mkdir -p /mnt/etc/dracut.conf.d
						if [[ "$LUKS_ENC" -eq 1 ]]; then echo -e 'add_dracutmodules+=" crypt "\ninstall_items+=" /etc/crypttab /etc/crypt_key.bin "' > /mnt/etc/dracut.conf.d/crypt.conf ; fi
						if [[ "$FSsel" == "btrfs" ]]; then echo 'add_dracutmodules+=" btrfs "' > /mnt/etc/dracut.conf.d/btrfs.conf ; fi
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then echo 'force_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "' > /mnt/etc/dracut.conf.d/nvidia.conf ; fi
						local d_flag="--hostonly" ; if [[ "$IRFSMode" == "Universal" ]]; then d_flag="--no-hostonly" ; fi
						if [[ "${OSsel,,}" == "void" ]]; then
							"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" dracut
							if [[ "$IRFSMode" == "Universal" ]]; then echo "hostonly=\"no\"" > /mnt/etc/dracut.conf.d/hostonly.conf ; else echo "hostonly=\"yes\"" > /mnt/etc/dracut.conf.d/hostonly.conf ; fi
							"$chroot" /mnt xbps-reconfigure -f "$KSel"
						else "$chroot" /mnt dracut $d_flag --kver "$(basename "$(find /mnt/usr/lib/modules/ -maxdepth 1 -mindepth 1 -type d | head -n 1)")" --force /boot/initramfs-"$KSel".img ; fi
						;;
		booster)		local b_opts="mount_timeout: 3m\nvconsole: true\nresume: /dev/disk/by-uuid/${SWAPID}\nmodules: ahci,ata_piix,sd_mod,nvme" ; local b_flag=""
						if [[ "$IRFSMode" == "Universal" ]]; then b_opts="universal: true\n$b_opts" ; b_flag="--universal" ; fi
						if [[ "$FSsel" == "btrfs" ]]; then b_opts+=",btrfs" ; fi
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then b_opts+=",nvidia,nvidia_modeset,nvidia_uvm,nvidia_drm" ; fi
						echo -e "$b_opts" > /mnt/etc/booster.yaml
						if [[ "${OSsel,,}" != "void" ]]; then
							mkdir -p /mnt/etc/pacman.d/hooks
							printf "[Trigger]\nOperation = Install\nOperation = Upgrade\nType = Package\nTarget = linux\nTarget = linux-*\n\n[Action]\nDescription = Forcing Booster initramfs update...\nWhen = PostTransaction\nDepends = booster\nNeedsTargets\nExec = /bin/bash -c 'while read -r pkg; do for d in /usr/lib/modules/*; do if [[ -f \"\$d/pkgbase\" && \"\$(<\"\$d/pkgbase\")\" == \"\$pkg\" ]]; then kver=\"\${d##*/}\"; /usr/bin/booster build --force $b_flag --kernel-version=\"\$kver\" \"/boot/initramfs-\${pkg}.img\"; break; fi; done; done'\n" > /mnt/etc/pacman.d/hooks/95-booster-force.hook
						fi
						"$chroot" /mnt /bin/bash -c "booster build --force $b_flag --kernel-version=$(basename "$(find /mnt/usr/lib/modules/ -maxdepth 1 -mindepth 1 -type d ! -name 'extramodules*' | head -n 1)") /boot/initramfs-${KSel}.img"
						;;
		*)				local HOOKS=(base udev autodetect keyboard keymap modconf block)
						if [[ "$IRFSMode" == "Universal" ]]; then HOOKS=( ${HOOKS[@]/autodetect/} ) ; fi
						if [[ "$LUKS_ENC" -eq 1 ]]; then HOOKS+=(encrypt) ; fi
						HOOKS+=(resume filesystems fsck)
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then HOOKS+=(kms) ; fi
						sed -i -e "/MODULES/ s/()/(${modules[*]})/" -e "/BINARIES/ s/()/($binaries)/" -e "s/^HOOKS.*/HOOKS=(${HOOKS[*]})/" /mnt/etc/mkinitcpio.conf
						"$chroot" /mnt mkinitcpio -p "$KSel"
						;;
	esac
}
ServiceSetup () {
	case "${OSsel,,}" in
		artix)	Services+=( NetworkManager chrony dbus elogind cupsd avahi-daemon bluetoothd )
				if [[ "$LUKS_ENC" -eq 1 ]]; then Services+=( dmcrypt ); fi
				if [[ "$init_sys" == "openrc" ]]; then Services+=( openrc-settingsd ); fi
				if [[ -v nvidiadrivers && ${#nvidiadrivers[@]} -gt 0 ]]; then Services+=( nvidia-persistenced ); fi
				;;
		arch)	Services+=( NetworkManager chronyd cups avahi-daemon bluetooth paccache.timer )
				;;
		void)	Services+=( NetworkManager chronyd cupsd dbus avahi-daemon bluetoothd seatd )
				;;
	esac
	if ls /sys/class/power_supply/BAT* &>/dev/null; then
		if [[ "${OSsel,,}" == "arch" ]]; then Services+=( power-profiles-daemon ) ; else Services+=( tlp ) ; fi
		if [[ "$UCODEsel" == "intel-ucode" ]]; then Services+=( thermald ) ; fi
	fi
	if [[ "$VBTsel" -eq 1 && "${OSsel,,}" != "artix" ]]; then Services+=( vboxservice ) ; fi
	if [[ "${DMsel,,}" =~ ^(ly|greetd|lightdm|sddm|gdm)$ ]]; then Services+=("${DMsel,,}") ; fi
	if [[ "${GPUMANAGERsel,,}" == "cardwire" ]]; then
		Services+=( cardwire )
		case "${OSsel,,}:$init_sys" in
			artix:openrc)	echo -e '#!/sbin/openrc-run\nname="Cardwire GPU Manager"\ncommand="/usr/bin/cardwire"\ncommand_background="yes"\npidfile="/run/${RC_SVCNAME}.pid"\ndepend() {\n\tneed localmount devfs\n\tafter bootmisc\n}' > /mnt/etc/init.d/cardwire ; chmod +x /mnt/etc/init.d/cardwire ;;
			artix:*)		mkdir -p /mnt/etc/runit/sv/cardwire ; echo -e '#!/bin/sh\nexec /usr/bin/cardwire' > /mnt/etc/runit/sv/cardwire/run ; chmod +x /mnt/etc/runit/sv/cardwire/run ;;
			void:*)			mkdir -p /mnt/etc/sv/cardwire ; echo -e '#!/bin/sh\nexec /usr/bin/cardwire' > /mnt/etc/sv/cardwire/run ; chmod +x /mnt/etc/sv/cardwire/run ;;
		esac
	fi
	for s in "${Services[@]}"; do
		case "${OSsel,,}:$init_sys" in
			void:*)			"$chroot" /mnt ln -sf /etc/sv/"$s" /etc/runit/runsvdir/default/ ;;
			arch:*)			"$chroot" /mnt systemctl enable "$s" ;;
			artix:runit)	"$chroot" /mnt ln -sf /etc/runit/sv/"$s" /etc/runit/runsvdir/default/ ;;
			artix:s6)		"$chroot" /mnt touch /etc/s6/adminsv/default/contents.d/"$s" ;;
			artix:dinit)	"$chroot" /mnt ln -sf ../"$s" /etc/dinit.d/boot.d/ ;;
			artix:*)		if [[ "$s" == "dmcrypt" ]]; then "$chroot" /mnt rc-update add "$s" boot ; else "$chroot" /mnt rc-update add "$s" default ; fi ;;
		esac
	done
	mkdir -p /mnt/etc/udev/rules.d/
	if [[ -f "${SCRIPT_DIR}/Conf_files/51-android.rules" ]]; then cp "${SCRIPT_DIR}/Conf_files/51-android.rules" /mnt/etc/udev/rules.d/ ; fi
	if [[ "${DMsel,,}" == "greetd" ]]; then
		local t_cmd="tuigreet --time --cmd "
		if [[ "$DEsel" == "Hyprland" ]]; then t_cmd+="Hyprland" ; fi
		if [[ "$DEsel" == "Niri" ]]; then if [[ "$init_sys" =~ ^(systemd|dinit)$ ]]; then t_cmd+="niri-session" ; else t_cmd+="'niri --session'" ; fi ; fi
		"$chroot" /mnt sed -i -e "s|^command = .*|command = \"$t_cmd\"|" -e 's/^vt = .*/vt = 7/' /etc/greetd/config.toml
	fi
	if [[ "$init_sys" != "systemd" && "$init_sys" != "dinit" ]]; then
		if [[ "$DEsel" =~ ^(Niri|Hyprland)$ ]]; then
			local x_cmd="Hyprland"
			if [[ "$DEsel" == "Niri" ]]; then x_cmd="niri --session" ; fi
			if [[ -f /mnt/usr/share/wayland-sessions/${DEsel,,}.desktop ]]; then "$chroot" /mnt sed -i "s/^Exec=.*/Exec=dbus-run-session $x_cmd/" /usr/share/wayland-sessions/${DEsel,,}.desktop ; fi
		fi
	fi
}
UserSetup () {
	"$chroot" /mnt bash -c "useradd -m -g users -G wheel,video,audio,storage,input,lp,scanner,power,kvm $UNsel && su $UNsel -c 'mkdir -p ~/.config'"
	if [[ "${OSsel,,}" == "void" ]]; then "$chroot" /mnt usermod -aG _seatd "$UNsel" ; fi
	sed -i 's/^#\s*\(%wheel ALL=(ALL:ALL) ALL\)/\1/' /mnt/etc/sudoers
	echo "Choose password for user: $UNsel"
	while true; do if "$chroot" /mnt passwd "$UNsel"; then break ; else echo "Error: Try again..." ; fi ; done
	echo "Choose password for root"
	while true; do if "$chroot" /mnt passwd; then break ; else echo "Error: Try again..." ; fi ; done
	case "${OSsel,,}" in
		void)		echo "Copying configuration files..."
					mkdir -p /mnt/etc/bash
					if [[ -f "${SCRIPT_DIR}/Conf_files/bashrc" ]]; then cp "${SCRIPT_DIR}/Conf_files/bashrc" /mnt/home/"$UNsel"/.bashrc ; fi
					;;
		arch|artix)	echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /mnt/etc/sudoers.d/99-installer-temp
					"$chroot" /mnt sudo -u "$UNsel" bash -c "git clone https://aur.archlinux.org/trizen.git /tmp/trizen && cd /tmp/trizen && makepkg -si --noconfirm"
					rm -f /mnt/etc/sudoers.d/99-installer-temp
					echo "Copying configuration files..."
					mkdir -p /mnt/etc/bash/bashrc.d
					if [[ -f "${SCRIPT_DIR}/Conf_files/bashrc" ]]; then cp "${SCRIPT_DIR}/Conf_files/bashrc" /mnt/etc/bash/bashrc.d/"$UNsel".bashrc ; fi
					if [[ -f "${SCRIPT_DIR}/Conf_files/50-bootbackup.hook" ]]; then mkdir -p /mnt/etc/pacman.d/hooks ; cp "${SCRIPT_DIR}/Conf_files/50-bootbackup.hook" /mnt/etc/pacman.d/hooks/ ; fi
					;;
	esac
	if [[ -f "${SCRIPT_DIR}/Conf_files/kitty.conf" ]]; then mkdir -p /mnt/home/"$UNsel"/.config/kitty ; cp "${SCRIPT_DIR}/Conf_files/kitty.conf" /mnt/home/"$UNsel"/.config/kitty/ ; fi
	echo -e 'include "/usr/share/nano/*.nanorc"\nset linenumbers' > /mnt/etc/nanorc
	echo 'export MOZ_ENABLE_WAYLAND=1' >> /mnt/home/"$UNsel"/.profile
	"$chroot" /mnt sudo -u "$UNsel" bash -c "mkdir -p /home/$UNsel/Pictures/Screenshots /home/$UNsel/.config/swappy && echo -e '[Default]\nsave_dir=/home/$UNsel/Pictures/Screenshots\nsave_filename_format=swappy-%Y%m%d-%H%M%S.png\nshow_panel=false\nline_size=5\ntext_size=20\ntext_font=sans-serif\npaint_mode=brush\nearly_exit=false\nfill_shape=false' > /home/$UNsel/.config/swappy/config"
	if [[ "$DEsel" == "Hyprland" || "$DEsel" == "Niri" ]]; then
		echo "Installing Wallust..."
		API_URL=$(curl -s https://codeberg.org/api/v1/repos/explosion-mental/wallust/releases/latest | grep -o '"browser_download_url": *"[^"]*"' | grep 'x86_64-unknown-linux-musl.tar.gz' | cut -d '"' -f 4)
		if [[ -n "$API_URL" ]] && curl -sA "Mozilla/5.0" -L -o /tmp/wallust_dl.tar.gz "$API_URL" && tar -tf /tmp/wallust_dl.tar.gz &>/dev/null; then
			tar -xzf /tmp/wallust_dl.tar.gz -C /tmp/ ; mv /tmp/wallust /mnt/usr/bin/wallust ; chmod +x /mnt/usr/bin/wallust
		else
			echo "Binary download failed. Compiling from source..."
			"$chroot" /mnt bash -c 'git clone https://codeberg.org/explosion-mental/wallust /tmp/wallust-src && cd /tmp/wallust-src && make && make install'
			rm -rf /mnt/tmp/wallust-src
		fi
		echo "Copying configuration files..."
		"$chroot" /mnt sudo -u "$UNsel" bash -c "mkdir -p ~/.config/hypr"
		for conf in Fuzzel Waybar Swaync Hyprlock Wallust Wallpapers; do if [[ -d "${SCRIPT_DIR}/Conf_files/$conf" ]]; then cp -r "${SCRIPT_DIR}/Conf_files/$conf" /mnt/home/"$UNsel"/.config/"${conf,,}" ; fi ; done
		if [[ -f /mnt/home/"$UNsel"/.config/hyprlock/hypridle.conf ]]; then mv /mnt/home/"$UNsel"/.config/hyprlock/hypridle.conf /mnt/home/"$UNsel"/.config/hypr/hypridle.conf ; fi
		if [[ -f /mnt/home/"$UNsel"/.config/hyprlock/hyprlock.conf ]]; then mv /mnt/home/"$UNsel"/.config/hyprlock/hyprlock.conf /mnt/home/"$UNsel"/.config/hypr/hyprlock.conf ; fi
		touch /mnt/home/"$UNsel"/.config/wallust/colors-waybar.css
		if [[ "$DEsel" == "Hyprland" && -d "${SCRIPT_DIR}/Conf_files/Hyprland" ]]; then cp -a "${SCRIPT_DIR}/Conf_files/Hyprland/." /mnt/home/"$UNsel"/.config/hypr/ ; touch /mnt/home/"$UNsel"/.config/hypr/hyprpaper.conf ; fi
		if [[ "$DEsel" == "Niri" && -d "${SCRIPT_DIR}/Conf_files/Niri" ]]; then cp -r "${SCRIPT_DIR}/Conf_files/Niri" /mnt/home/"$UNsel"/.config/niri ; fi
		"$chroot" /mnt chmod +x /home/"$UNsel"/.config/wallpapers/theme-switcher.sh
		local t_files=()
		if [[ "$DEsel" == "Niri" ]]; then t_files=( "/mnt/home/$UNsel/.config/niri/config.kdl" "/mnt/home/$UNsel/.config/wallust/templates/colors-niri.conf" ) ; fi
		if [[ "$DEsel" == "Hyprland" ]]; then t_files=( "/mnt/home/$UNsel/.config/hypr/hyprland.conf" "/mnt/home/$UNsel/.config/wallust/templates/colors-hyprland.conf" ) ; fi
		for f in "${t_files[@]}"; do
			if [[ ! -f "$f" ]]; then continue ; fi
			if [[ "$VBTsel" -eq 1 ]]; then
				if [[ "$DEsel" == "Niri" ]]; then
					if grep -q "environment *{" "$f"; then	grep -q 'LIBGL_ALWAYS_SOFTWARE' "$f" || sed -i '/environment *{/a\	LIBGL_ALWAYS_SOFTWARE "1"' "$f"
					else echo -e '\nenvironment {\n	LIBGL_ALWAYS_SOFTWARE "1"\n}' >> "$f" ; fi
					grep -q 'VBoxClient' "$f" || sed -i -e '/spawn-at-startup/{i\spawn-at-startup "VBoxClient" "--clipboard"' -e ':a;n;ba}' "$f"
					sed -i 's/blur true/blur false/g' "$f"
				fi
				if [[ "$DEsel" == "Hyprland" && "$f" == *hyprland.conf ]]; then sed -i -e '/exec-once/{i\exec-once = VBoxClient --clipboard' -e ':a;n;ba}' "$f" ; fi
			fi
			if [[ "${OSsel,,}" != "arch" && "$init_sys" != "systemd" ]]; then
				if [[ "$DEsel" == "Niri" ]]; then sed -i -e '/spawn-at-startup/{i\spawn-at-startup "bash" "-c" "pipewire & sleep 1; wireplumber & pipewire-pulse &"' -e ':a;n;ba}' "$f" ; fi
				if [[ "$DEsel" == "Hyprland" && "$f" == *hyprland.conf ]]; then sed -i -e '/exec-once/{i\exec-once = bash -c "pipewire & sleep 1; wireplumber & pipewire-pulse &"' -e ':a;n;ba}' "$f" ; fi
			fi
		done
	fi
}

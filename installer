			   fi ;;
		arch)  Services+=( chronyd cups bluetooth paccache.timer ) ; if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then Services+=( nvidia-suspend nvidia-hibernate nvidia-resume nvidia-powerd ); fi ;;
		void)  Services+=( chronyd cupsd dbus elogind bluetoothd seatd ) ;;
	esac

	if [[ -f /mnt/etc/bluetooth/main.conf ]]; then sed -i 's/#AutoEnable=false/AutoEnable=true/g' /mnt/etc/bluetooth/main.conf ; fi
	if [[ "$init_sys" == "systemd" || "${OSsel,,}" == "arch" ]]; then CR systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service ; fi
	if [[ -f "${SCRIPT_DIR}/Conf_files/51-android.rules" ]]; then cp "${SCRIPT_DIR}/Conf_files/51-android.rules" /mnt/etc/udev/rules.d/ ; fi
	if [[ "${DMsel,,}" == "greetd" ]]; then
		local t_cmd="tuigreet --time --cmd " ; if [[ "$DEsel" == "Hyprland" ]]; then t_cmd+="Hyprland" ; fi ; if [[ "$DEsel" == "Niri" ]]; then if [[ "$init_sys" =~ ^(systemd|dinit)$ ]]; then t_cmd+="niri-session" ; else t_cmd+="'niri --session'" ; fi ; fi
		sed -i -e "s|^command = .*|command = \"$t_cmd\"|" -e 's/^vt = .*/vt = 7/' /mnt/etc/greetd/config.toml
	fi
	if [[ "$init_sys" != "systemd" && "$init_sys" != "dinit" ]]; then
		if [[ "$DEsel" =~ ^(Niri|Hyprland)$ ]]; then

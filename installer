		fi
		if [[ -f "$ucfg/wallust/templates/colors-quickshell.json" ]]; then sed -i "s|\"uiBlur\": *[a-z]*|\"uiBlur\": $init_fx|" "$ucfg/wallust/templates/colors-quickshell.json" ; fi

		local cfg="$ucfg/wallust/templates/colors-niri.conf"

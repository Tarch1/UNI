	fi
	apps=(kitty telegram-desktop firefox) ; if [[ "$os_l" != "void" ]]; then apps+=(profile-sync-daemon) ; fi
	archive=(bzip2 cpio gzip xz 7zip tar unrar zip unzip zstd)

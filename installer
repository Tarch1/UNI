						else CR dracut "$d_flag" --kver "$kver" --force /boot/initramfs-"$KSel".img ; fi
						;;
		booster)		local b_opts="mount_timeout: 3m\nvconsole: true\nresume: /dev/disk/by-uuid/${SWAP_UUID}\nmodules: ahci,ata_piix,sd_mod,nvme,vmd" ; local b_flag=""
						if [[ "$IRFSMode" == "Universal" ]]; then b_opts="universal: true\n$b_opts" ; b_flag="--universal" ; fi
						if [[ "$FSsel" == "btrfs" ]]; then b_opts+=",btrfs" ; fi
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then b_opts+=",nvidia,nvidia_modeset,nvidia_uvm,nvidia_drm" ; fi
						echo -e "$b_opts" > /mnt/etc/booster.yaml
						if [[ "${OSsel,,}" != "void" ]]; then mkdir -p /mnt/etc/pacman.d/hooks ; printf "[Trigger]\nOperation = Install\nOperation = Upgrade\nType = Package\nTarget = linux\nTarget = linux-*\n\n[Action]\nDescription = Forcing Booster initramfs update...\nWhen = PostTransaction\nDepends = booster\nNeedsTargets\nExec = /bin/bash -c 'while read -r pkg; do for d in /usr/lib/modules/*; do if [[ -f \"\$d/pkgbase\" && \"\$(<\"\$d/pkgbase\")\" == \"\$pkg\" ]]; then kver=\"\${d##*/}\"; /usr/bin/booster build --force $b_flag --kernel-version=\"\$kver\" \"/boot/initramfs-\${pkg}.img\"; break; fi; done; done'\n" > /mnt/etc/pacman.d/hooks/95-booster-force.hook ; fi
						CR /bin/bash -c "booster build --force $b_flag --kernel-version=$kver /boot/initramfs-${KSel}.img"
						;;
		*)				local HOOKS=(base udev autodetect keyboard keymap modconf block)
						if [[ "$IRFSMode" == "Universal" ]]; then HOOKS=( "${HOOKS[@]/autodetect/}" ) ; fi
						if [[ "$LUKS_ENC" -eq 1 ]]; then HOOKS+=(encrypt) ; fi
						HOOKS+=(resume filesystems fsck) ; if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then HOOKS+=(kms) ; fi
						sed -i -e "/^MODULES=/ s/()/(${modules[*]})/" -e "/^BINARIES=/ s/()/($binaries)/" -e "s/^HOOKS=.*/HOOKS=(${HOOKS[*]})/" /mnt/etc/mkinitcpio.conf
						CR mkinitcpio -p "$KSel"
						;;
	esac
}
ServiceSetup () {
	Services=()

		if [[ "$VBTsel" -eq 1 ]]; then
			if [[ "$VM_TYPE" == "qemu" ]]; then printf '#!/bin/bash\npkill -x spice-vdagent 2>/dev/null\nexec spice-vdagent\n' > /mnt/usr/bin/vm-clipboard
			else printf '#!/bin/bash\nfor pid in $(pgrep -u "$USER" -x vm-clipboard); do [[ "$pid" != "$$" && "$pid" != "$PPID" ]] && kill "$pid" 2>/dev/null; done\npkill -x VBoxClient 2>/dev/null\nsleep 1\nVBoxClient --clipboard\nold_x="" ; old_w=""\nwhile sleep 0.5; do\n\tpgrep -u "$USER" -x "niri|Hyprland" >/dev/null || exit 0\n\tx=$(xclip -o -selection clipboard -t UTF8_STRING 2>/dev/null || true)\n\tw=$(wl-paste -n 2>/dev/null || true)\n\tif [[ -n "$x" && "$x" != "$old_x" ]]; then old_x="$x"; old_w="$x"; printf "%%s" "$x" | wl-copy\n\telif [[ -n "$w" && "$w" != "$old_w" ]]; then old_w="$w"; old_x="$w"; printf "%%s" "$w" | xclip -selection clipboard -t UTF8_STRING; fi\ndone\n' > /mnt/usr/bin/vm-clipboard ; fi
			chmod +x /mnt/usr/bin/vm-clipboard
			if [[ "$SHELLsel" != "Quickshell" ]]; then
				sed -i 's/blur_passes = 3/blur_passes = 0/' /mnt/home/"$UNsel"/.config/hypr/hyprlock.conf
				sed -i 's/&& hyprlock/\&\& env -u LIBGL_ALWAYS_SOFTWARE hyprlock/g; s/; hyprlock/; env -u LIBGL_ALWAYS_SOFTWARE hyprlock/g; s/) hyprlock/) env -u LIBGL_ALWAYS_SOFTWARE hyprlock/g' /mnt/home/"$UNsel"/.config/waybar/config.jsonc /mnt/home/"$UNsel"/.config/swaync/config.json /mnt/home/"$UNsel"/.config/hypr/hypridle.conf
				sed -i 's/spawn "hyprlock"/spawn "env" "-u" "LIBGL_ALWAYS_SOFTWARE" "hyprlock"/g; s/exec, hyprlock/exec, env -u LIBGL_ALWAYS_SOFTWARE hyprlock/g' "$cfg"
			fi
			if [[ "$DEsel" == "Niri" ]]; then
				if grep -q "environment *{" "$cfg"; then sed -i '/environment *{/a\	LIBGL_ALWAYS_SOFTWARE "1"' "$cfg" ; else echo -e '\nenvironment {\n	LIBGL_ALWAYS_SOFTWARE "1"\n}' >> "$cfg" ; fi
				echo -e '\noutput "Virtual-1" {\n	mode "1440x900"\n}' >> "$cfg"
				sed -i 's/blur true/blur false/g' "$cfg"
				sed -i -e '/spawn-at-startup/{i\spawn-at-startup "vm-clipboard"' -e ':a;n;ba}' "$cfg"
			else
				sed -i '1i monitor=,1440x900@60,auto,1' "$cfg"
				sed -i -e '/exec-once/{i\exec-once = vm-clipboard' -e ':a;n;ba}' "$cfg"
			fi
		fi
		if [[ "${OSsel,,}" != "arch" && "$init_sys" != "systemd" ]]; then
			local pw_cmd='pgrep -u $USER -x pipewire >/dev/null || (pipewire & sleep 1; wireplumber & pipewire-pulse &)'
			if [[ "$DEsel" == "Niri" ]]; then sed -i -e "/spawn-at-startup/{i\\spawn-at-startup \"bash\" \"-c\" \"$pw_cmd\"" -e ':a;n;ba}' "$cfg"
			else sed -i -e "/exec-once/{i\\exec-once = bash -c '$pw_cmd'" -e ':a;n;ba}' "$cfg" ; fi
		fi
		if [[ "$DEsel" == "Niri" && "$cfg" != */config.kdl ]]; then mkdir -p /mnt/home/"$UNsel"/.config/niri ; sed -e 's/{{color4}}/#8be9fd/g' -e 's/{{[^}]*}}/#282a36/g' "$cfg" > /mnt/home/"$UNsel"/.config/niri/config.kdl ; fi
	fi
	rm -f /mnt/etc/sudoers.d/99-installer-temp
	if [[ "$VBTsel" -eq 1 ]]; then echo -e "WLR_NO_HARDWARE_CURSORS=1\nWLR_RENDERER_ALLOW_SOFTWARE=1\nLIBGL_ALWAYS_SOFTWARE=1\nKITTY_DISABLE_WAYLAND=1" >> /mnt/etc/environment ; fi
	CR chown -hR "$UNsel":users /home/"$UNsel"
}
BootloaderSetup () {
	local k_file ; local kname
	k_file=$(find /mnt/boot/ -maxdepth 1 -type f -name 'vmlinuz-*' -print -quit || true)
	if [[ -n "$k_file" ]]; then kname=$(basename "$k_file") ; else kname="vmlinuz-$KSel" ; fi
	local irfs initrd_flags rootflags="" nvdrm="" nvosi="" luks_flags=""
	if [[ "${OSsel,,}" == "void" ]]; then irfs="initramfs-${kname#vmlinuz-}.img" ; else irfs="initramfs-$KSel.img" ; fi
	if [[ "$FSsel" == "btrfs" ]]; then rootflags='rootflags=subvol=@' ; fi
	if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then nvdrm="nvidia-drm.modeset=1 nvidia-drm.fbdev=1" ; fi
	if [[ "${GPUMANAGERsel,,}" == "cardwire" ]]; then nvosi="lsm=lockdown,capability,landlock,bpf" ; fi
	if [[ -n "$UCODEsel" && -f "/mnt/boot/${UCODEsel}.img" ]]; then initrd_flags="initrd=\\${UCODEsel}.img initrd=\\${irfs}" ; else initrd_flags="initrd=\\${irfs}" ; fi
	if [[ "$LUKS_ENC" -eq 1 ]]; then luks_flags="cryptdevice=UUID=${CRYPT_ROOT_UUID}:cryptroot rd.luks.uuid=${CRYPT_ROOT_UUID} rd.luks.name=${CRYPT_ROOT_UUID}=cryptroot root=/dev/mapper/cryptroot" ; else luks_flags="root=${EFF_PID}=$ROOTID" ; fi
	local c_flags="rw $luks_flags resume=${EFF_PID}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi"
	local e_dev="$DRIVE" ; local e_num="${BOOT_PART##*[a-z]}"
	case "${BLsel,,}" in
		refind)			CR refind-install
						local e_fld='BOOT' ; if [[ "$UEFImode" -eq 1 ]]; then e_fld='refind' ; fi
						mkdir -p /mnt/boot/EFI/"$e_fld"/themes ; cp -r "${SCRIPT_DIR}/Bootloader/Refind/themes/"* /mnt/boot/EFI/"$e_fld"/themes/
						local r_res="max" ; if [[ "$VBTsel" -eq 1 ]]; then r_res="1024 768" ; fi
						echo -e "timeout 3\nshowtools shell, gdisk, apple_recovery, windows_recovery, mok_tool, bootorder, firmware, shutdown\nenable_mouse\nalso_scan_dirs +,@/boot\nscanfor internal,external,optical,manual,firmware\nextra_kernel_version_strings linux-hardened,linux-rt-lts,linux-zen,linux-lts,linux-rt,linux\ninclude themes/Blur-theme/theme.conf\nresolution $r_res" >> /mnt/boot/EFI/"$e_fld"/refind.conf
						echo -e "\"Boot Standard\"\t\"$c_flags $initrd_flags\"\n\"Boot Terminal\"\t\"$c_flags $initrd_flags 3\"" > /mnt/boot/refind_linux.conf
						;;
		grub)			if [[ "$UEFImode" -eq 0 ]]; then CR grub-install --target=i386-pc --recheck --debug "$DRIVE" ; else CR grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB ; fi
						local g_thm="Grub-Sekiro" ; mkdir -p /mnt/boot/grub/themes ; cp -r "${SCRIPT_DIR}/Bootloader/$g_thm" /mnt/boot/grub/themes/
						local g_res="1920x1080,1024x768,auto" ; if [[ "$VBTsel" -eq 1 ]]; then g_res="1024x768,auto" ; fi
						sed -i -e "/GRUB_DISABLE_OS_PROBER=/ s/#//g" -e "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/" -e "s/^#GRUB_GFXMODE=.*/GRUB_GFXMODE=$g_res/" -e '/GRUB_THEME=/c GRUB_THEME="/boot/grub/themes/'"$g_thm"'/theme.txt"' -e "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$luks_flags resume=${EFF_PID}=$SWAPID $nvosi\"|" /mnt/etc/default/grub
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 quiet splash $nvdrm\"/" /mnt/etc/default/grub ; fi
						CR grub-mkconfig -o /boot/grub/grub.cfg
						;;
		efistub)		CR efibootmgr -d "$e_dev" -p "${e_num:-1}" -c -L "${OSsel^} Linux ($FSsel)" -l "\\$kname" -u "$initrd_flags ro $c_flags" --verbose
						;;
		limine)			mkdir -p /mnt/boot/EFI/BOOT ; cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/
						local l_ucode="" ; if [[ -n "$UCODEsel" && -f "/mnt/boot/${UCODEsel}.img" ]]; then l_ucode="module_path: boot():/${UCODEsel}.img\n    " ; fi
						echo -e "timeout: 3\n\n/Linux (${OSsel^})\n    protocol: linux\n    kernel_path: boot():/${kname}\n    ${l_ucode}module_path: boot():/${irfs}\n    cmdline: ${c_flags}" > /mnt/boot/limine.conf
						CR efibootmgr -c -d "$e_dev" -p "${e_num:-1}" -L "Limine Bootloader" -l '\EFI\BOOT\BOOTX64.EFI'
						;;
		systemd-boot)	CR bootctl --path=/boot install
						echo -e "default arch.conf\ntimeout 3\nconsole-mode max\neditor no" > /mnt/boot/loader/loader.conf
						local s_ucode="" ; if [[ -n "$UCODEsel" && -f "/mnt/boot/${UCODEsel}.img" ]]; then s_ucode="initrd /${UCODEsel}.img\n" ; fi
						echo -e "title Arch Linux\nlinux /${kname}\n${s_ucode}initrd /${irfs}\noptions ${c_flags}" > /mnt/boot/loader/entries/arch.conf
						;;
		uki)			mkdir -p /mnt/boot/EFI/BOOT ; echo "$c_flags" > /mnt/boot/cmdline.txt
						local u_ucode="" ; if [[ -n "$UCODEsel" && -f "/mnt/boot/${UCODEsel}.img" ]]; then u_ucode="--microcode=/boot/${UCODEsel}.img" ; fi
						CR ukify build --linux=/boot/${kname} --initrd=/boot/${irfs} ${u_ucode} --cmdline=@/boot/cmdline.txt --output=/boot/EFI/BOOT/BOOTX64.EFI
						rm -f /mnt/boot/cmdline.txt
						CR efibootmgr -c -d "$e_dev" -p "${e_num:-1}" -L "Arch Linux (UKI)" -l '\EFI\BOOT\BOOTX64.EFI'
						;;
	esac
}
InstallationSetup () {
	SYS_LSPCI=$(lspci || true) ; SYS_CPU=$(cat /proc/cpuinfo || true) ; VBTsel=0 ; VM_TYPE="none" ; HAS_NVIDIA=0 ; HAS_AMD=0 ; CPU_TYPE="Unknown"
	if echo "$SYS_LSPCI" | grep -qEi "(VirtualBox)"; then VM_TYPE="vbox" ; VBTsel=1
	elif echo "$SYS_LSPCI" | grep -qEi "(VMware|Virtio|QXL)"; then VM_TYPE="qemu" ; VBTsel=1 ; fi
	echo "Synchronizing system clock..." ; local t_ok=0
	if command -v timedatectl &>/dev/null && timedatectl status &>/dev/null && timedatectl set-ntp true &>/dev/null; then t_ok=1
	elif command -v chronyc &>/dev/null && chronyc makestep &>/dev/null; then t_ok=1
	elif command -v chronyd &>/dev/null && chronyd -q "pool pool.ntp.org iburst" &>/dev/null; then t_ok=1
	elif command -v ntpd &>/dev/null && ntpd -qg &>/dev/null; then t_ok=1
	elif command -v ntpdate &>/dev/null && ntpdate pool.ntp.org &>/dev/null; then t_ok=1 ; fi
	if [[ "$t_ok" -eq 0 ]]; then echo "[!] CRITICAL: System clock synchronization failed." >&2 ; return 1 ; fi
	sleep 2
	echo 'List of all errors occurred during the installation process:' > Errors
	CheckandSetup=( Check_required_files AutoOSsel UEFIsel KernelSel IRFsel IRFSModeSel BootloaderSel Pacman_Locked )
	for c in "${CheckandSetup[@]}"; do "$c" ; done
	if [[ "$VBTsel" == "1" ]]; then
		LANGsel='en_GB.UTF-8' ; LOCsel='it_IT.UTF-8' ; HNsel=tarch1 ; UNsel=tarch1 ; TZsel='Europe/Rome' ; PIDsel=UUID ; FSsel=btrfs
		if [[ "${OSsel,,}" == "artix" ]]; then ARCHrepo=1 ; INITsel="OpenRC" ; fi
		if [[ "${OSsel,,}" == "void" ]]; then LIBsel="GLIBC" ; VImethod="XBPS" ; INITsel="Runit" ; fi
		CPUsel ; GPUsel ; DriveSelection ; LUKSSel ; DesktopEnvSel ; DisplayManagerSel
	else
		if [[ "${OSsel,,}" == "artix" ]]; then ArchRepoSel ; InitSystemSel ; fi
		if [[ "${OSsel,,}" == "void" ]]; then VoidInstMethod ; LibrarySel ; INITsel="Runit" ; fi
		CPUsel ; GPUsel ; DriveSelection
		local Personalization=( LocalizationSel LanguageSel TimezoneSel HostnameSel UsernameSel PartIDSel FilesystemSel LUKSSel DesktopEnvSel DisplayManagerSel )
		for s in "${Personalization[@]}"; do "$s" ; done
	fi
	while true; do
		local sum="\n=== CONFIGURATION SUMMARY ===\nOS: $OSsel | Init: $INITsel | Kernel: $KSel | Initramfs: $IRFSetup ($IRFSMode) | Bootloader: $BLsel\nOS Drive: $DRIVE | Sec. Drive: ${ADDITIONAL_DRIVE:-None}\nUser: $UNsel | Hostname: $HNsel | Locale: $LOCsel | Language: $LANGsel | Timezone: $TZsel\nFilesystem: $FSsel | Partition ID: $PIDsel | LUKS: $LUKS_ENC\nDesktop: $DEsel | Shell: ${SHELLsel:-None} | DM: $DMsel\n"
		if [[ "$CPU_TYPE" != "Unknown" ]]; then sum+="CPU: $CPU_TYPE (Microcode enabled)\n" ; fi
		if [[ "$HAS_NVIDIA" -eq 1 ]]; then sum+="NVIDIA Driver: $NVsel | Manager: $GPUMANAGERsel\n" ; fi
		if [[ "$HAS_AMD" -eq 1 ]]; then sum+="AMD GPU: Detected (Mesa/RADV)\n" ; fi
		if [[ "$VBTsel" -eq 1 ]]; then sum+="Virtual Machine Mode: ON ($VM_TYPE)\n" ; fi
		echo -e "${sum}============================="
		YesNoSel "Is this configuration correct to proceed with partitioning?"
		if [[ "$CC" -eq 1 ]]; then echo "Proceeding with installation..." ; break ; fi
		local edit_options=( "Drive Selection" "Kernel" "Initramfs" "Initramfs Mode" "Bootloader" "Hostname" "Username" "Locale" "Language" "Timezone" "Filesystem" "Partition ID" "LUKS" "Desktop" )
		if [[ "$DEsel" =~ ^(Hyprland|Niri)$ ]]; then edit_options+=( "Shell" ) ; fi
		edit_options+=( "Display Manager" )
		if [[ "${OSsel,,}" == "artix" ]]; then edit_options+=( "Init System" "Arch Repos" ) ; fi
		if [[ "${OSsel,,}" == "void" ]]; then edit_options+=( "Library" "Install Method" ) ; fi
		if [[ "$HAS_NVIDIA" -eq 1 ]]; then edit_options+=( "NVIDIA Driver" ) ; fi
		edit_options+=( "Abort Installation" )
		MenuSel "EDIT_CHOICE" "What would you like to change?" "${edit_options[@]}"
		case "$EDIT_CHOICE" in
			"Drive Selection") DriveSelection ;;
			"Kernel") KernelSel ;;
			"Initramfs") IRFsel ;;
			"Initramfs Mode") IRFSModeSel ;;
			"Bootloader") BootloaderSel ;;
			"Hostname") HostnameSel ;;
			"Username") UsernameSel ;;
			"Locale") LocalizationSel ;;
			"Language") LanguageSel ;;
			"Timezone") TimezoneSel ;;
			"Filesystem") FilesystemSel ;;
			"Partition ID") PartIDSel ;;
			"LUKS") LUKSSel ;;
			"Desktop") DesktopEnvSel ;;
			"Shell") ShellSel ;;
			"Display Manager") DisplayManagerSel ;;
			"Init System") InitSystemSel ;;
			"Arch Repos") ArchRepoSel ;;
			"Library") LibrarySel ; if [[ "$HAS_NVIDIA" -eq 1 && "$LIBsel" == "MUSL" ]]; then NVsel="MESA" ; GPUMANAGERsel="None" ; fi ;;
			"Install Method") VoidInstMethod ;;
			"NVIDIA Driver") GPUsel ;;
			"Abort Installation") exit 1 ;;
		esac
	done
	if [[ "${OSsel,,}" != "void" ]]; then
		PKGmanager="pacman" ; PKGinst=" -S" ; PKGupd="y" ; PKGupg="u" ; PKGchk=" -Q" ; PKGrmv=" -R" ; PKGdpn="s" ; PKGfrc="dd" ; PKGskp=( --needed --noconfirm ) ; PKGrsk=( --noconfirm ) ; keylayout='KEYMAP=it' ; chroot="${OSsel,,}-chroot"
		sed -i -e '/\(Color\|ParallelDownloads\)/ s/#//' -e '/ParallelDownloads/a ILoveCandy' /etc/pacman.conf
		if [[ "${OSsel,,}" == "arch" ]]; then keypath='etc/vconsole.conf' ; PKGstrap="pacstrap /mnt" ; FSTABgen=genfstab ; init_sys="systemd" ; sed -i '/\[multilib]/,/mirrorlist/ s/#//' /etc/pacman.conf ; $PKGmanager$PKGinst$PKGupd
		elif [[ "${OSsel,,}" == "artix" ]]; then keypath='etc/conf.d/keymaps' ; PKGstrap="basestrap /mnt" ; FSTABgen=fstabgen ; init_sys="${INITsel,,}" ; sed -i '/\[lib32]/,/mirrorlist/ s/#//' /etc/pacman.conf ; if [[ "$ARCHrepo" == "1" ]]; then ArchRepoSetup /etc/pacman.conf ; fi ; $PKGmanager$PKGinst$PKGupd ; fi
	else
		PKGmanager="xbps" ; PKGinst="-install" ; PKGupd=" -S" ; PKGupg="u" ; PKGchk="-query" ; PKGrmv="-remove" ; PKGdpn=" -R" ; PKGfrc=" -F" ; PKGskp=( -y -y ) ; PKGrsk=( -y ) ; keylayout='KEYMAP=it' ; keypath='etc/rc.conf' ; init_sys="runit"
		if [[ "$LIBsel" == "GLIBC" ]]; then VoidArch="x86_64" ; else VoidArch="x86_64-musl" ; fi
		VoidRepo="https://repo-default.voidlinux.org/current" ; if [[ "$LIBsel" == "MUSL" ]]; then VoidRepo+="/musl" ; fi
		PKGstrap="$PKGmanager$PKGinst$PKGupd -R $VoidRepo -r /mnt ${PKGskp[*]}" ; chroot="chroot"
	fi
	PKGcheck
	local ArchTixSteps=( 'DiskPartition' 'FileSystemFormat' 'BaseSystemInstall' 'FStabGen' 'SetupEnvironment' 'PackageInstall' 'KernelSetup' 'ServiceSetup' 'UserSetup' 'BootloaderSetup' )
	for a in "${ArchTixSteps[@]}"; do "$a" ; done
	echo -e "\n=== INSTALLATION COMPLETED ==="
	if [[ "$(wc -l < Errors)" -gt 1 ]]; then echo -e "\n[!] Some errors logged during installation:" ; cat Errors ; cp Errors /mnt/var/log/installer_errors.log ; else echo "[+] Clean installation: zero errors detected." ; fi
	YesNoSel "Reboot system"
	if [[ "$CC" -eq 1 ]]; then umount -R -l /mnt || true ; reboot ; else echo "OK" ; exit 0 ; fi
}
InstallationSetup

KernelSetup () {
	if [[ "$CPU_TYPE" == "Intel" ]]; then modules+=(vmd) ; fi
	if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then
		modules+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
		mkdir -p /mnt/etc/modprobe.d /mnt/etc/udev/rules.d
		printf 'blacklist nouveau\noptions nouveau modeset=0\noptions nvidia-drm modeset=1 fbdev=1\noptions nvidia NVreg_DynamicPowerManagement=0x02 NVreg_UsePageAttributeTable=1\n' > /mnt/etc/modprobe.d/nvidia.conf
		printf 'ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", TEST=="power/control", ATTR{power/control}="auto"\nACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x040300", TEST=="power/control", ATTR{power/control}="auto"\n' > /mnt/etc/udev/rules.d/80-nvidia-pm.rules
	fi
	local kver ; kver="$(basename "$(find /mnt/usr/lib/modules/ -maxdepth 1 -mindepth 1 -type d ! -name 'extramodules*' -print -quit)")"
	case "$IRF" in
		dracut)     mkdir -p /mnt/etc/dracut.conf.d
					local d_opts=""
					if [[ "$CPU_TYPE" == "Intel" ]]; then d_opts+='add_drivers+=" vmd "\n' ; fi
					if [[ "${CRYPT:-0}" -eq 1 ]]; then d_opts+='add_dracutmodules+=" crypt "\n' ; fi
					if [[ "${LVM:-0}" -eq 1 ]]; then d_opts+='add_dracutmodules+=" lvm "\n' ; fi
					if [[ "${HIB:-0}" -eq 1 && -n "$RESUME_DEV" ]]; then d_opts+='add_dracutmodules+=" resume "\n' ; fi
					if [[ "$FS" == "btrfs" ]]; then d_opts+='add_dracutmodules+=" btrfs "\n' ; fi
					if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then d_opts+='force_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "\n' ; fi
					local d_flag="--hostonly" ; if [[ "$IRFS" == "Universal" ]]; then d_flag="--no-hostonly" ; fi
					if [[ "${OS,,}" == "void" ]]; then
						if [[ "$IRFS" == "Universal" ]]; then d_opts+='hostonly="no"\n' ; else d_opts+='hostonly="yes"\n' ; fi
						printf '%b' "$d_opts" > /mnt/etc/dracut.conf.d/99-installer.conf
						CR xbps-reconfigure -f "$KERNEL"
					else
						printf '%b' "$d_opts" > /mnt/etc/dracut.conf.d/99-installer.conf
						CR dracut "$d_flag" --kver "$kver" --force /boot/initramfs-"$KERNEL".img
					fi
					;;
		booster)    local b_opts="mount_timeout: 3m\nvconsole: true"
					b_opts+="\nmodules: ahci,ata_piix,sd_mod,nvme,vmd" ; local b_flag=""
					if [[ "$IRFS" == "Universal" ]]; then b_opts="universal: true\n$b_opts" ; b_flag="--universal" ; fi
					if [[ "$FS" == "btrfs" ]]; then b_opts+=",btrfs" ; fi
					if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then b_opts+=",nvidia,nvidia_modeset,nvidia_uvm,nvidia_drm" ; fi
					if [[ "${LVM:-0}" -eq 1 ]]; then b_opts+="\nenable_lvm: true" ; fi
					if [[ "${CRYPT:-0}" -eq 1 && -n "$CRYPT_ROOT_UUID" ]]; then
						install -m 600 /dev/null /mnt/etc/booster-crypttab
						printf '%s UUID=%s none x-initrd.attach\n' "$CRYPT_ROOT_NAME" "$CRYPT_ROOT_UUID" > /mnt/etc/booster-crypttab
						b_opts+="\ncrypttab_path: /etc/booster-crypttab"
					fi
					printf '%b\n' "$b_opts" > /mnt/etc/booster.yaml
					if [[ "${OS,,}" != "void" ]]; then mkdir -p /mnt/etc/pacman.d/hooks ; printf "[Trigger]\nOperation = Install\nOperation = Upgrade\nType = Package\nTarget = linux\nTarget = linux-*\n\n[Action]\nDescription = Forcing Booster initramfs update...\nWhen = PostTransaction\nDepends = booster\nNeedsTargets\nExec = /bin/bash -c 'while read -r pkg; do for d in /usr/lib/modules/*; do if [[ -f \"\$d/pkgbase\" && \"\$(<\"\$d/pkgbase\")\" == \"\$pkg\" ]]; then kver=\"\${d##*/}\"; /usr/bin/booster build --force $b_flag --kernel-version=\"\$kver\" \"/boot/initramfs-\${pkg}.img\"; break; fi; done; done'\n" > /mnt/etc/pacman.d/hooks/95-booster-force.hook ; fi
					CR /bin/bash -c "booster build --force $b_flag --kernel-version=$kver /boot/initramfs-${KERNEL}.img"
					;;
		*)          local HOOKS=(base udev autodetect keyboard keymap modconf block)
					if [[ "$IRFS" == "Universal" ]]; then HOOKS=( "${HOOKS[@]/autodetect/}" ) ; fi
					if [[ "${CRYPT:-0}" -eq 1 ]]; then HOOKS+=(encrypt) ; fi
					if [[ "${LVM:-0}" -eq 1 ]]; then HOOKS+=(lvm2) ; fi
					if [[ "${HIB:-0}" -eq 1 && -n "$RESUME_DEV" ]]; then HOOKS+=(resume) ; fi
					HOOKS+=(filesystems fsck) ; if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then HOOKS+=(kms) ; fi
					sed -i -e "/^MODULES=/ s/()/(${modules[*]})/" -e "/^BINARIES=/ s/()/($binaries)/" -e "s/^HOOKS=.*/HOOKS=(${HOOKS[*]})/" /mnt/etc/mkinitcpio.conf
					CR mkinitcpio -p "$KERNEL"
					;;
	esac
}
ServiceSetup () {
	local dm_l="${DM,,}" os_l="${OS,,}"

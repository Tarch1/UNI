		if [[ "$os_l" == "arch" && "$DE" =~ ^(KDE|GNOME|COSMIC)$ ]]; then Services+=( power-profiles-daemon ) ; else Services+=( tlp ) ; fi
		if [[ "$CPU_TYPE" == "Intel" ]]; then Services+=( thermald ) ; fi
	fi

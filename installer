BootloaderSetup () {
	local osi_version="${AcpiOS:-Windows 2020}" ; local kname
	if ! kname=$(basename "$(find /mnt/boot/ -type f -name 'vmlinuz-*' | head -n 1)"); then kname="vmlinuz-$KSel" ; fi
	local irfs initrd_flags rootflags="" nvdrm="" nvosi="" luks_flags=""
	if [[ "${OSsel,,}" == "void" ]]; then irfs="initramfs-${kname#vmlinuz-}.img" ; else irfs="initramfs-$KSel.img" ; fi
	if [[ "$FSsel" == "btrfs" ]]; then rootflags='rootflags=subvol=@' ; fi
	if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then nvdrm="nvidia-drm.modeset=1 nvidia-drm.fbdev=1" ; nvosi="acpi_osi=\"$osi_version\"" ; fi
	if [[ "${GPUMANAGERsel,,}" == "cardwire" ]]; then nvosi="$nvosi lsm=lockdown,capability,landlock,bpf" ; fi
	if [[ -n "$UCODEsel" && -f "/mnt/boot/${UCODEsel}.img" ]]; then initrd_flags="initrd=\\${UCODEsel}.img initrd=\\${irfs}" ; else initrd_flags="initrd=\\${irfs}" ; fi
	if [[ "$LUKS_ENC" -eq 1 ]]; then luks_flags="cryptdevice=UUID=${CRYPT_ROOT_UUID}:cryptroot rd.luks.uuid=${CRYPT_ROOT_UUID} rd.luks.name=${CRYPT_ROOT_UUID}=cryptroot root=/dev/mapper/cryptroot" ; else luks_flags="root=${PIDsel}=$ROOTID" ; fi
	local c_flags="rw $luks_flags resume=${PIDsel}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi"
	local e_dev="$DRIVE" ; local e_num="${BOOT_PART##*[a-z]}"
	case "${BLsel,,}" in
		refind)			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${refind[@]}"
						"$chroot" /mnt refind-install
						local e_fld='BOOT' ; if [[ "$UEFImode" -eq 1 ]]; then e_fld='refind' ; fi
						mkdir -p /mnt/boot/EFI/"$e_fld"/themes ; cp -r "${SCRIPT_DIR}/Bootloader/Refind/themes/"* /mnt/boot/EFI/"$e_fld"/themes/
						local r_res="max" ; if [[ "$VBTsel" -eq 1 ]]; then r_res="1024 768" ; fi
						echo -e "timeout 3\nshowtools shell, gdisk, apple_recovery, windows_recovery, mok_tool, bootorder, firmware, shutdown\nenable_mouse\nalso_scan_dirs +,@/boot\nscanfor internal,external,optical,manual,firmware\nextra_kernel_version_strings linux-hardened,linux-rt-lts,linux-zen,linux-lts,linux-rt,linux\ninclude themes/Blur-theme/theme.conf\nresolution $r_res" >> /mnt/boot/EFI/"$e_fld"/refind.conf
						echo -e "\"Boot Standard\"\t\"$c_flags $initrd_flags\"\n\"Boot Terminal\"\t\"$c_flags $initrd_flags 3\"" > /mnt/boot/refind_linux.conf
						;;
		grub)			if [[ "$FSsel" == "btrfs" ]]; then grub+=("${grubbtrfs[@]}") ; fi
						"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${grub[@]}"
						if [[ "$UEFImode" -eq 0 ]]; then "$chroot" /mnt grub-install --target=i386-pc --recheck --debug "$DRIVE" ; else "$chroot" /mnt grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB ; fi
						local g_thm="Grub-Sekiro" ; mkdir -p /mnt/boot/grub/themes /mnt/usr/share/grub/themes/ ; cp -r "${SCRIPT_DIR}/Bootloader/$g_thm" /mnt/boot/grub/themes/ ; cp -r "${SCRIPT_DIR}/Bootloader/$g_thm" /mnt/usr/share/grub/themes/
						local g_res="1920x1080,1024x768,auto" ; if [[ "$VBTsel" -eq 1 ]]; then g_res="1024x768,auto" ; fi
						sed -i -e "/GRUB_DISABLE_OS_PROBER=/ s/#//g" -e "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/" -e "s/^#GRUB_GFXMODE=.*/GRUB_GFXMODE=$g_res/" -e '/GRUB_THEME=/c GRUB_THEME="/boot/grub/themes/'"$g_thm"'/theme.txt"' -e "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$nvosi $luks_flags\"|" /mnt/etc/default/grub
						if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 quiet splash $nvdrm\"/" /mnt/etc/default/grub ; fi
						"$chroot" /mnt grub-mkconfig -o /boot/grub/grub.cfg
						;;
		efistub)		"$chroot" /mnt efibootmgr -d "$e_dev" -p "${e_num:-1}" -c -L "${OSsel^} Linux ($FSsel)" -l "\\$kname" -u "$initrd_flags ro $c_flags" --verbose
						;;
		limine)			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${limine[@]}"
						mkdir -p /mnt/boot/EFI/BOOT ; cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/
						local l_ucode="" ; if [[ -n "$UCODEsel" ]]; then l_ucode="module_path: boot():/${UCODEsel}.img\n    " ; fi
						echo -e "timeout: 3\n\n/Linux (${OSsel^})\n    protocol: linux\n    kernel_path: boot():/${kname}\n    ${l_ucode}module_path: boot():/${irfs}\n    cmdline: ${c_flags}" > /mnt/boot/limine.conf
						"$chroot" /mnt efibootmgr -c -d "$e_dev" -p "${e_num:-1}" -L "Limine Bootloader" -l '\EFI\BOOT\BOOTX64.EFI'
						;;
		systemd-boot)	"$chroot" /mnt bootctl --path=/boot install
						echo -e "default arch.conf\ntimeout 3\nconsole-mode max\neditor no" > /mnt/boot/loader/loader.conf
						local s_ucode="" ; if [[ -n "$UCODEsel" ]]; then s_ucode="initrd /${UCODEsel}.img\n" ; fi
						echo -e "title Arch Linux\nlinux /${kname}\n${s_ucode}initrd /${irfs}\noptions ${c_flags}" > /mnt/boot/loader/entries/arch.conf
						;;
		uki)			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${uki[@]}"
						mkdir -p /mnt/boot/EFI/BOOT ; echo "$c_flags" > /mnt/boot/cmdline.txt
						local u_ucode="" ; if [[ -n "$UCODEsel" ]]; then u_ucode="--microcode=/boot/${UCODEsel}.img" ; fi
						"$chroot" /mnt ukify build --linux=/boot/${kname} --initrd=/boot/${irfs} ${u_ucode} --cmdline=@/boot/cmdline.txt --output=/boot/EFI/BOOT/BOOTX64.EFI
						rm -f /mnt/boot/cmdline.txt
						"$chroot" /mnt efibootmgr -c -d "$e_dev" -p "${e_num:-1}" -L "Arch Linux (UKI)" -l '\EFI\BOOT\BOOTX64.EFI'
						;;
	esac
}
InstallationSetup () {
	VBTsel=0
	if [[ "$(lspci | grep -Ei 'VGA|3D')" =~ (VMware|VirtualBox|Virtio|QXL) ]]; then VBTsel=1 ; fi
	if command -v timedatectl &>/dev/null; then timedatectl set-ntp true &>/dev/null ; elif command -v chronyc &>/dev/null; then chronyc makestep &>/dev/null ; elif command -v chronyd &>/dev/null; then chronyd -q "pool pool.ntp.org iburst" &>/dev/null ; elif command -v ntpdate &>/dev/null; then ntpdate pool.ntp.org &>/dev/null ; fi
	echo 'List of all errors occurred during the installation process:' > Errors
	CheckandSetup=( Check_required_files AutoOSsel UEFIsel KernelSel IRFsel IRFSModeSel BootloaderSel Pacman_Locked )
	for c in "${CheckandSetup[@]}"; do "$c" ; done
	CPUsel ; GPUsel ; DriveSelection
	if [[ "$VBTsel" == "1" ]]; then
		LANGsel='en_GB.UTF-8' ; LOCsel='it_IT.UTF-8' ; HNsel=tarch1 ; UNsel=tarch1 ; TZsel='Europe/Rome' ; PIDsel=UUID ; FSsel=btrfs ; ADD_SETUP=0 ; ADD_FORMAT=0 ; ADD_FS="" ; ADD_LABEL="" ; ADDITIONAL_DRIVE="" ; LUKSSel ; DesktopEnvSel ; DisplayManagerSel
		if [[ "${OSsel,,}" == "artix" ]]; then ARCHrepo=1 ; INITsel="OpenRC" ; fi
		if [[ "${OSsel,,}" == "void" ]]; then LIBsel="GLIBC" ; VImethod="XBPS" ; INITsel="Runit" ; fi
	else
		if [[ "${OSsel,,}" == "artix" ]]; then ArchRepoSel ; InitSystemSel ; fi
		if [[ "${OSsel,,}" == "void" ]]; then VoidInstMethod ; LibrarySel ; INITsel="Runit" ; fi
		local Personalization=( LocalizationSel LanguageSel TimezoneSel HostnameSel UsernameSel PartIDSel FilesystemSel LUKSSel DesktopEnvSel DisplayManagerSel )
		for s in "${Personalization[@]}"; do "$s" ; done
	fi
	while true; do
		local sum="\n=== CONFIGURATION SUMMARY ===\nOS: $OSsel | Init: $INITsel | Kernel: $KSel | Initramfs: $IRFSetup ($IRFSMode) | Bootloader: $BLsel\nOS Drive: $DRIVE | Sec. Drive: ${ADDITIONAL_DRIVE:-None}\nUser: $UNsel | Hostname: $HNsel | Locale: $LOCsel | Language: $LANGsel | Timezone: $TZsel\nFilesystem: $FSsel | Partition ID: $PIDsel | LUKS: $LUKS_ENC\nDesktop: $DEsel | DM: $DMsel\n"
		if [[ -n "$UCODEsel" ]]; then sum+="Microcode: $UCODEsel\n" ; fi
		if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then sum+="NVIDIA Driver: $NVsel | Manager: $GPUMANAGERsel\n" ; fi
		if [[ ${#amddrivers[@]} -gt 0 ]]; then sum+="AMD Drivers included\n" ; fi
		if [[ "$VBTsel" -eq 1 ]]; then sum+="Virtual Machine Mode: ON\n" ; fi
		echo -e "${sum}============================="
		YesNoSel "Is this configuration correct to proceed with partitioning?"
		if [[ "$CC" -eq 1 ]]; then echo "Proceeding with installation..." ; break ; fi
		local edit_options=( "Drive Selection" "Kernel" "Initramfs" "Initramfs Mode" "Bootloader" "Hostname" "Username" "Locale" "Language" "Timezone" "Filesystem" "Partition ID" "LUKS" "Desktop" "Display Manager" )
		if [[ "${OSsel,,}" == "artix" ]]; then edit_options+=( "Init System" "Arch Repos" ) ; fi
		if [[ "${OSsel,,}" == "void" ]]; then edit_options+=( "Library" "Install Method" ) ; fi
		if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then edit_options+=( "NVIDIA Driver" "GPU Manager" ) ; fi
		edit_options+=( "Abort Installation" )
		MenuSel "EDIT_CHOICE" "What would you like to change?" "${edit_options[@]}"
		case "$EDIT_CHOICE" in
			"Drive Selection") DriveSelection ;;
			"Kernel") KernelSel ;;
			"Initramfs") IRFsel ;;
			"Initramfs Mode") IRFSModeSel ;;
			"Bootloader") BootloaderSel ;;
			"Hostname") HostnameSel ;;
			"Username") UsernameSel ;;
			"Locale") LocalizationSel ;;
			"Language") LanguageSel ;;
			"Timezone") TimezoneSel ;;
			"Filesystem") FilesystemSel ;;
			"Partition ID") PartIDSel ;;
			"LUKS") LUKSSel ;;
			"Desktop") DesktopEnvSel ;;
			"Display Manager") DisplayManagerSel ;;
			"Init System") InitSystemSel ;;
			"Arch Repos") ArchRepoSel ;;
			"Library") LibrarySel ;;
			"Install Method") VoidInstMethod ;;
			"NVIDIA Driver") MenuSel "NVsel" "Choose driver" "OPEN" "NOUVEAU" "PROPRIETARY" "MESA" ;;
			"GPU Manager") MenuSel "GPUMANAGERsel" "Select Optimus Manager" "Native" "Envycontrol" "Cardwire" ;;
			"Abort Installation") exit 1 ;;
		esac
	done
	local s_step
	if [[ "${OSsel,,}" == "void" ]]; then s_step='VoidSystemInstall' ; else s_step='ArchTixSystemInstall' ; fi
	if [[ "${OSsel,,}" != "void" ]]; then
		PKGmanager="pacman" ; PKGinst=" -S" ; PKGupd="y" ; PKGchk=" -Q" ; PKGrmv=" -R" ; PKGdpn="s" ; PKGfrc="dd" ; PKGskp=( --needed --noconfirm ) ; PKGrsk=( --noconfirm ) ; keylayout='KEYMAP=it' ; chroot="${OSsel,,}-chroot"
		if [[ "${OSsel,,}" == "arch" ]]; then
			keypath='etc/vconsole.conf' ; PKGstrap=pacstrap ; FSTABgen=genfstab ; init_sys="systemd"
			sed -i -e 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' -e '/\[multilib]/,/mirrorlist/ s/#//' /etc/pacman.conf
			$PKGmanager$PKGinst$PKGupd"lq" core extra multilib | sort > pacman_db || true
		elif [[ "${OSsel,,}" == "artix" ]]; then
			keypath='etc/conf.d/keymaps' ; PKGstrap=basestrap ; FSTABgen=fstabgen ; init_sys="${INITsel,,}"
			sed -i -e 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' -e '/\[lib32]/,/mirrorlist/ s/#//' /etc/pacman.conf
			if [[ "$ARCHrepo" == "1" ]]; then ArchRepoSetup /etc/pacman.conf ; fi
			local artix_pkgs="system world galaxy lib32"
			if [[ "$ARCHrepo" == "1" ]]; then artix_pkgs+=" universe extra multilib" ; fi
			$PKGmanager$PKGinst$PKGupd"lq" $artix_pkgs | sort > pacman_db || true
		fi
	else
		PKGmanager="xbps" ; PKGinst="-install" ; PKGupd=" -S" ; PKGchk="-query" ; PKGrmv="-remove" ; PKGdpn=" -R" ; PKGfrc=" -F" ; PKGskp=( -y -y ) ; PKGrsk=( -y ) ; keylayout='KEYMAP=it' ; keypath='etc/rc.conf'
		if [[ "$LIBsel" == "GLIBC" ]]; then VoidArch="x86_64" ; else VoidArch="x86_64-musl" ; fi
		VoidRepo="https://voidlinux.org" ; if [[ "$LIBsel" == "MUSL" ]]; then VoidRepo+="/musl" ; fi
		PKGstrap="$PKGmanager$PKGinst$PKGupd -R $VoidRepo -r /mnt ${PKGskp[*]}" ; chroot="chroot"
	fi
	echo 'Running check for missing packages' ; PKGcheck
	local ArchTixSteps=( 'DiskPartition' 'FileSystemFormat' "$s_step" 'CrypttabGen' 'FStabGen' 'SetupEnvironment' 'PackageConfig' 'PackageInstall' 'KernelSetup' 'ServiceSetup' 'UserSetup' )
	if [[ "$VBTsel" -eq 0 ]]; then ArchTixSteps+=( 'AudioSetup' ) ; fi
	ArchTixSteps+=( 'BootloaderSetup' )
	for a in "${ArchTixSteps[@]}"; do "$a" ; done
	echo -e "\n=== INSTALLATION COMPLETED ==="
	"$chroot" /mnt chown -hR "$UNsel":users /home/"$UNsel"
	if [[ "$(wc -l < Errors)" -gt 1 ]]; then echo -e "\n[!] Some errors logged during installation:" ; cat Errors ; cp Errors /mnt/var/log/installer_errors.log ; else echo "[+] Clean installation: zero errors detected." ; fi
	YesNoSel "Reboot system"
	if [[ "$CC" -eq 1 ]]; then umount -R -l /mnt || true ; reboot ; else echo "OK" ; exit 0 ; fi
}
InstallationSetup

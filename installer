		elif [[ "$os_l" =~ ^(artix|void)$ ]]; then
			local sv_dir="/mnt/etc/sv/cardwire" ; if [[ "$os_l" == "artix" ]]; then sv_dir="/mnt/etc/runit/sv/cardwire" ; fi
			mkdir -p "$sv_dir" ; printf '#!/bin/sh\nexec /usr/bin/cardwire\n' > "$sv_dir/run" ; chmod +x "$sv_dir/run"
		fi
	fi
	for s in "${Services[@]}"; do
		case "$os_l:$init_sys" in
			void:*)      CR ln -sf /etc/sv/"$s" /etc/runit/runsvdir/default/ ;;
			arch:*)      CR systemctl enable "$s" ;;
			artix:runit) CR ln -sf /etc/runit/sv/"$s" /etc/runit/runsvdir/default/ ;;
			artix:s6)    CR touch /etc/s6/adminsv/default/contents.d/"$s" ;;
			artix:dinit) CR ln -sf ../"$s" /etc/dinit.d/boot.d/ ;;
			artix:*)     if [[ "$s" =~ ^(dmcrypt|lvm)$ ]]; then CR rc-update add "$s" boot ; else CR rc-update add "$s" default ; fi ;;
		esac
	done
	mkdir -p /mnt/etc/NetworkManager/conf.d /mnt/etc/pipewire/pipewire.conf.d /mnt/etc/wireplumber/wireplumber.conf.d /mnt/etc/udev/rules.d /mnt/etc/sudoers.d
	printf '[device]\nwifi.backend=iwd\n' > /mnt/etc/NetworkManager/conf.d/wifi_backend.conf
	printf 'monitor.bluez.properties = { bluez5.enable-sbc-xq = true, bluez5.enable-msbc = true, bluez5.enable-hw-volume = true, bluez5.codecs = [ sbc_xq aac aptx aptx_hd ldac ] }\n' > /mnt/etc/wireplumber/wireplumber.conf.d/10-bluetooth-policy.conf
	printf 'context.properties = { default.clock.rate = 48000, default.clock.quantum = 1024, default.clock.min-quantum = 32, default.clock.max-quantum = 2048 }\n' > /mnt/etc/pipewire/pipewire.conf.d/99-input-denoise.conf
	if [[ -f /mnt/etc/bluetooth/main.conf ]]; then sed -i 's/#AutoEnable=false/AutoEnable=true/g' /mnt/etc/bluetooth/main.conf ; fi
	if [[ "$init_sys" == "systemd" ]]; then CR systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service ; fi
	if [[ -f "${SCRIPT_DIR}/Conf_files/51-android.rules" ]]; then cp "${SCRIPT_DIR}/Conf_files/51-android.rules" /mnt/etc/udev/rules.d/ ; fi

	if [[ "${ZRAM:-0}" -eq 1 && "${ZRAM_DIM:-0}" -gt 0 ]]; then
		if [[ "$init_sys" == "systemd" ]]; then
			mkdir -p /mnt/etc/systemd
			printf '[zram0]\nzram-size = %s\ncompression-algorithm = zstd\nswap-priority = 100\n' "$(( ZRAM_DIM * 1024 ))" > /mnt/etc/systemd/zram-generator.conf
		else
			mkdir -p /mnt/etc/modules-load.d /mnt/etc/modprobe.d /mnt/etc/udev/rules.d
			printf 'zram\n' > /mnt/etc/modules-load.d/zram.conf
			printf 'options zram num_devices=1\n' > /mnt/etc/modprobe.d/zram.conf
			printf 'ACTION=="add", KERNEL=="zram0", ATTR{initstate}=="0", ATTR{comp_algorithm}="zstd", ATTR{disksize}="%sG", RUN+="/bin/sh -c '\''PATH=/usr/sbin:/usr/bin:/sbin:/bin; mkswap -U clear /dev/zram0 && swapon -p 100 /dev/zram0'\''"\n' "$ZRAM_DIM" > /mnt/etc/udev/rules.d/99-zram.rules
			if [[ "$os_l:$init_sys" == "artix:openrc" ]]; then
				mkdir -p /mnt/etc/conf.d
				if [[ -f /mnt/etc/conf.d/modules ]] && grep -q '^modules=' /mnt/etc/conf.d/modules; then
					sed -i 's/^modules="\(.*\)"/modules="\1 zram"/' /mnt/etc/conf.d/modules
				else
					printf 'modules="zram"\n' >> /mnt/etc/conf.d/modules
				fi
			fi
		fi
		if [[ "$SWAP" == "zram" ]]; then
			mkdir -p /mnt/etc/sysctl.d
			printf 'vm.swappiness = 180\nvm.page-cluster = 0\n' > /mnt/etc/sysctl.d/99-zram.conf
		fi
	fi

	if [[ "$DE" =~ ^(Niri|Hyprland)$ ]]; then
		local wm_exec="Hyprland" dbus_wrap=""
		if [[ "$DE" == "Niri" ]]; then if [[ "$init_sys" =~ ^(systemd|dinit)$ ]]; then wm_exec="niri-session" ; else wm_exec="niri --session" ; fi ; fi
		if [[ ! "$init_sys" =~ ^(systemd|dinit)$ ]]; then dbus_wrap="dbus-run-session " ; fi

		install -Dm755 "${SCRIPT_DIR}/Conf_files/Quickshell/qs-session" /mnt/usr/bin/qs-session
		sed -i -e "s|__USER__|${UN}|g" -e "s|__WM_CMD__|${dbus_wrap}${wm_exec}|g" /mnt/usr/bin/qs-session
		printf 'ALL ALL=(root) NOPASSWD: /usr/bin/qs-session --switch *, /usr/bin/poweroff, /usr/bin/reboot, /usr/bin/zzz, /usr/bin/ZZZ, /sbin/poweroff, /sbin/reboot, /sbin/zzz, /sbin/ZZZ\n' > /mnt/etc/sudoers.d/90-qs-switch ; chmod 440 /mnt/etc/sudoers.d/90-qs-switch

		if [[ "$dm_l" == "quickshell" ]]; then
			if ! grep -q "qs-session --locked" /mnt/etc/profile 2>/dev/null; then
				printf '\nif [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$(tty 2>/dev/null)" = "/dev/tty1" ]; then exec /usr/bin/qs-session --locked; fi\n' >> /mnt/etc/profile
			fi
		elif [[ "$dm_l" == "greetd" ]]; then
			mkdir -p /mnt/etc/greetd
			if [[ "$UI" == "Quickshell" ]]; then
				printf '[terminal]\nvt = 7\n\n[initial_session]\ncommand = "/usr/bin/qs-session --locked"\nuser = "%s"\n\n[default_session]\ncommand = "/usr/bin/qs-session --locked"\nuser = "%s"\n' "$UN" "$UN" > /mnt/etc/greetd/config.toml
			else
				sed -i -e "s|^command = .*|command = \"tuigreet --time --cmd ${wm_exec}\"|" -e 's/^vt = .*/vt = 7/' /mnt/etc/greetd/config.toml
			fi
		fi
		if [[ -f /mnt/usr/share/wayland-sessions/${DE,,}.desktop ]]; then
			sed -i 's|^Exec=.*|Exec=/usr/bin/qs-session|' /mnt/usr/share/wayland-sessions/${DE,,}.desktop
		fi
	fi
}
BootloaderSetup () {

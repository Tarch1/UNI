	if [[ "$VBTsel" -eq 1 && "$VM_TYPE" == "vmware" && "$os_l" == "arch" ]]; then Services+=( vmtoolsd ) ; fi
	if [[ "$dm_l" =~ ^(ly|greetd|lightdm|sddm|gdm)$ ]]; then Services+=( "$dm_l" ) ; fi

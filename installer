		if [[ "$UI" == "Quickshell" ]]; then
			mkdir -p /mnt/usr/share/quickshell /mnt/var/cache/quickshell/{frames,silhouettes} "$ucfg"/{quickshell,wallust/templates}
			chmod 755 /mnt/var/cache/quickshell
			chmod 1777 /mnt/var/cache/quickshell/frames /mnt/var/cache/quickshell/silhouettes
			if CR python3 -c "import onnxruntime, numpy, PIL" &>/dev/null; then
				echo "Downloading MobileSAM silhouette models (~44 MB)..."
				local sam_base="https://huggingface.co/Acly/MobileSAM/resolve/main"
				for sam_f in mobile_sam_image_encoder.onnx sam_mask_decoder_multi.onnx; do
					if [[ ! -f "/mnt/usr/share/quickshell/$sam_f" ]]; then
						if curl -fsSL --connect-timeout 15 --max-time 180 -L -o "/mnt/usr/share/quickshell/${sam_f}.part" "${sam_base}/${sam_f}"; then
							mv -f "/mnt/usr/share/quickshell/${sam_f}.part" "/mnt/usr/share/quickshell/${sam_f}" ; chmod 644 "/mnt/usr/share/quickshell/${sam_f}"
						else
							rm -f "/mnt/usr/share/quickshell/${sam_f}.part" "/mnt/usr/share/quickshell/${sam_f}"
							echo "[!] Warning: failed to download ${sam_f}. Falling back to ffmpeg+awk engine."
						fi
					fi
				done
			fi
			local qs_env="DRI_PRIME=0 __NV_PRIME_RENDER_OFFLOAD=0 __GLX_VENDOR_LIBRARY_NAME=mesa __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json VK_LOADER_DRIVERS_DISABLE=*nvidia* VDPAU_DRIVER=null LIBVA_DRIVER_NAME=$va_drv QT_FFMPEG_DECODING_HW_DEVICE_TYPES=vaapi QSG_RHI_BACKEND=opengl QT_LOGGING_RULES=qt.qpa.wayland.textinput=false"
			if [[ "$VBTsel" -eq 1 ]]; then qs_env="QSG_RHI_BACKEND=opengl QSG_RENDER_LOOP=basic QT_LOGGING_RULES=qt.qpa.wayland.textinput=false" ; fi
			local qs_loop="while :; do env $qs_env quickshell; [[ -f /tmp/qs_lock_active_\$UID ]] || break; sleep 1; done"
			sed -i -e "s|lock_cmd = .*|lock_cmd = quickshell ipc call lock lock|" -e "s|loginctl lock-session|quickshell ipc call lock lock|g" "$ucfg/hypr/hypridle.conf"
			if [[ "$DE" == "Niri" ]]; then
				if ! grep -q "wallpaper-backdrop" "$cfg"; then cfg_appends+='\nlayer-rule {\n\tmatch namespace="^wallpaper-backdrop$"\n\tplace-within-backdrop true\n}\n' ; fi
				if ! grep -q "skip-at-startup" "$cfg"; then cfg_appends+='\nhotkey-overlay {\n\tskip-at-startup\n}\n' ; fi
				cfg_seds+=(
					-e "s#spawn-at-startup \"waybar\"#spawn-at-startup \"bash\" \"-c\" \"${qs_loop}\"#"
					-e '/spawn-at-startup "swaync"/d' -e '/spawn-at-startup "awww-daemon"/d'
					-e 's|spawn "fuzzel"|spawn "quickshell" "ipc" "call" "launcher" "toggle"|g'
					-e 's|spawn "hyprlock"|spawn "quickshell" "ipc" "call" "lock" "lock"|g'
					-e 's|spawn "swaync-client" "-t" "-sw"|spawn "quickshell" "ipc" "call" "controlcenter" "toggle"|g'
				)
			else
				cfg_seds+=(
					-e "s#exec-once = waybar#exec-once = bash -c '${qs_loop}'#"
					-e '/exec-once = swaync/d' -e 's|exec-once = hyprpaper & |exec-once = |'
					-e 's|\$menu = fuzzel|\$menu = quickshell ipc call launcher toggle|'
					-e 's|exec, hyprlock|exec, quickshell ipc call lock lock|g'
					-e 's|exec, swaync-client -t -sw|exec, quickshell ipc call controlcenter toggle|g'
				)
			fi
		else
			printf 'auth required pam_unix.so nullok\naccount required pam_unix.so\npassword required pam_unix.so\nsession required pam_unix.so\n' > /mnt/etc/pam.d/hyprlock
			sed -i "s|loginctl lock-session|pidof hyprlock \|\| hyprlock|g" "$ucfg/hypr/hypridle.conf"
			touch "$ucfg/fuzzel/colors.ini" "$ucfg/wallust/colors-waybar.css"
			if [[ "$DE" == "Hyprland" ]]; then touch "$ucfg/hypr/hyprpaper.conf" ; fi
			if [[ -f "${SCRIPT_DIR}/Conf_files/Hyprlock/hyprlock.conf" ]]; then cp "${SCRIPT_DIR}/Conf_files/Hyprlock/hyprlock.conf" "$ucfg/hypr/" ; fi
		fi

		if [[ "$VBTsel" -eq 1 ]]; then
			if [[ "$UI" != "Quickshell" ]]; then
				sed -i 's/blur_passes = 3/blur_passes = 0/' "$ucfg/hypr/hyprlock.conf"
				sed -i -E 's/(&&|;|\|\||\)) hyprlock/\1 env -u LIBGL_ALWAYS_SOFTWARE hyprlock/g' "$ucfg/waybar/config.jsonc" "$ucfg/swaync/config.json" "$ucfg/hypr/hypridle.conf"
				cfg_seds+=( -e 's/spawn "hyprlock"/spawn "env" "-u" "LIBGL_ALWAYS_SOFTWARE" "hyprlock"/g' -e 's/exec, hyprlock/exec, env -u LIBGL_ALWAYS_SOFTWARE hyprlock/g' )
			fi
			if [[ "$DE" == "Niri" ]]; then
				if grep -q "environment *{" "$cfg"; then cfg_seds+=( -e '/environment *{/a\\tLIBGL_ALWAYS_SOFTWARE "1"' ) ; else cfg_appends+='\nenvironment {\n\tLIBGL_ALWAYS_SOFTWARE "1"\n}\n' ; fi
				cfg_appends+='\noutput "Virtual-1" {\n\tmode "1440x900"\n}\n'
				cfg_seds+=( -e 's/blur true/blur false/g' )
			else
				cfg_seds+=( -e '1i monitor=,1440x900@60,auto,1' )
			fi
			qs_flags+=( "--clipboard" )
		fi
		if [[ "$init_sys" != "systemd" ]]; then qs_flags+=( "--pipewire" ) ; fi
		for qf in "${qs_flags[@]}"; do
			if [[ "$DE" == "Niri" ]]; then cfg_starts+=( "spawn-at-startup \"/usr/bin/qs-session\" \"$qf\"" )
			else cfg_starts+=( "exec-once = /usr/bin/qs-session $qf" ) ; fi
		done

		if [[ ${#cfg_seds[@]} -gt 0 ]]; then sed -i "${cfg_seds[@]}" "$cfg" ; fi
		if [[ -n "$cfg_appends" ]]; then printf '%b' "$cfg_appends" >> "$cfg" ; fi
		if [[ ${#cfg_starts[@]} -gt 0 ]]; then
			local hook_kw="exec-once" ins_block ; if [[ "$DE" == "Niri" ]]; then hook_kw="spawn-at-startup" ; fi
			printf -v ins_block '%s\n' "${cfg_starts[@]}"
			INS="$ins_block" awk -v kw="$hook_kw" '!done && index($0, kw) { printf "%s", ENVIRON["INS"]; done=1 } { print }' "$cfg" > "${cfg}.tmp" && mv -f "${cfg}.tmp" "$cfg"
		fi
		if [[ "$DE" == "Niri" && "$cfg" != */config.kdl ]]; then mkdir -p "$ucfg/niri" ; sed -e 's/{{color4}}/#8be9fd/g' -e 's/{{[^}]*}}/#282a36/g' "$cfg" > "$ucfg/niri/config.kdl" ; fi

		CR chown -hR "$UN":users /home/"$UN"
		local init_wall="" ; init_wall=$(find "$ucfg/wallpapers/$init_sub" -type f -print -quit 2>/dev/null || true)
		if [[ -z "$init_wall" ]]; then init_wall=$(find "$ucfg/wallpapers" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.webp" \) -print -quit 2>/dev/null || true) ; fi
		init_wall="${init_wall#/mnt}"
		if [[ -n "$init_wall" && -x /mnt/usr/bin/wallust ]]; then
			CR_USER "wallust run -s \"$init_wall\"" || true
			if [[ -x /mnt/usr/bin/theming ]]; then CR_USER "/usr/bin/theming --init-only \"$init_sub\" \"$init_wall\" \"static\" \"$init_fx\" \"true\" \"false\"" || true ; fi
		fi
		if [[ "$UI" == "Quickshell" && ! -f "$ucfg/quickshell/colors.json" ]]; then
			printf '{\n\t"wallpaper": "%s",\n\t"wallFrame": "",\n\t"silhouette": "",\n\t"wallMode": "static",\n\t"uiBlur": %s,\n\t"uiAnimations": true,\n\t"firstRunDone": false,\n\t"background": "#1e1e2e",\n\t"foreground": "#cdd6f4",\n\t"color0": "#282a36",\n\t"color1": "#f38ba8",\n\t"color2": "#a6e3a1",\n\t"color3": "#f9e2af",\n\t"color4": "#89b4fa",\n\t"color5": "#cba6f7",\n\t"color6": "#94e2d5",\n\t"color7": "#bac2de",\n\t"color8": "#585b70",\n\t"color9": "#f38ba8",\n\t"color10": "#a6e3a1",\n\t"color11": "#f9e2af",\n\t"color12": "#89b4fa",\n\t"color13": "#cba6f7",\n\t"color14": "#94e2d5",\n\t"color15": "#cdd6f4"\n}\n' "$init_wall" "$init_fx" > "$ucfg/quickshell/colors.json"
			CR chown "$UN":users "/home/$UN/.config/quickshell/colors.json"
		fi
	else
		CR chown -hR "$UN":users /home/"$UN"
	fi
	rm -f /mnt/etc/sudoers.d/99-installer-temp
	if [[ "$VBTsel" -eq 1 ]]; then
		printf 'WLR_NO_HARDWARE_CURSORS=1\nWLR_RENDERER_ALLOW_SOFTWARE=1\nLIBGL_ALWAYS_SOFTWARE=1\nKITTY_DISABLE_WAYLAND=1\nQT_QPA_PLATFORMTHEME=qt6ct\n' >> /mnt/etc/environment
	else
		printf 'MOZ_ENABLE_WAYLAND=1\nQT_QPA_PLATFORM="wayland;xcb"\nQT_QPA_PLATFORMTHEME=qt6ct\nGDK_BACKEND="wayland,x11"\nSDL_VIDEODRIVER=wayland\nELECTRON_OZONE_PLATFORM_HINT=auto\nDRI_PRIME=0\n__NV_PRIME_RENDER_OFFLOAD=0\n__GLX_VENDOR_LIBRARY_NAME=mesa\n__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json\nVK_LOADER_DRIVERS_DISABLE="*nvidia*"\nVDPAU_DRIVER=null\nLIBVA_DRIVER_NAME=%s\nQT_FFMPEG_DECODING_HW_DEVICE_TYPES=vaapi\n' "$va_drv" >> /mnt/etc/environment
	fi
	mkdir -p /mnt/etc/skel/.config
	cp -r "$ucfg/"* /mnt/etc/skel/.config/ 2>/dev/null || true
}
InstallationSetup () {
	SYS_LSPCI=$(lspci || true) ; SYS_CPU=$(cat /proc/cpuinfo || true)
	VBTsel=0 ; VM_TYPE="none" ; HAS_NVIDIA=0 ; HAS_AMD=0 ; CPU_TYPE="Unknown" ; IS_LAPTOP=0
	CRYPT=0 ; PASS="" ; LVM=0 ; HIB=0 ; SWAP="none" ; SWAP_DIM=0 ; ZRAM=0 ; ZRAM_DIM=0 ; ARCHREPO="" ; VOIDINSTALL="" ; LIBRARY=""
	if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then IS_LAPTOP=1 ; fi
	if echo "$SYS_LSPCI" | grep -qEi "(VirtualBox)"; then VM_TYPE="vbox" ; VBTsel=1
	elif echo "$SYS_LSPCI" | grep -qEi "(VMware)"; then VM_TYPE="vmware" ; VBTsel=1
	elif echo "$SYS_LSPCI" | grep -qEi "(Virtio|QXL)"; then VM_TYPE="qemu" ; VBTsel=1 ; fi
	echo "Synchronizing system clock..." ; local t_ok=0
	if command -v timedatectl &>/dev/null && timedatectl status &>/dev/null; then
		if timedatectl set-ntp true &>/dev/null; then
			for _ in {1..5}; do
				if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == "yes" ]]; then t_ok=1 ; break ; fi
				sleep 1
			done
		fi
	elif command -v chronyc &>/dev/null && chronyc tracking &>/dev/null; then
		chronyc -a online &>/dev/null || true
		chronyc -a 'burst 4/4' &>/dev/null || true
		sleep 2
		if chronyc -a makestep &>/dev/null && chronyc -n sources 2>/dev/null | grep -q '^\^\*'; then t_ok=1 ; fi
	elif command -v chronyd &>/dev/null && chronyd -q "pool pool.ntp.org iburst" &>/dev/null; then t_ok=1
	elif command -v ntpd &>/dev/null && ntpd -qg &>/dev/null; then t_ok=1
	elif command -v ntpdate &>/dev/null && ntpdate pool.ntp.org &>/dev/null; then t_ok=1 ; fi
	local http_date="" http_ep="" now_ep="" diff_s=0
	http_date=$(curl -fsI --max-time 5 http://1.1.1.1 2>/dev/null | awk -F': ' 'tolower($1)=="date"{gsub(/\r/,"",$2); print $2; exit}' || true)
	if [[ -z "$http_date" ]]; then http_date=$(curl -fsI --max-time 5 http://clients3.google.com/generate_204 2>/dev/null | awk -F': ' 'tolower($1)=="date"{gsub(/\r/,"",$2); print $2; exit}' || true) ; fi
	if [[ -n "$http_date" ]]; then
		http_ep=$(date -u -d "$http_date" +%s 2>/dev/null || true)
		now_ep=$(date -u +%s)
		if [[ -n "$http_ep" ]]; then
			diff_s=$(( now_ep - http_ep ))
			if (( diff_s < 0 )); then diff_s=$(( -diff_s )) ; fi
			if [[ "$t_ok" -eq 0 || "$diff_s" -gt 60 ]]; then
				if date -u -s "@$http_ep" &>/dev/null; then t_ok=1 ; fi
			fi
		fi
	fi
	if [[ "$t_ok" -eq 0 ]]; then echo "[!] CRITICAL: System clock synchronization failed." >&2 ; return 1 ; fi
	echo "System clock: $(date)"
	echo 'List of all errors occurred during the installation process:' > Errors
	local CheckandSetup=( Check_required_files DistroDetection UEFIsel KERNELsel IRFsel IRFSsel BOOTLOADERsel )
	for c in "${CheckandSetup[@]}"; do "$c" ; done
	local os_l="${OS,,}"
	if [[ "$VBTsel" == "1" ]]; then
		LANGUAGE='en_GB.UTF-8' ; LOCALE='it_IT.UTF-8' ; HN=tarch1 ; UN=tarch1 ; TZONE='Europe/Rome' ; PID=UUID ; FS=btrfs
		if [[ "$os_l" == "artix" ]]; then ARCHREPO=1 ; INIT="OpenRC"
		elif [[ "$os_l" == "void" ]]; then LIBRARY="GLIBC" ; VOIDINSTALL="XBPS" ; INIT="Runit"
		else INIT="systemd" ; fi
		CPUsel ; GPUsel ; DRIVEsel ; LUKSsel ; LVMsel ; HIBERNATIONsel ; SWAPsel ; DESKTOPsel ; LOGINsel
	else
		if [[ "$os_l" == "artix" ]]; then ARCHREPOsel ; INITsel
		elif [[ "$os_l" == "void" ]]; then VOIDINSTALLsel ; LIBRARYsel ; INIT="Runit"
		else INIT="systemd" ; fi
		CPUsel ; GPUsel ; DRIVEsel
		local Personalization=( LOCALEsel LANGUAGEsel TIMEZONEsel HOSTNAMEsel USERNAMEsel PARTIDsel FILESYSTEMsel LUKSsel LVMsel )
		if [[ "$IS_LAPTOP" -eq 1 ]]; then Personalization+=( HIBERNATIONsel ) ; fi
		Personalization+=( SWAPsel DESKTOPsel LOGINsel )
		for s in "${Personalization[@]}"; do "$s" ; done
	fi
	while true; do
		local sec_str="None" luks_str="No" lvm_str="No" hib_str="Disabled" swap_str="None"
		if [[ "$CRYPT" -eq 1 ]]; then luks_str="Yes" ; fi
		if [[ "$LVM" -eq 1 ]]; then if [[ "$CRYPT" -eq 1 ]]; then lvm_str="Yes (LVM on LUKS)" ; else lvm_str="Yes" ; fi ; fi
		if [[ "$HIB" -eq 1 ]]; then hib_str="Enabled" ; fi
		case "$SWAP" in
			lvm)       swap_str="LVM vg0/swap (${SWAP_DIM} GiB)" ;;
			partition) if [[ "$CRYPT" -eq 1 ]]; then swap_str="Ephemeral Partition (${SWAP_DIM} GiB)" ; else swap_str="Partition (${SWAP_DIM} GiB)" ; fi ;;
			swapfile)  swap_str="Swapfile (${SWAP_DIM} GiB)" ;;
			zram)      swap_str="Zram (${ZRAM_DIM} GiB)" ;;
			*)         swap_str="None" ;;
		esac
		if [[ "$ZRAM" -eq 1 && "$SWAP" != "zram" ]]; then swap_str+=" + Zram (${ZRAM_DIM} GiB)" ; fi
		if [[ "$ADD_SETUP" -eq 1 ]]; then if [[ "$ADD_FORMAT" -eq 1 ]]; then sec_str="$ADD_DRIVE (Format) | FS: $ADD_FS | Label: $ADD_LABEL | LUKS: $luks_str" ; else sec_str="${ADD_PARTS[*]} (Mount existing - Keep data)" ; fi ; fi
		local sum="\n=== CONFIGURATION SUMMARY ===\nOS: $OS | Init: $INIT | Kernel: $KERNEL | Initramfs: $IRF ($IRFS) | Bootloader: $BL\nOS Drive: $DRIVE | FS: $FS | LUKS: $luks_str | LVM: $lvm_str | ID: $PID\nHibernation: $hib_str | Swap: $swap_str\nSec. Drive: $sec_str\nUser: $UN | Hostname: $HN | Locale: $LOCALE | Language: $LANGUAGE | Timezone: $TZONE\nDesktop: $DE | UI: ${UI:-None} | DM: $DM\n"
		if [[ "$CPU_TYPE" != "Unknown" ]]; then sum+="CPU: $CPU_TYPE (Microcode enabled)\n" ; fi
		if [[ "$HAS_NVIDIA" -eq 1 ]]; then sum+="NVIDIA Driver: $NVsel | Manager: $GPUMANAGERsel\n" ; fi
		if [[ "$HAS_AMD" -eq 1 ]]; then sum+="AMD GPU: Detected (Mesa/RADV)\n" ; fi
		if [[ "$VBTsel" -eq 1 ]]; then sum+="Virtual Machine Mode: ON ($VM_TYPE)\n" ; fi
		echo -e "${sum}============================="
		YesNoSel "Is this configuration correct to proceed with partitioning?"
		if [[ "$CC" -eq 1 ]]; then echo "Proceeding with installation..." ; break ; fi
		local edit_options=( "Drive Selection" "Kernel" "Initramfs" "Initramfs Mode" "Bootloader" "Hostname" "Username" "Locale" "Language" "Timezone" "Filesystem" "Partition ID" "LUKS" "LVM" "Hibernation" "Swap" "Desktop" )
		if [[ "$DE" =~ ^(Hyprland|Niri)$ ]]; then edit_options+=( "UI Shell" ) ; fi
		edit_options+=( "Display Manager" )
		if [[ "$os_l" == "artix" ]]; then edit_options+=( "Init System" "Arch Repos" ) ; fi
		if [[ "$os_l" == "void" ]]; then edit_options+=( "Library" "Install Method" ) ; fi
		if [[ "$HAS_NVIDIA" -eq 1 ]]; then edit_options+=( "NVIDIA Driver" ) ; fi
		edit_options+=( "Abort Installation" )
		MenuSel "EDIT_CHOICE" "What would you like to change?" "${edit_options[@]}"
		case "$EDIT_CHOICE" in
			"Drive Selection") DRIVEsel ; ValidateStorage ;;
			"Kernel") KERNELsel ;;
			"Initramfs") IRFsel ;;
			"Initramfs Mode") IRFSsel ;;
			"Bootloader") BOOTLOADERsel ;;
			"Hostname") HOSTNAMEsel ;;
			"Username") USERNAMEsel ;;
			"Locale") LOCALEsel ;;
			"Language") LANGUAGEsel ;;
			"Timezone") TIMEZONEsel ;;
			"Filesystem") FILESYSTEMsel ; ValidateStorage ;;
			"Partition ID") PARTIDsel ;;
			"LUKS") LUKSsel ; ValidateStorage ;;
			"LVM") LVMsel ; ValidateStorage ;;
			"Hibernation") HIBERNATIONsel ; ValidateStorage ;;
			"Swap") SWAPsel ; ValidateStorage ;;
			"Desktop") DESKTOPsel ; LOGINsel ;;
			"UI Shell") SHELLsel ;;
			"Display Manager") LOGINsel ;;
			"Init System") INITsel ;;
			"Arch Repos") ARCHREPOsel ;;
			"Library") LIBRARYsel ; if [[ "$HAS_NVIDIA" -eq 1 && "$LIBRARY" == "MUSL" ]]; then NVsel="MESA" ; GPUMANAGERsel="None" ; fi ;;
			"Install Method") VOIDINSTALLsel ;;
			"NVIDIA Driver") GPUsel ;;
			"Abort Installation") exit 1 ;;
		esac
	done
	if [[ "$os_l" != "void" ]]; then
		if ! pgrep -x pacman &>/dev/null; then rm -f /var/lib/pacman/db.lck /mnt/var/lib/pacman/db.lck ; fi
		PKGmanager="pacman" ; PKGinst=" -S" ; PKGupd="y" ; PKGupg="u" ; PKGchk=" -Q" ; PKGrmv=" -R" ; PKGfrc="dd" ; PKGskp=( --needed --noconfirm ) ; PKGrsk=( --noconfirm ) ; keylayout='KEYMAP=it' ; chroot="${os_l}-chroot"
		sed -i '/\(Color\|ParallelDownloads\)/ s/#//' /etc/pacman.conf
		if ! grep -q "ILoveCandy" /etc/pacman.conf; then sed -i '/ParallelDownloads/a ILoveCandy' /etc/pacman.conf ; fi
		if [[ "$os_l" == "arch" ]]; then keypath='etc/vconsole.conf' ; PKGstrap="pacstrap /mnt" ; FSTABgen=genfstab ; init_sys="systemd" ; sed -i '/\[multilib]/,/mirrorlist/ s/#//' /etc/pacman.conf ; $PKGmanager$PKGinst$PKGupd
		elif [[ "$os_l" == "artix" ]]; then keypath='etc/conf.d/keymaps' ; PKGstrap="basestrap /mnt" ; FSTABgen=fstabgen ; init_sys="${INIT,,}" ; sed -i '/\[lib32]/,/mirrorlist/ s/#//' /etc/pacman.conf ; if [[ "$ARCHREPO" == "1" ]]; then ArchRepoSetup /etc/pacman.conf ; fi ; $PKGmanager$PKGinst$PKGupd ; fi
	else
		PKGmanager="xbps" ; PKGinst="-install" ; PKGupd=" -S" ; PKGupg="u" ; PKGchk="-query" ; PKGrmv="-remove" ; PKGfrc=" -F" ; PKGskp=( -y -y ) ; PKGrsk=( -y ) ; keylayout='KEYMAP=it' ; keypath='etc/rc.conf' ; init_sys="runit"
		VoidRepo="https://repo-default.voidlinux.org/current" ; if [[ "$LIBRARY" == "MUSL" ]]; then VoidRepo+="/musl" ; fi
		PKGstrap="$PKGmanager$PKGinst$PKGupd -R $VoidRepo -r /mnt ${PKGskp[*]}" ; chroot="chroot"
	fi
	PKGcheck
	local ArchTixSteps=( 'DiskPartition' 'FileSystemFormat' 'BaseSystemInstall' 'FStabGen' 'SetupEnvironment' 'PackageInstall' 'KernelSetup' 'ServiceSetup' 'UserSetup' 'BootloaderSetup' )
	for a in "${ArchTixSteps[@]}"; do "$a" ; done
	echo -e "\n=== INSTALLATION COMPLETED ==="
	if [[ "$(wc -l < Errors)" -gt 1 ]]; then echo -e "\n[!] Some errors logged during installation:" ; cat Errors ; cp Errors /mnt/var/log/installer_errors.log ; else echo "[+] Clean installation: zero errors detected." ; fi
	YesNoSel "Reboot system"
	if [[ "$CC" -eq 1 ]]; then umount -R -l /mnt || true ; reboot ; else echo "OK" ; exit 0 ; fi
}

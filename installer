#!/bin/bash
[[ "$(id -u)" -ne 0 ]] && { echo 'Please run as root.' >&2; exit 1; }
if ! ping -c 1 -W 3 8.8.8.8 &>/dev/null; then echo "Network connection required. Please connect to the internet." ; exit 1 ; fi
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/menu" ]]; then source "${SCRIPT_DIR}/menu" ; else echo "[!] Error: 'menu' file missing!" ; exit 1 ; fi
exec &> >(stdbuf -oL -eL tee -a /tmp/install_$(date +%Y%m%d_%H%M%S).log)
set -E
trap 'SHOWerror' ERR

SHOWerror () {
	local err_code=$? ; local call_stack=""
	for (( i=1; i<${#FUNCNAME[@]}-1; i++ )); do
		local func="${FUNCNAME[$i]}" ; local line="${BASH_LINENO[$i-1]}"
		call_stack="${func}(line:${line}) -> $call_stack"
	done
	local err_line="${BASH_LINENO[0]}"
	local err_msg="Error in ${call_stack% -> *} \nActual failure at line: $err_line (Exit code: $err_code)"
	echo -e "$err_msg" >> Errors
	echo -e "\n[CRITICAL ERROR DETECTED]\n$err_msg"
	YesNoSel "Do you want to continue the installation anyway? (Fix: 'nano +$err_line installer')"
	if [[ "$CC" -eq 1 ]]; then echo "OK, still going..." ; else echo "OK, exit." ; exit 1 ; fi
}
CR () { "$chroot" /mnt "$@" ; }
CR_USER () { CR sudo -u "$UNsel" bash -c "$1" ; }
Check_required_files () {
	local files=( Bootloader/Refind/themes/Blur-theme/theme.conf Bootloader/Grub-Sekiro/{theme.txt,sekiro_1920x1080.png,select_c.png} Bootloader/Grub-Eiffel/{theme.txt,eiffel_tower_under_construction.png,select_c.png} )
	local miss=()
	for a in "${files[@]}"; do if [[ ! -f "${SCRIPT_DIR}/$a" ]]; then miss+=("$a") ; fi ; done
	if [[ ${#miss[@]} -gt 0 ]]; then echo 'Required file(s) missing:' "${miss[@]}" ; exit 1 ; fi
}
DiskPartition() {
	if grep -qs '/mnt' /proc/mounts; then echo "[i] Found active mount point in /mnt. Unmounting..." ; umount -R /mnt ; fi
	if [[ $(wc -l < /proc/swaps) -gt 1 ]]; then echo "[i] Found active Swap. Disabling..." ; swapoff -a ; fi
	for dev in /dev/mapper/crypt*; do [[ -b "$dev" ]] && cryptsetup close "${dev##*/}" ; done
	$PKGmanager$PKGinst "${PKGskp[@]}" "${fs[@]}"
	for p in "$DRIVE"?*; do if grep -qs "^$p " /proc/mounts; then echo "[i] Unmounting active partition $p..." ; umount "$p" ; fi ; done
	sgdisk -ozZ "$DRIVE"
	local total_ram_gb=$(( ($(free -m | awk '/^Mem:/{print $2}') + 1023) / 1024 )) ; local swap_gb
	if [[ "$total_ram_gb" -le 8 ]]; then swap_gb=$(( total_ram_gb + 1 )) ; elif [[ "$total_ram_gb" -le 32 ]]; then swap_gb=$total_ram_gb ; else swap_gb=32 ; fi
	if [[ "$UEFImode" -eq 0 ]]; then parted -s "$DRIVE" -- mktable gpt mkpart "ESP" fat32 2MiB 514MiB mkpart "LINUX-ROOT" 514MiB -"${swap_gb}GiB" mkpart "SWAP" -"${swap_gb}GiB" 100% mkpart "BIOS" 1MiB 2MiB set 1 boot on set 3 swap on set 4 bios_grub on
	else parted -s "$DRIVE" -- mktable gpt mkpart "ESP" fat32 1MiB 513MiB mkpart "LINUX-ROOT" 513MiB -"${swap_gb}GiB" mkpart "SWAP" -"${swap_gb}GiB" 100% set 1 esp on set 3 swap on ; fi
	udevadm settle || true
	local p="" ; if [[ "$DRIVE" =~ [0-9]$ ]]; then p="p" ; fi
	BOOT_PART="${DRIVE}${p}1" ; ROOT_PART="${DRIVE}${p}2" ; SWAP_PART="${DRIVE}${p}3" ; DEVICE="${DRIVE##*/}"
	echo "DRIVE=$DRIVE DEVICE=$DEVICE"
	if [[ "$ADD_SETUP" -eq 1 && "$ADD_FORMAT" -eq 1 && -n "$ADDITIONAL_DRIVE" ]]; then
		for ap in "$ADDITIONAL_DRIVE"?*; do if grep -qs "^$ap " /proc/mounts; then echo "[i] Unmounting $ap..." ; umount "$ap" ; fi ; done
		sgdisk -ozZ "$ADDITIONAL_DRIVE"
		parted -s "$ADDITIONAL_DRIVE" -- mktable gpt mkpart "DATA" 1MiB 100%
		udevadm settle || true
		local ap_p="" ; if [[ "$ADDITIONAL_DRIVE" =~ [0-9]$ ]]; then ap_p="p" ; fi
		ADD_PARTS=("${ADDITIONAL_DRIVE}${ap_p}1")
	fi
	if [[ -z "$DRIVE" || -z "$DEVICE" ]]; then echo "No partition were created, check the installer. Closing installation!" ; exit 1 ; else echo 'We can proceed with the formatting of file system' ; fi
	sleep 1 ; echo -e " BP=$BOOT_PART RP=$ROOT_PART AP=${ADD_PARTS[*]} PID=$PIDsel" ; lsblk -f
}
FileSystemFormat() {
	BootLabel='EFI' ; RootLabel='ROOT' ; modules=() ; binaries='' ; CRYPT_ADD_MAP=()
	local eff_pid="$PIDsel"
	mkfs.fat -F32 -n "$BootLabel" "$BOOT_PART"
	BOOTID="$(blkid -s "$PIDsel" -o value "$BOOT_PART")"
	if [[ "$LUKS_ENC" -eq 1 ]]; then
		if [[ "$PIDsel" == "PARTUUID" ]]; then eff_pid="UUID" ; fi
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$ROOT_PART" -d -
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$ROOT_PART" cryptroot -d -
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$SWAP_PART" -d -
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$SWAP_PART" cryptswap -d -
		TARGET_ROOT="/dev/mapper/cryptroot" ; TARGET_SWAP="/dev/mapper/cryptswap"
		CRYPT_ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")" ; CRYPT_SWAP_UUID="$(blkid -s UUID -o value "$SWAP_PART")"
	else
		TARGET_ROOT="$ROOT_PART" ; TARGET_SWAP="$SWAP_PART"
	fi
	mkswap -L SWAP "$TARGET_SWAP" ; udevadm settle || true
	SWAPID="$(blkid -s "$eff_pid" -o value "$TARGET_SWAP")" ; SWAP_UUID="$(blkid -s UUID -o value "$TARGET_SWAP")"
	UNIfstab="$PIDsel=$BOOTID /boot vfat defaults 0 2\n$eff_pid=$SWAPID none swap defaults 0 0\n"
	case "$FSsel" in
		ext4)	mkfs.ext4 -F -L "$RootLabel" "$TARGET_ROOT"
				ROOTID="$(blkid -s "$eff_pid" -o value "$TARGET_ROOT")"
				mount "$TARGET_ROOT" /mnt
				UNIfstab+="$eff_pid=$ROOTID / ext4 defaults 0 1\n"
				;;
		btrfs)	modules=(btrfs) ; binaries='btrfs'
				local SUBVolumes=( 'home' 'var_log' 'var_cache' 'snapshots' )
				local options='noatime,compress=zstd,space_cache=v2,discard=async'
				mkfs.btrfs -fL "$RootLabel" "$TARGET_ROOT"
				ROOTID="$(blkid -s "$eff_pid" -o value "$TARGET_ROOT")"
				mkdir -p /tmp/btrpool ; mount "$TARGET_ROOT" /tmp/btrpool
				btrfs su cr /tmp/btrpool/@
				mount -o defaults,"$options",subvol=@ "$TARGET_ROOT" /mnt
				UNIfstab+="$eff_pid=$ROOTID / btrfs $options,subvol=@ 0 0\n"
				for c in "${SUBVolumes[@]}"; do
					btrfs su cr /tmp/btrpool/@"$c"
					local d_path="/$c"
					if [[ "$c" == "snapshots" ]]; then d_path="/.$c" ; elif [[ "$c" == "var_log" ]]; then d_path="/var/log" ; elif [[ "$c" == "var_cache" ]]; then d_path="/var/cache" ; fi
					mkdir -p "/mnt$d_path" ; mount -o defaults,"$options",subvol=@"$c" "$TARGET_ROOT" "/mnt$d_path"
					UNIfstab+="$eff_pid=$ROOTID $d_path btrfs $options,subvol=@$c 0 0\n"
				done
				umount /tmp/btrpool ; rmdir /tmp/btrpool
				;;
	esac
	EFF_PID="$eff_pid"
	swapon "$TARGET_SWAP"
	mkdir -p /mnt/boot ; mount "$BOOT_PART" /mnt/boot
	if [[ "$ADD_SETUP" -eq 1 && ${#ADD_PARTS[@]} -gt 0 ]]; then
		for idx in "${!ADD_PARTS[@]}"; do
			local part="${ADD_PARTS[$idx]}" ; local target_add="$part"
			if [[ "$ADD_FORMAT" -eq 1 ]]; then
				if [[ "$LUKS_ENC" -eq 1 ]]; then
					echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$part" -d -
					echo -n "$LUKS_PASS" | cryptsetup luksOpen "$part" cryptdata -d -
					target_add="/dev/mapper/cryptdata"
					CRYPT_ADD_MAP+=("cryptdata:$(blkid -s UUID -o value "$part")")
				fi
				local flags=(-f -L)
				if [[ "$ADD_FS" == "ext4" ]]; then flags=(-F -L) ; elif [[ "$ADD_FS" == "exfat" ]]; then flags=(-n) ; fi
				mkfs."$ADD_FS" "${flags[@]}" "$ADD_LABEL" "$target_add"
			else
				if grep -qs "^$part " /proc/mounts; then umount "$part" ; fi
			fi
			local mnt_name="HDD"
			if [[ ${#ADD_PARTS[@]} -gt 1 ]]; then
				local plbl ; plbl=$(blkid -s LABEL -o value "$target_add" 2>/dev/null | tr ' ' '_' || true)
				if [[ -n "$plbl" && ! -d "/mnt/media/$plbl" ]]; then mnt_name="$plbl" ; else mnt_name="HDD$((idx+1))" ; fi
			fi
			mkdir -p "/mnt/media/$mnt_name" ; mount "$target_add" "/mnt/media/$mnt_name"
			local add_pid add_type ; add_type=$(blkid -s TYPE -o value "$target_add" || echo auto)
			if ! add_pid=$(blkid -s "$eff_pid" -o value "$target_add") || [[ -z "$add_pid" ]]; then
				add_pid=$(blkid -s UUID -o value "$target_add") ; UNIfstab+="UUID=$add_pid /media/$mnt_name $add_type defaults,noatime,nofail 0 2\n"
			else
				UNIfstab+="$eff_pid=$add_pid /media/$mnt_name $add_type defaults,noatime,nofail 0 2\n"
			fi
		done
	fi
	lsblk -f
}
BaseSystemInstall () {
	if [[ "${OSsel,,}" == "void" ]]; then
		if [[ "${VImethod}" == "XBPS" ]]; then mkdir -p /mnt/var/db/xbps/keys ; cp -r /var/db/xbps/keys/* /mnt/var/db/xbps/keys/ 2>/dev/null || true ; $PKGstrap base-system
		elif [[ "${VImethod}" == "ROOTFS" ]]; then
			local tb="void-x86_64" ; if [[ "${LIBsel}" == "MUSL" ]]; then tb+="-musl" ; fi ; tb+="-ROOTFS.tar.xz"
			if [[ -f "${SCRIPT_DIR}/Conf_files/${tb}" ]]; then tar -xJf "${SCRIPT_DIR}/Conf_files/${tb}" -C /mnt
			else
				local latest_tb ; latest_tb=$(curl -s "https://repo-default.voidlinux.org/live/current/" | grep -oE "void-x86_64$( [[ "${LIBsel}" == "MUSL" ]] && echo "-musl" )-ROOTFS-[0-9]+\.tar\.xz" | head -n1 || true)
				local dl_url="https://voidlinux.org/static/${tb}" ; if [[ -n "$latest_tb" ]]; then dl_url="https://repo-default.voidlinux.org/live/current/${latest_tb}" ; fi
				curl -Lo "/tmp/${tb}" "$dl_url" ; tar -xJf "/tmp/${tb}" -C /mnt ; rm -f "/tmp/${tb}"
			fi
		fi
		for d in dev proc sys run; do mkdir -p /mnt/$d ; mount --bind /$d /mnt/$d ; done
		mount --make-rslave /mnt/sys
		if [[ "$UEFImode" -eq 1 ]]; then mkdir -p /mnt/sys/firmware/efi/efivars ; mount --bind /sys/firmware/efi/efivars /mnt/sys/firmware/efi/efivars || true ; fi
		cp -L /etc/resolv.conf /mnt/etc/resolv.conf || true
	else
		local BasePKG=( "${kernel[@]}" "${baselinux[@]}" "${logind[@]}" )
		if [[ -n "$UCODEsel" ]]; then BasePKG+=( "$UCODEsel" ) ; fi
		if [[ "$FSsel" == "btrfs" ]]; then BasePKG+=( "${btrfsutility[@]}" ) ; fi
		$PKGstrap "${BasePKG[@]}"
	fi
}
FStabGen () {
	if [[ "$LUKS_ENC" -eq 1 ]]; then
		echo -n "$LUKS_PASS" > /mnt/etc/crypt_key.bin ; chmod 600 /mnt/etc/crypt_key.bin
		echo -n "$LUKS_PASS" | cryptsetup luksAddKey -q "$SWAP_PART" /mnt/etc/crypt_key.bin -d -
		if [[ "${OSsel,,}" == "artix" && "$init_sys" == "openrc" ]]; then echo -e "target='cryptswap'\nsource='/dev/disk/by-uuid/$CRYPT_SWAP_UUID'\nkey='/etc/crypt_key.bin'" > /mnt/etc/conf.d/dmcrypt
		else echo "cryptswap UUID=$CRYPT_SWAP_UUID /etc/crypt_key.bin luks" > /mnt/etc/crypttab ; fi
		for c_entry in "${CRYPT_ADD_MAP[@]}"; do
			local c_name="${c_entry%%:*}" c_uuid="${c_entry#*:}"
			echo -n "$LUKS_PASS" | cryptsetup luksAddKey -q "/dev/disk/by-uuid/$c_uuid" /mnt/etc/crypt_key.bin -d -
			if [[ "${OSsel,,}" == "artix" && "$init_sys" == "openrc" ]]; then echo -e "\ntarget='$c_name'\nsource='/dev/disk/by-uuid/$c_uuid'\nkey='/etc/crypt_key.bin'" >> /mnt/etc/conf.d/dmcrypt
			else echo "$c_name UUID=$c_uuid /etc/crypt_key.bin luks,nofail" >> /mnt/etc/crypttab ; fi
		done
	fi
	if [[ -f /mnt/etc/fstab ]]; then mv -f /mnt/etc/fstab /mnt/etc/old-fstab ; fi
	if [[ "${OSsel,,}" == "void" ]]; then echo -e "$UNIfstab" > /mnt/etc/fstab
	else "$FSTABgen" -t "$EFF_PID" /mnt >> /mnt/etc/fstab ; sed -i '/\/media\// s/relatime/noatime,nofail/' /mnt/etc/fstab ; fi
	cat /mnt/etc/fstab
}
SetupEnvironment () {
	local k_map="${keylayout:-KEYMAP=it}" ; if [[ "$k_map" != KEYMAP=* ]]; then k_map="KEYMAP=$k_map" ; fi
	echo "$HNsel" > /mnt/etc/hostname
	echo -e "127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t$HNsel.localdomain\t$HNsel" >> /mnt/etc/hosts
	echo "$k_map" > /mnt/etc/vconsole.conf
	if [[ "${OSsel,,}" == "void" ]]; then
		echo "LANG=$LOCsel" > /mnt/etc/locale.conf ; echo 'HARDWARECLOCK="UTC"' >> /mnt/etc/rc.conf
		if [[ -n "$keypath" ]]; then echo "$k_map" >> /mnt/"$keypath" ; fi
		CR ln -sf /usr/share/zoneinfo/"$TZsel" /etc/localtime
		if [[ "$LIBsel" == "GLIBC" && -f /mnt/etc/default/libc-locales ]]; then
			sed -i "/\($LOCsel\|$LANGsel\)/ s/^#//" /mnt/etc/default/libc-locales
			CR xbps-reconfigure -f glibc-locales
		fi
	else
		sed -i "/\($LOCsel\|$LANGsel\)/ s/#//g" /mnt/etc/locale.gen
		echo -e "LANG=$LOCsel\nLANGUAGE=$LANGsel\nLC_TIME=$LOCsel\nLC_ADDRESS=$LOCsel\nLC_MESSAGES=$LOCsel" >> /mnt/etc/locale.conf
		if [[ -n "$keypath" ]]; then echo "$k_map" > /mnt/"$keypath" ; fi
		CR bash -c "ln -sf /usr/share/zoneinfo/$TZsel /etc/localtime; hwclock --systohc --utc || true; locale-gen"
	fi
}
PKGcheck () {
	echo "Initializing package groups..."
	UCODEsel="" ; microcode=() ; amddrivers=() ; nvidiadrivers=()
	if [[ "$CPU_TYPE" == "Intel" ]]; then UCODEsel="intel-ucode"
	elif [[ "$CPU_TYPE" == "AMD" ]]; then if [[ "${OSsel,,}" == "void" ]]; then UCODEsel="linux-firmware-amd" ; else UCODEsel="amd-ucode" ; fi ; fi
	if [[ -n "$UCODEsel" ]]; then microcode=("$UCODEsel") ; fi
	if [[ "$HAS_AMD" -eq 1 ]]; then	if [[ "${OSsel,,}" == "void" ]]; then amddrivers=(mesa-dri vulkan-loader mesa-vulkan-radeon) ; else amddrivers=(mesa vulkan-radeon) ; fi ; fi
	if [[ "$HAS_NVIDIA" -eq 1 && "$NVsel" =~ ^(OPEN|PROPRIETARY)$ ]]; then
		if [[ "${OSsel,,}" == "void" ]]; then
			if [[ "$LIBsel" != "MUSL" ]]; then nvidiadrivers=(nvidia nvidia-libs-32bit) ; fi
		else
			local nv_main="nvidia-dkms"
			if [[ "$NVsel" == "OPEN" ]]; then if [[ "$KSel" == "linux" ]]; then nv_main="nvidia-open" ; else nv_main="nvidia-open-dkms" ; fi
			elif [[ "$NVsel" == "PROPRIETARY" ]]; then if [[ "$KSel" == "linux" ]]; then nv_main="nvidia" ; elif [[ "$KSel" == "linux-lts" ]]; then nv_main="nvidia-lts" ; fi ; fi
			nvidiadrivers=("${nv_main}" nvidia-prime nvidia-settings nvidia-utils lib32-nvidia-utils opencl-nvidia lib32-opencl-nvidia libxnvctrl libvdpau)
			if [[ "${OSsel,,}" == "artix" ]]; then nvidiadrivers+=("nvidia-utils-${init_sys,,}") ; fi
		fi
	fi
	apps=(kitty telegram-desktop firefox) ; if [[ "${OSsel,,}" != "void" ]]; then apps+=(profile-sync-daemon) ; fi
	archive=(bzip2 cpio gzip xz 7zip tar unrar zip unzip zstd)
	audio=(pipewire wireplumber) ; if [[ "${OSsel,,}" == "void" ]]; then audio+=(alsa-pipewire libjack-pipewire sof-firmware) ; else audio+=(pipewire-pulse pipewire-alsa pipewire-jack sof-firmware) ; fi
	baselinux=(base-devel) ; if [[ "${OSsel,,}" == "void" ]]; then baselinux+=(base-system) ; else baselinux+=(base) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then baselinux+=("${init_sys,,}") ; fi
	baseutils=(bash-completion vim nano wget git binutils cryptsetup rsync) ; if [[ "${OSsel,,}" == "void" ]]; then baseutils+=(man-pages) ; else baseutils+=(man-db) ; fi
	bluetooth=(bluez blueman) ; if [[ "${OSsel,,}" != "void" ]]; then bluetooth+=(bluez-utils bluetui) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then bluetooth+=("bluez-${init_sys,,}" bluez-cups) ; fi
	bootloaderutility=(efibootmgr os-prober) ; if [[ "${OSsel,,}" != "void" ]]; then bootloaderutility+=(sbsigntools) ; fi
	if [[ "${OSsel,,}" != "void" ]]; then booster=(booster) ; else booster=() ; fi
	if [[ "$FSsel" == "btrfs" ]]; then btrfsutility=(snapper btrfs-progs) ; else btrfsutility=() ; fi
	if [[ "$DEsel" == "COSMIC" ]]; then desktop=(cosmic xdg-desktop-portal-cosmic)
	elif [[ "$DEsel" == "GNOME" ]]; then desktop=(gnome gnome-tweaks xdg-desktop-portal-gnome)
	elif [[ "$DEsel" == "KDE" ]]; then desktop=(plasma-meta dolphin konsole xdg-desktop-portal-kde)
	elif [[ "$DEsel" == "LXQt" ]]; then desktop=(lxqt xdg-desktop-portal-lxqt)
	elif [[ "$DEsel" == "Hyprland" ]]; then
		desktop=(hyprland hypridle polkit-kde-agent xdg-desktop-portal-hyprland xdg-desktop-portal-gtk)
		if [[ "$SHELLsel" == "Quickshell" ]]; then desktop+=(quickshell qt6-svg qt6-5compat) ; else desktop+=(hyprpaper fuzzel waybar swaync hyprlock) ; fi
	elif [[ "$DEsel" == "Niri" ]]; then
		desktop=(niri hypridle polkit-kde-agent xdg-desktop-portal-gnome xdg-desktop-portal-gtk xwayland-satellite)
		if [[ "$SHELLsel" == "Quickshell" ]]; then desktop+=(quickshell qt6-svg qt6-5compat) ; else desktop+=(fuzzel waybar swaync hyprlock) ; fi
	else desktop=() ; fi
	if [[ "${DMsel,,}" == "gdm" ]]; then displaymanager=(gdm) ; elif [[ "${DMsel,,}" == "greetd" ]]; then displaymanager=(greetd greetd-tuigreet) ; elif [[ "${DMsel,,}" == "lightdm" ]]; then displaymanager=(lightdm lightdm-gtk-greeter lightdm-gtk-greeter-settings) ; elif [[ "${DMsel,,}" == "ly" ]]; then displaymanager=(ly) ; elif [[ "${DMsel,,}" == "sddm" ]]; then displaymanager=(sddm) ; else displaymanager=() ; fi
	if [[ "${OSsel,,}" == "artix" ]]; then if [[ "${DMsel,,}" != "none" ]]; then displaymanager+=("${DMsel,,}-${init_sys,,}") ; fi ; fi
	filemanager=(yazi pcmanfm-qt tumbler file-roller android-tools) ; if [[ "${OSsel,,}" != "void" ]]; then filemanager+=(gvfs-mtp) ; fi
	if [[ "${OSsel,,}" == "void" ]]; then fonts=(nerd-fonts) ; else fonts=(ttf-jetbrains-mono-nerd) ; fi
	fs=(dialog mtools parted gptfdisk dosfstools ntfs-3g)
	if [[ "${BLsel,,}" == "grub" ]]; then grub=(grub) ; else grub=() ; fi
	if [[ "$FSsel" == "btrfs" ]]; then if [[ "${OSsel,,}" != "void" ]]; then grubbtrfs=(grub-btrfs) ; else grubbtrfs=() ; fi ; else grubbtrfs=() ; fi
	if [[ "${BLsel,,}" == "limine" ]]; then limine=(limine) ; else limine=() ; fi
	if [[ "${BLsel,,}" == "refind" ]]; then refind=(refind) ; else refind=() ; fi
	if [[ "${BLsel,,}" == "uki" ]]; then uki=(systemd-ukify) ; else uki=() ; fi
	if [[ "${OSsel,,}" == "void" ]]; then hardwareacceleration=(mesa-dri mesa-vaapi mesa-vulkan-radeon) ; else hardwareacceleration=(intel-media-driver vkd3d) ; fi
	kernel=("${KSel}" "${KSel}-headers") ; if [[ "${OSsel,,}" == "void" ]]; then kernel+=(linux-firmware-network) ; else kernel+=(linux-firmware) ; fi
	if [[ "$IRFSetup" == "booster" ]]; then kernel+=(booster) ; elif [[ "$IRFSetup" == "dracut" ]]; then kernel+=(dracut) ; elif [[ "$IRFSetup" == "mkinitcpio" ]]; then kernel+=(mkinitcpio) ; fi
	if [[ "${OSsel,,}" == "artix" ]]; then logind=(elogind elogind-"${init_sys,,}" "${init_sys,,}"-settingsd) ; elif [[ "${OSsel,,}" == "void" ]]; then logind=(seatd elogind) ; else logind=() ; fi
	net=(iwd chrony) ; if [[ "${OSsel,,}" == "void" ]]; then net+=(NetworkManager) ; else net+=(networkmanager) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then net+=("iwd-${init_sys,,}" "chrony-${init_sys,,}" "networkmanager-${init_sys,,}") ; fi
	print=(cups cups-pdf) ; if [[ "${OSsel,,}" == "void" ]]; then print+=(avahi-daemon cups-filters) ; else print+=(avahi system-config-printer) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then print+=("avahi-${init_sys,,}" "cups-${init_sys,,}") ; fi
	utility=(imv featherpad libqalculate fd btop fwupd fastfetch grim slurp wl-clipboard xclip swappy brightnessctl playerctl pavucontrol xorg-xwayland)
	if [[ "$DEsel" == "Niri" && "$SHELLsel" != "Quickshell" ]]; then utility+=(awww) ; fi
	if [[ "${OSsel,,}" != "void" ]]; then utility+=(lact cowfortune pacman-contrib) ; fi ; if [[ "${OSsel,,}" == "artix" ]]; then if [[ "$LUKS_ENC" -eq 1 ]]; then utility+=("cryptsetup-${init_sys,,}") ; fi ; fi
	if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then if [[ "${OSsel,,}" == "arch" && "$DEsel" =~ ^(KDE|GNOME|COSMIC)$ ]]; then utility+=(power-profiles-daemon) ; else utility+=(tlp) ; if [[ "${OSsel,,}" == "artix" ]]; then utility+=("tlp-${init_sys,,}") ; fi ; fi ; if [[ "$CPU_TYPE" == "Intel" ]]; then utility+=(thermald) ; if [[ "${OSsel,,}" == "artix" ]]; then utility+=("thermald-${init_sys,,}") ; fi ; fi ; fi
	if [[ "$VBTsel" -eq 1 ]]; then if [[ "$VM_TYPE" == "qemu" ]]; then utility+=(spice-vdagent) ; elif [[ "$VM_TYPE" == "vbox" ]]; then if [[ "${OSsel,,}" == "void" ]]; then utility+=(virtualbox-ose-guest) ; else utility+=(virtualbox-guest-utils) ; fi ; fi ; fi
	if [[ "${GPUMANAGERsel,,}" == "envycontrol" ]]; then utility+=(envycontrol) ; elif [[ "${GPUMANAGERsel,,}" == "cardwire" ]]; then utility+=(cardwire) ; fi
	if [[ "${OSsel,,}" == "void" ]]; then vulkan=(vulkan-loader) ; else vulkan=(vulkan-icd-loader vulkan-intel vulkan-mesa-layers) ; fi
	if [[ "${OSsel,,}" == "void" ]]; then local v_live_repos=(void-repo-nonfree); if [[ "$LIBsel" == "GLIBC" ]]; then v_live_repos+=(void-repo-multilib void-repo-multilib-nonfree) ; fi ; $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${v_live_repos[@]}" ; $PKGmanager$PKGinst$PKGupd ; fi
	echo "Checking remote package availability..."
	declare -A repo_map=()
	if [[ "${OSsel,,}" == "void" ]]; then while read -r pkg; do [[ -n "$pkg" ]] && repo_map["$pkg"]=1 ; done < <($PKGmanager$PKGchk -R -s "" | awk '{print $2}' | sed 's/-[0-9].*//') ; else while read -r pkg; do [[ -n "$pkg" ]] && repo_map["$pkg"]=1 ; done < <($PKGmanager$PKGinst"lq") ; fi
	local y="amddrivers apps archive audio baselinux baseutils bluetooth bootloaderutility booster btrfsutility desktop displaymanager filemanager fonts fs grub grubbtrfs hardwareacceleration kernel limine logind microcode net nvidiadrivers print refind uki utility vulkan" ; local miss=()
	for group in $y; do local -n current_group="$group" ; if [[ ${#current_group[@]} -eq 0 ]]; then continue ; fi ; local valid_pkgs=() ; for pkg in "${current_group[@]}"; do if [[ -n "${repo_map[$pkg]:-}" ]]; then valid_pkgs+=("$pkg") ; else miss+=("$pkg") ; fi ; done ; current_group=("${valid_pkgs[@]}") ; done
	if [[ ${#miss[@]} -gt 0 ]]; then echo -e "\n[!] WARNING: Unavailable packages:\n$(printf ' - %s\n' "${miss[@]}" | sort -u)\n" ; printf '%s\n' "${miss[@]}" | sort -u > pkg_missed ; YesNoSel "Are these packages CRITICAL for installation? (Yes = Abort / No = Skip and continue)" ; if [[ "$CC" -eq 1 ]]; then echo "[-] Installation aborted by user." ; exit 0 ; else echo "[*] Missing packages removed." ; fi ; fi
}

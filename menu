ValidateStorage () {
	SwapDiskMetrics
	if [[ "${HIB:-0}" -eq 0 ]]; then HIB_DELAY=0 ; fi
	if [[ -z "${SWAP:-}" ]]; then SWAPsel ; return 0 ; fi
	if [[ "$SWAP" != "none" && "$SWAP" != "zram" ]] && (( SWAP_DIM > _SWAP_MAX_GB )); then
		echo -e "\n[!] Current swap size (${SWAP_DIM} GiB) exceeds safe space on $DRIVE (max ${_SWAP_MAX_GB} GiB). Reconfiguring swap..."
		if [[ "${HIB:-0}" -eq 1 ]]; then HIBERNATIONsel ; fi
		SWAPsel
		return 0
	fi
	if [[ "${HIB:-0}" -eq 1 && ( "$SWAP" == "none" || "$SWAP" == "zram" ) ]]; then
		echo -e "\n[i] Hibernation requires disk-backed swap. Selecting swap type..."
		SWAPsel
		return 0
	fi
	if [[ "${LVM:-0}" -eq 1 && "$SWAP" == "partition" ]]; then
		SWAP="lvm"
		echo -e "\n[i] LVM enabled: switched swap from raw partition to LVM Logical Volume (vg0/swap)."
	elif [[ "${LVM:-0}" -eq 0 && "$SWAP" == "lvm" ]]; then
		echo -e "\n[i] LVM disabled: re-selecting swap type..."
		SWAPsel
		return 0
	fi
	if [[ "${CRYPT:-0}" -eq 1 && "${LVM:-0}" -eq 0 && "${HIB:-0}" -eq 1 && "$SWAP" == "partition" ]]; then
		SWAP="swapfile"
		echo -e "\n[i] LUKS + Hibernation without LVM: switched swap to Swapfile inside cryptroot (single passphrase, no keyfile in /boot)."
	fi
	if [[ "$SWAP" == "zram" ]]; then
		SWAP_DIM=0 ; ZRAM=1
		if (( ${ZRAM_DIM:-0} < 1 )); then ZRAM_DIM="$_SWAP_ZRAM_GB" ; fi
	elif [[ "$SWAP" == "none" ]]; then
		SWAP_DIM=0 ; ZRAM=0 ; ZRAM_DIM=0
	fi
}
TIMEZONEsel () {
	local def_tz="${GEO_TZ:-Europe/Rome}" tag="Default" tz_choice="" query="" pick=""
	if [[ "${GEO_DETECTED:-0}" -eq 1 ]]; then tag="Detected via IP" ; fi
	MenuSel "tz_choice" "Select Timezone" \
		"${def_tz} (${tag})" \
		"UTC" \
		"Search / Custom Timezone (Guided help)"
	case "$tz_choice" in
		"${def_tz}"*) TZONE="$def_tz" ;;
		"UTC")        TZONE="UTC" ;;
		*)
			if [[ -d /usr/share/zoneinfo ]]; then
				while true; do
					read -rp "Search timezone (e.g. Rome, London, New_York, Tokyo): " query
					if [[ -z "$query" ]]; then echo "Please enter a city, region or country." ; continue ; fi
					local matches=()
					mapfile -t matches < <(find /usr/share/zoneinfo -mindepth 1 -maxdepth 3 -type f ! -path '*/posix/*' ! -path '*/right/*' ! -name '*.tab' ! -name 'leap*' ! -name 'tzdata.zi' ! -name 'SECURITY' 2>/dev/null | sed 's|^/usr/share/zoneinfo/||' | grep -i -- "$query" | sort || true)
					if [[ ${#matches[@]} -eq 0 ]]; then echo "No timezone matched '$query'. Try another keyword." ; continue ; fi
					if [[ ${#matches[@]} -gt 25 ]]; then echo "Found ${#matches[@]} matches. Please type a more specific keyword (e.g. city name)." ; continue ; fi
					matches+=( "Search again" )
					MenuSel "pick" "Matching Timezones" "${matches[@]}"
					if [[ "$pick" != "Search again" ]]; then TZONE="$pick" ; break ; fi
				done
			else
				TextPromptSel "TZONE" "Enter timezone (e.g. Europe/Rome, America/New_York)" "$def_tz"
			fi ;;
	esac
	echo "Selected Timezone: $TZONE"
}
_LocaleHelpPicker () {
	local -n _lp_ref="$1" ; local kind="$2" ; local query="" pick="" src_file=""
	echo -e "\n[i] Locale = regional formats (date, time, currency, decimal separator)."
	echo "[i] Language = interface and system message text (e.g. Italian locale + British English UI)."
	if [[ -f /etc/locale.gen ]]; then src_file="/etc/locale.gen"
	elif [[ -f /etc/default/libc-locales ]]; then src_file="/etc/default/libc-locales" ; fi
	local all_locs=()
	if [[ -n "$src_file" ]]; then
		mapfile -t all_locs < <(awk '/UTF-8/{gsub(/^#+[[:space:]]*/, ""); if ($1 ~ /^[a-z]{2,3}_[A-Z]{2}\.UTF-8$/) print $1}' "$src_file" | sort -u || true)
	fi
	if [[ ${#all_locs[@]} -eq 0 ]]; then
		all_locs=( "de_AT.UTF-8" "de_CH.UTF-8" "de_DE.UTF-8" "en_AU.UTF-8" "en_CA.UTF-8" "en_GB.UTF-8" "en_IE.UTF-8" "en_US.UTF-8" "es_ES.UTF-8" "fr_FR.UTF-8" "it_IT.UTF-8" "ja_JP.UTF-8" "nl_NL.UTF-8" "pl_PL.UTF-8" "pt_BR.UTF-8" "pt_PT.UTF-8" "sv_SE.UTF-8" )
	fi
	while true; do
		read -rp "Search ${kind} code (e.g. it, en, de, fr, es, pt): " query
		if [[ -z "$query" ]]; then echo "Please enter a 2-letter language/country code." ; continue ; fi
		local matches=()
		mapfile -t matches < <(printf '%s\n' "${all_locs[@]}" | grep -i -- "$query" || true)
		if [[ ${#matches[@]} -eq 0 ]]; then echo "No UTF-8 locale matched '$query'. Try again." ; continue ; fi
		if [[ ${#matches[@]} -gt 25 ]]; then echo "Found ${#matches[@]} matches. Type a more specific code (e.g. en_GB or de_DE)." ; continue ; fi
		matches+=( "Search again" )
		MenuSel "pick" "Select ${kind}" "${matches[@]}"
		if [[ "$pick" != "Search again" ]]; then _lp_ref="$pick" ; break ; fi
	done
}

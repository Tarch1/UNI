#!/bin/bash
LOC_LIST=( "en_US.UTF-8" "en_GB.UTF-8" "it_IT.UTF-8" )

MenuSel () {
	local -n var_name="$1" ; local question="$2" ; local user_choice ; shift 2 ; local options=("$@")
	while true; do
		echo -e "\n=== $question ==="
		for i in "${!options[@]}"; do echo "$((i+1))) ${options[$i]}" ; done
		read -rp "Choice: " user_choice
		if [[ "$user_choice" =~ ^[0-9]+$ ]] && [[ "$user_choice" -le "${#options[@]}" ]] && [[ "$user_choice" -gt 0 ]]; then var_name="${options[$((user_choice-1))]}" ; echo "Selected: $var_name" ; break ; else echo "Invalid choice, please try again." ; fi
	done
}
TextPromptSel () {
	local -n var_name="$1" ; local prompt_msg="$2" ; local default_val="${3:-}" ; local input_val
	while true; do
		read -rp "$prompt_msg: " input_val
		if [[ -z "$input_val" ]]; then
			if [[ -n "$default_val" ]]; then input_val="$default_val" ; else echo "Input cannot be empty." ; continue ; fi
		fi
		YesNoSel "Confirm << $input_val >> is correct?"
		if [[ "$CC" -eq 1 ]]; then var_name="$input_val" ; break ; else echo "Let's try again..." ; fi
	done
}
YesNoSel () {
	local choice
	while true; do
		read -rp "$1 [yes/no]: " choice
		if [[ "${choice,,}" =~ ^(y|yes)$ ]]; then CC=1 ; break ; elif [[ "${choice,,}" =~ ^(n|no)$ ]]; then CC=0 ; break ; else echo "Please answer 'yes' (y) or 'no' (n)." ; fi
	done
}
ArchRepoSetup () {
	local target_conf="${1:-/etc/pacman.conf}"
	rm -rf /etc/pacman.d/gnupg/* 2>/dev/null || true ; mkdir -p /etc/pacman.d/gnupg ; chmod 700 /etc/pacman.d/gnupg
	pacman-key --init ; pacman-key --populate artix
	sed -i '/\[universe\]/,/^[[:space:]]*$/d' "$target_conf"
	printf '\n[universe]\nServer = https://universe.artixlinux.org/$arch\nServer = https://mirror1.artixlinux.org/universe/$arch\nServer = https://mirror.pascalpuffke.de/artix-universe/$arch\nServer = https://artixlinux.qontinuum.space/artixlinux/universe/os/$arch\nServer = https://mirror1.cl.netactuate.com/artix/universe/$arch\nServer = https://ftp.crifo.org/artix-universe/$arch\n' >> "$target_conf"
	if [[ ! -f /etc/pacman.d/mirrorlist-arch ]]; then pacman -Sy --noconfirm artix-keyring archlinux-keyring artix-archlinux-support ; fi
	if ! grep -q 'mirrorlist-arch' "$target_conf"; then printf '\n# Arch\n[extra]\nInclude = /etc/pacman.d/mirrorlist-arch\n\n[multilib]\nInclude = /etc/pacman.d/mirrorlist-arch\n' >> "$target_conf" ; fi
	pacman-key --populate artix archlinux
}
AutoOSsel () {
	local os_id
	if [[ -f /etc/os-release ]]; then if ! os_id=$(grep -i '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"'); then os_id="" ; fi ; else os_id="" ; fi
	if [[ "${os_id,,}" =~ ^(arch|artix|void)$ ]]; then OSsel="${os_id^}" ; else echo "Automated OS detection failed or unsupported Live OS." ; OperatingSystemSel ; fi
	echo "Detected Live OS: $OSsel"
}
CPUsel () {
	local cpu_info ; if ! cpu_info=$(echo "$SYS_CPU" | grep -m1 -Ei 'GenuineIntel|AuthenticAMD'); then cpu_info="" ; fi
	if [[ "$cpu_info" =~ Intel ]]; then CPU_TYPE="Intel" ; echo "Detected Intel CPU"
	elif [[ "$cpu_info" =~ AMD ]]; then CPU_TYPE="AMD" ; echo "Detected AMD CPU"
	else CPU_TYPE="Unknown" ; echo "No microcode needed or unknown CPU" ; fi
}
DriveSelection() {
	local avail_disks=() display_options=() choice_str
	while read -r name size type; do
		if [[ "$type" == "loop" || "$type" == "rom" ]]; then continue ; fi
		avail_disks+=("$name") ; display_options+=("$name ($size)")
	done < <(lsblk -dpno NAME,SIZE,TYPE)
	if [[ ${#avail_disks[@]} -eq 0 ]]; then echo "No drives detected!" ; exit 1 ; fi
	MenuSel "choice_str" "Select Target Drive for OS" "${display_options[@]}"
	DRIVE="${choice_str%% *}"
	local add_avail=() add_disp=()
	for i in "${!avail_disks[@]}"; do
		if [[ "${avail_disks[$i]}" == "$DRIVE" ]]; then continue ; fi
		add_avail+=("${avail_disks[$i]}") ; add_disp+=("${display_options[$i]}")
	done
	ADD_SETUP=0 ; ADD_FORMAT=0 ; ADD_FS="" ; ADD_LABEL="" ; ADDITIONAL_DRIVE="" ; ADD_PARTS=()
	if [[ ${#add_avail[@]} -gt 0 ]]; then
		local sec_mode
		MenuSel "sec_mode" "Secondary drive(s) detected: select action" "Format and mount a drive (Wipe data)" "Mount a single existing partition (Keep data)" "Mount ALL existing partitions (Keep data)" "Skip secondary drive(s)"
		case "$sec_mode" in
			"Format"*)
				ADD_SETUP=1 ; ADD_FORMAT=1
				MenuSel "choice_str" "Select Secondary Drive to Format" "${add_disp[@]}"
				ADDITIONAL_DRIVE="${choice_str%% *}"
				MenuSel "ADD_FS" "Select the filesystem for the secondary drive" "ext4" "btrfs" "exfat" "ntfs"
				TextPromptSel "ADD_LABEL" "Enter label for the secondary drive (leave empty for 'DATA')" "DATA"
				;;
			"Mount a single"*|"Mount ALL"*)
				local part_opts=() part_devs=()
				while read -r pname ptype psize pfstype plabel; do
					if [[ "$ptype" != "part" || -z "$pfstype" || "$pfstype" =~ ^(swap|crypto_LUKS)$ || "${plabel^^}" == "EFI" ]]; then continue ; fi
					part_devs+=("$pname") ; part_opts+=("$pname ($psize - $pfstype${plabel:+ - $plabel})")
				done < <(lsblk -lnpo NAME,TYPE,SIZE,FSTYPE,LABEL "${add_avail[@]}")
				if [[ ${#part_devs[@]} -eq 0 ]]; then echo "No valid data partitions found on secondary drive(s). Skipping."
				elif [[ "$sec_mode" == "Mount a single"* ]]; then
					ADD_SETUP=1 ; ADD_FORMAT=0
					MenuSel "choice_str" "Select Existing Partition to Mount" "${part_opts[@]}"
					ADD_PARTS=("${choice_str%% *}") ; ADDITIONAL_DRIVE="${ADD_PARTS[0]}"
				else
					ADD_SETUP=1 ; ADD_FORMAT=0 ; ADD_PARTS=("${part_devs[@]}") ; ADDITIONAL_DRIVE="${ADD_PARTS[*]}"
				fi
				;;
		esac
	fi
}
NvidiaSel () {
	if [[ "${OSsel,,}" == "void" ]]; then
		if [[ "$LIBsel" == "MUSL" ]]; then NVsel="MESA" ; GPUMANAGERsel="None" ; echo "MUSL selection detected, forcing Mesa/Nouveau." ; return 0 ; fi
		MenuSel "NVsel" "NVIDIA gpu found, choose driver" "PROPRIETARY" "MESA"
	else
		MenuSel "NVsel" "NVIDIA gpu found, choose driver" "OPEN" "NOUVEAU" "PROPRIETARY" "MESA"
	fi
	if [[ "$NVsel" =~ ^(OPEN|PROPRIETARY)$ ]]; then
		MenuSel "GPUMANAGERsel" "Select NVIDIA Optimus Manager" "Native" "Envycontrol" "Cardwire"
	else
		GPUMANAGERsel="None"
	fi
}
GPUsel () {
	echo "Detecting video chipset..."
	HAS_AMD=0 ; HAS_NVIDIA=0 ; NVsel="None" ; GPUMANAGERsel="None"
	local gpu_info ; if ! gpu_info=$(echo "$SYS_LSPCI" | grep -Ei 'VGA|3D'); then gpu_info="" ; fi
	if [[ "$gpu_info" =~ (AMD|Radeon) ]]; then HAS_AMD=1 ; echo "Detected AMD/Radeon GPU" ; fi
	if [[ "$gpu_info" =~ (VMware|VirtualBox|Virtio|QXL) ]]; then echo "VM detected: Default Mesa driver will be used" ; fi
	if [[ "$gpu_info" =~ NVIDIA ]]; then HAS_NVIDIA=1 ; NvidiaSel ; fi
	if [[ ! "$gpu_info" =~ (AMD|Radeon|VMware|VirtualBox|Virtio|QXL|NVIDIA) ]]; then echo "Generic/Intel GPU: Mesa will be used" ; fi
}
LUKSSel () {
	YesNoSel "Do you want to encrypt your system with LUKS (Full Disk Encryption)?"
	if [[ "$CC" -eq 1 ]]; then
		LUKS_ENC=1
		while true; do
			read -rsp "Enter LUKS passphrase: " LUKS_PASS ; echo
			read -rsp "Verify LUKS passphrase: " LUKS_PASS2 ; echo
			if [[ "$LUKS_PASS" == "$LUKS_PASS2" && -n "$LUKS_PASS" ]]; then echo "Passphrase confirmed." ; break ; else echo "Passphrases do not match or empty. Try again." ; fi
		done
	else LUKS_ENC=0 ; LUKS_PASS="" ; fi
}
Pacman_Locked() {
	if [[ -f /var/lib/pacman/db.lck || -f /mnt/var/lib/pacman/db.lck ]]; then echo -e "Pacman is blocked. Removing lockfiles..." ; rm -f /var/lib/pacman/db.lck /mnt/var/lib/pacman/db.lck ; else echo "No locked database" ; fi
}
TimezoneSel () {
	while true; do
		read -rp $'\n=== Select Timezone ===\nType \'1\' for the default Europe/Rome or write custom format (e.g. America/New_York) [\'q\' to quit]: ' input_val
		if [[ -z "$input_val" ]]; then echo "Input cannot be empty." ; continue ; fi
		if [[ "$input_val" == "1" ]]; then TZsel="Europe/Rome" ; break ; fi
		if [[ "${input_val,,}" =~ ^(q|quit)$ ]]; then TZsel="" ; break ; fi
		YesNoSel "Confirm timezone: $input_val ?" ; if [[ "$CC" -eq 1 ]]; then TZsel="$input_val" ; break ; fi
	done
	echo "Selected Timezone: $TZsel"
}
UEFIsel () {
	if [[ -d "/sys/firmware/efi/" ]]; then if ! mount | grep -q "/sys/firmware/efi/efivars"; then mount -t efivarfs efivarfs /sys/firmware/efi/efivars ; fi ; UEFImode=1 ; echo 'UEFI Mode detected' ; else UEFImode=0 ; echo 'BIOS Mode detected' ; fi
}
ArchRepoSel() { YesNoSel "Do you want Arch repositories as well as Artix repositories?" ; if [[ "$CC" -eq 1 ]]; then ARCHrepo=1 ; echo "OK, adding Arch repositories!" ; else ARCHrepo='' ; echo "Proceeding without them..." ; fi ; }
BootloaderSel() { if [[ "$UEFImode" -eq 0 ]]; then BLsel="grub" ; echo "BIOS mode: GRUB selected automatically" ; return 0 ; fi ; local bl_options=( "refind" "grub" "efistub" "limine" ) ; if [[ "${OSsel,,}" == "arch" ]]; then bl_options+=( "systemd-boot" "uki" ) ; fi ; MenuSel "BLsel" "Select Bootloader" "${bl_options[@]}" ; }
DesktopEnvSel() { MenuSel "DEsel" "Select Desktop Environment / Window Manager" "KDE" "GNOME" "LXQt" "COSMIC" "Hyprland" "Niri" "None" ; ShellSel ; }
ShellSel() { if [[ "$DEsel" =~ ^(Hyprland|Niri)$ ]]; then MenuSel "SHELLsel" "Select Desktop Shell for $DEsel" "Traditional (Waybar + Swaync + Fuzzel)" "Quickshell" ; if [[ "$SHELLsel" == "Traditional"* ]]; then SHELLsel="Traditional" ; fi ; else SHELLsel="None" ; fi ; }
DisplayManagerSel() { if [[ "$DEsel" == "GNOME" ]]; then DMsel="GDM" ; elif [[ "$DEsel" == "KDE" ]]; then DMsel="SDDM" ; else MenuSel "DMsel" "Select Display Manager" "Ly" "Greetd" "LightDM" "None" ; fi ; }
FilesystemSel() { MenuSel "FSsel" "Select filesystem for ROOT" "ext4" "btrfs" ; }
HostnameSel() { TextPromptSel "HNsel" "Enter preferred hostname" ; }
InitSystemSel() { if [[ "${OSsel,,}" == "artix" ]]; then MenuSel "INITsel" "Select preferred Init System for Artix" "OpenRC" "Runit" "s6" "dinit" ; else INITsel="systemd" ; fi ; }
IRFsel() { if [[ "${OSsel,,}" == "void" ]]; then IRFSetup="dracut" ; echo "Selected Initramfs: dracut" ; else MenuSel "IRFSetup" "Select preferred Initramfs Generator" "booster" "mkinitcpio" "dracut" ; fi ; }
IRFSModeSel() { MenuSel "IRFSMode" "Select preferred Initramfs Mode, if universal for all PC or just for this one" "Host" "Universal" ; }
KernelSel() { if [[ "${OSsel,,}" == "void" ]]; then MenuSel "KSel" "Select preferred Kernel" "linux" "linux-lts" ; else MenuSel "KSel" "Select preferred Kernel" "linux" "linux-lts" "linux-hardened" "linux-zen" ; fi ; }
LibrarySel() { MenuSel "LIBsel" "Select base library" "GLIBC" "MUSL" ; }
LanguageSel() { MenuSel "LANGsel" "Select preferred Language" "${LOC_LIST[@]}" ; }
LocalizationSel() { MenuSel "LOCsel" "Select localization" "${LOC_LIST[@]}" ; }
OperatingSystemSel() { MenuSel "OSsel" "Select the distro to setup" "Arch" "Artix" "Void" ; }
PartIDSel() { MenuSel "PIDsel" "Select partition identifier" "UUID" "PARTUUID" "LABEL" ; }
UsernameSel() { TextPromptSel "UNsel" "Enter preferred username" ; }
VoidInstMethod() { MenuSel "VImethod" "Select installation type" "XBPS" "ROOTFS" ; }

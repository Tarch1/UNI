#!/bin/bash

MenuSel () {
	local -n _ms_ref="$1" ; local question="$2" ; local user_choice ; shift 2 ; local options=("$@")
	while true; do
		echo -e "\n=== $question ==="
		for i in "${!options[@]}"; do echo "$((i+1))) ${options[$i]}" ; done
		read -rp "Choice: " user_choice
		if [[ "$user_choice" =~ ^[0-9]+$ ]] && [[ "$user_choice" -le "${#options[@]}" ]] && [[ "$user_choice" -gt 0 ]]; then _ms_ref="${options[$((user_choice-1))]}" ; echo "Selected: $_ms_ref" ; break ; else echo "Invalid choice, please try again." ; fi
	done
}
TextPromptSel () {
	local -n _tp_ref="$1" ; local prompt_msg="$2" ; local default_val="${3:-}" ; local input_val
	while true; do
		read -rp "$prompt_msg: " input_val
		if [[ -z "$input_val" ]]; then
			if [[ -n "$default_val" ]]; then input_val="$default_val" ; else echo "Input cannot be empty." ; continue ; fi
		fi
		YesNoSel "Confirm << $input_val >> is correct?"
		if [[ "$CC" -eq 1 ]]; then _tp_ref="$input_val" ; break ; else echo "Let's try again..." ; fi
	done
}
YesNoSel () {
	local choice
	while true; do
		read -rp "$1 [yes/no]: " choice
		if [[ "${choice,,}" =~ ^(y|yes)$ ]]; then CC=1 ; break ; elif [[ "${choice,,}" =~ ^(n|no)$ ]]; then CC=0 ; break ; else echo "Please answer 'yes' (y) or 'no' (n)." ; fi
	done
}
ArchRepoSetup () {
	local target_conf="${1:-/etc/pacman.conf}"
	rm -rf /etc/pacman.d/gnupg/* 2>/dev/null || true ; mkdir -p /etc/pacman.d/gnupg ; chmod 700 /etc/pacman.d/gnupg
	pacman-key --init ; pacman-key --populate artix
	sed -i '/\[universe\]/,/^[[:space:]]*$/d' "$target_conf"
	printf '\n[universe]\nServer = https://universe.artixlinux.org/$arch\nServer = https://mirror1.artixlinux.org/universe/$arch\nServer = https://mirror.pascalpuffke.de/artix-universe/$arch\nServer = https://artixlinux.qontinuum.space/artixlinux/universe/os/$arch\nServer = https://mirror1.cl.netactuate.com/artix/universe/$arch\nServer = https://ftp.crifo.org/artix-universe/$arch\n' >> "$target_conf"
	if [[ ! -f /etc/pacman.d/mirrorlist-arch ]]; then pacman -Sy --noconfirm artix-keyring archlinux-keyring artix-archlinux-support ; fi
	if ! grep -q 'mirrorlist-arch' "$target_conf"; then printf '\n# Arch\n[extra]\nInclude = /etc/pacman.d/mirrorlist-arch\n\n[multilib]\nInclude = /etc/pacman.d/mirrorlist-arch\n' >> "$target_conf" ; fi
	pacman-key --populate artix archlinux
}
DistroDetection () {
	local os_id=""
	if [[ -f /etc/os-release ]]; then os_id=$(grep -i '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"' || true) ; fi
	if [[ "${os_id,,}" =~ ^(arch|artix|void)$ ]]; then OS="${os_id^}" ; else echo "Automated OS detection failed or unsupported Live OS." ; OSsel ; fi
	echo "Detected Live OS: $OS"
}
UEFIsel () {
	if [[ -d "/sys/firmware/efi/" ]]; then if ! mount | grep -q "/sys/firmware/efi/efivars"; then mount -t efivarfs efivarfs /sys/firmware/efi/efivars ; fi ; FW=1 ; echo 'UEFI Mode detected' ; else FW=0 ; echo 'BIOS Mode detected' ; fi
}
_CountryToLocale () {
	case "${1^^}" in
		IT|SM|VA) echo "it_IT.UTF-8" ;;
		GB|UK)    echo "en_GB.UTF-8" ;;
		US)       echo "en_US.UTF-8" ;;
		DE)       echo "de_DE.UTF-8" ;;
		AT)       echo "de_AT.UTF-8" ;;
		CH)       echo "de_CH.UTF-8" ;;
		FR)       echo "fr_FR.UTF-8" ;;
		ES)       echo "es_ES.UTF-8" ;;
		PT)       echo "pt_PT.UTF-8" ;;
		BR)       echo "pt_BR.UTF-8" ;;
		NL)       echo "nl_NL.UTF-8" ;;
		BE)       echo "nl_BE.UTF-8" ;;
		PL)       echo "pl_PL.UTF-8" ;;
		SE)       echo "sv_SE.UTF-8" ;;
		NO)       echo "nb_NO.UTF-8" ;;
		DK)       echo "da_DK.UTF-8" ;;
		FI)       echo "fi_FI.UTF-8" ;;
		IE)       echo "en_IE.UTF-8" ;;
		CA)       echo "en_CA.UTF-8" ;;
		AU)       echo "en_AU.UTF-8" ;;
		NZ)       echo "en_NZ.UTF-8" ;;
		JP)       echo "ja_JP.UTF-8" ;;
		*)        echo "en_GB.UTF-8" ;;
	esac
}
SystemScan () {
	SYS_LSPCI=$(lspci 2>/dev/null || true)
	SYS_CPU=$(cat /proc/cpuinfo 2>/dev/null || true)

	HOST_IS_LAPTOP=0 ; HOST_VBTsel=0 ; HOST_VM_TYPE="none" ; HOST_CPU_TYPE="Unknown"
	HOST_HAS_AMD=0 ; HOST_HAS_NVIDIA=0 ; HOST_GPU_DESC="Generic / Intel"
	HOST_RAM_GB=$(( ($(LC_ALL=C free -m | awk '/^Mem:/{print $2}') + 1023) / 1024 ))

	if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then HOST_IS_LAPTOP=1 ; fi

	if echo "$SYS_LSPCI" | grep -qEi "(VirtualBox)"; then HOST_VM_TYPE="vbox" ; HOST_VBTsel=1
	elif echo "$SYS_LSPCI" | grep -qEi "(VMware)"; then HOST_VM_TYPE="vmware" ; HOST_VBTsel=1
	elif echo "$SYS_LSPCI" | grep -qEi "(Virtio|QXL)"; then HOST_VM_TYPE="qemu" ; HOST_VBTsel=1 ; fi

	local cpu_info="" ; cpu_info=$(echo "$SYS_CPU" | grep -m1 -Ei 'GenuineIntel|AuthenticAMD' || true)
	if [[ "$cpu_info" =~ Intel ]]; then HOST_CPU_TYPE="Intel"
	elif [[ "$cpu_info" =~ AMD ]]; then HOST_CPU_TYPE="AMD" ; fi

	local gpu_info="" gpu_tags=()
	gpu_info=$(echo "$SYS_LSPCI" | grep -Ei 'VGA|3D|Display' || true)
	if [[ "$gpu_info" =~ (AMD|Radeon) ]]; then HOST_HAS_AMD=1 ; gpu_tags+=("AMD/Radeon") ; fi
	if [[ "$gpu_info" =~ NVIDIA ]]; then HOST_HAS_NVIDIA=1 ; gpu_tags+=("NVIDIA") ; fi
	if [[ "$gpu_info" =~ Intel ]]; then gpu_tags+=("Intel") ; fi
	if [[ "$gpu_info" =~ (VMware|VirtualBox|Virtio|QXL) ]]; then gpu_tags+=("VM ($HOST_VM_TYPE)") ; fi
	if [[ ${#gpu_tags[@]} -gt 0 ]]; then HOST_GPU_DESC=$(IFS=' + '; echo "${gpu_tags[*]}") ; fi

	SYS_MEM_SLEEP=$(cat /sys/power/mem_sleep 2>/dev/null || true)
	SYS_POWER_STATE=$(cat /sys/power/state 2>/dev/null || true)
	LOCKDOWN_ACTIVE=0 ; HOST_CAN_HIBERNATE=0 ; HOST_HAS_RTC_WAKE=0
	if [[ -r /sys/kernel/security/lockdown ]] && grep -qE '\[(integrity|confidentiality)\]' /sys/kernel/security/lockdown 2>/dev/null; then
		LOCKDOWN_ACTIVE=1
	fi
	if grep -qw 'disk' <<< "$SYS_POWER_STATE" && [[ "$LOCKDOWN_ACTIVE" -eq 0 ]]; then HOST_CAN_HIBERNATE=1 ; fi
	if [[ -e /sys/class/rtc/rtc0/wakealarm ]]; then HOST_HAS_RTC_WAKE=1 ; fi

	GEO_DETECTED=0 ; GEO_CC="" ; GEO_TZ="" ; GEO_LOCALE=""
	local geo_raw="" geo_st="" geo_cc="" geo_tz=""
	geo_raw=$(curl -fsSL --connect-timeout 2 --max-time 3 "http://ip-api.com/line/?fields=status,countryCode,timezone" 2>/dev/null || true)
	if [[ -n "$geo_raw" ]]; then
		geo_st=$(sed -n '1p' <<< "$geo_raw")
		geo_cc=$(sed -n '2p' <<< "$geo_raw")
		geo_tz=$(sed -n '3p' <<< "$geo_raw")
		if [[ "$geo_st" == "success" && -n "$geo_tz" ]]; then GEO_CC="$geo_cc" ; GEO_TZ="$geo_tz" ; fi
	fi
	if [[ -z "$GEO_TZ" ]]; then
		GEO_TZ=$(curl -fsSL --connect-timeout 2 --max-time 3 "https://ipapi.co/timezone" 2>/dev/null | tr -d '\r\n' || true)
		GEO_CC=$(curl -fsSL --connect-timeout 2 --max-time 3 "https://ipapi.co/country_code" 2>/dev/null | tr -d '\r\n' || true)
	fi
	if [[ -n "$GEO_TZ" && -f "/usr/share/zoneinfo/$GEO_TZ" ]]; then
		GEO_DETECTED=1
		GEO_LOCALE="$(_CountryToLocale "${GEO_CC:-}")"
	else
		GEO_TZ="Europe/Rome"
		GEO_LOCALE="it_IT.UTF-8"
	fi

	IS_LAPTOP="$HOST_IS_LAPTOP" ; VBTsel="$HOST_VBTsel" ; VM_TYPE="$HOST_VM_TYPE"
	CPU_TYPE="$HOST_CPU_TYPE" ; HAS_AMD="$HOST_HAS_AMD" ; HAS_NVIDIA="$HOST_HAS_NVIDIA"
	CAN_HIBERNATE="$HOST_CAN_HIBERNATE" ; HAS_RTC_WAKE="$HOST_HAS_RTC_WAKE"
	NVsel="None" ; GPUMANAGERsel="None"

	local ff_str="Desktop" vm_str="Bare Metal" hib_str="Unsupported" rtc_str="No" geo_str="Fallback ($GEO_TZ / $GEO_LOCALE)"
	if [[ "$HOST_IS_LAPTOP" -eq 1 ]]; then ff_str="Laptop (Battery detected)" ; fi
	if [[ "$HOST_VBTsel" -eq 1 ]]; then vm_str="Virtual Machine ($HOST_VM_TYPE)" ; fi
	if [[ "$LOCKDOWN_ACTIVE" -eq 1 ]]; then hib_str="Blocked (Secure Boot / Kernel Lockdown)"
	elif [[ "$HOST_CAN_HIBERNATE" -eq 1 ]]; then hib_str="Supported (disk/S4)" ; fi
	if [[ "$HOST_HAS_RTC_WAKE" -eq 1 ]]; then rtc_str="Yes (suspend-then-hibernate ready)" ; fi
	if [[ "$GEO_DETECTED" -eq 1 ]]; then geo_str="$GEO_TZ | $GEO_LOCALE (${GEO_CC:-?})" ; fi

	echo -e "\n=== HARDWARE & SYSTEM SCAN ==="
	echo "Platform : $ff_str | $vm_str"
	echo "CPU / RAM: $HOST_CPU_TYPE | ${HOST_RAM_GB} GiB RAM"
	echo "GPU      : $HOST_GPU_DESC"
	echo "Sleep    : ${SYS_MEM_SLEEP:-N/A} | Hibernate: $hib_str | RTC Wake: $rtc_str"
	echo "Geo-IP   : $geo_str"
	echo "=============================="
}
InstallModeSel () {
	local mode_choice=""
	MenuSel "mode_choice" "Select Installation Mode" \
		"This machine (Auto-configure hardware & power from scan | Host initramfs)" \
		"Personalize (Full manual control / Portable install | Universal initramfs default)"
	if [[ "$mode_choice" == "This machine"* ]]; then
		INSTALL_MODE="host"
		IRFS="Host"
		IS_LAPTOP="$HOST_IS_LAPTOP" ; VBTsel="$HOST_VBTsel" ; VM_TYPE="$HOST_VM_TYPE"
		CPU_TYPE="$HOST_CPU_TYPE" ; HAS_AMD="$HOST_HAS_AMD" ; HAS_NVIDIA="$HOST_HAS_NVIDIA"
		CAN_HIBERNATE="$HOST_CAN_HIBERNATE" ; HAS_RTC_WAKE="$HOST_HAS_RTC_WAKE"
	else
		INSTALL_MODE="personalize"
		IRFS="Universal"
	fi
}
CPUsel () {
	if [[ "${1:-}" != "manual" && "${INSTALL_MODE:-host}" == "host" ]]; then
		CPU_TYPE="$HOST_CPU_TYPE"
		echo "CPU Microcode (Auto): $CPU_TYPE"
		return 0
	fi
	local cpu_choice=""
	MenuSel "cpu_choice" "Select Target CPU Microcode (Host detected: $HOST_CPU_TYPE)" \
		"Both (Intel + AMD - Universal portable)" \
		"Intel" \
		"AMD" \
		"None (No microcode)"
	case "$cpu_choice" in
		"Both"*)  CPU_TYPE="Both" ;;
		"Intel")  CPU_TYPE="Intel" ;;
		"AMD")    CPU_TYPE="AMD" ;;
		*)        CPU_TYPE="Unknown" ;;
	esac
}
_NvidiaDriverPrompt () {
	NVsel="None" ; GPUMANAGERsel="None"
	if [[ "${OS,,}" == "void" ]]; then
		if [[ "$LIBRARY" == "MUSL" ]]; then NVsel="MESA" ; echo "MUSL selection detected, forcing Mesa/Nouveau."
		else MenuSel "NVsel" "NVIDIA GPU selected/found, choose driver" "PROPRIETARY" "MESA" ; fi
	else
		MenuSel "NVsel" "NVIDIA GPU selected/found, choose driver" "OPEN" "NOUVEAU" "PROPRIETARY" "MESA"
	fi
	if [[ "$NVsel" =~ ^(OPEN|PROPRIETARY)$ ]]; then MenuSel "GPUMANAGERsel" "Select NVIDIA Optimus Manager" "Native" "Envycontrol" "Cardwire" ; fi
}
GPUsel () {
	if [[ "${1:-}" != "manual" && "${INSTALL_MODE:-host}" == "host" ]]; then
		HAS_AMD="$HOST_HAS_AMD" ; HAS_NVIDIA="$HOST_HAS_NVIDIA" ; NVsel="None" ; GPUMANAGERsel="None"
		echo "GPU Profile (Auto): $HOST_GPU_DESC"
		if [[ "$HAS_NVIDIA" -eq 1 ]]; then _NvidiaDriverPrompt ; fi
		return 0
	fi
	local gpu_choice=""
	MenuSel "gpu_choice" "Select Target GPU Profile (Host detected: $HOST_GPU_DESC)" \
		"Keep host detected ($HOST_GPU_DESC)" \
		"Generic / Intel / Multi-PC (Mesa)" \
		"AMD / Radeon (Mesa + RADV)" \
		"NVIDIA (Dedicated or Intel+NVIDIA Optimus)" \
		"AMD + NVIDIA (AMD iGPU + NVIDIA Optimus)"
	case "$gpu_choice" in
		"Keep host"*)
			HAS_AMD="$HOST_HAS_AMD" ; HAS_NVIDIA="$HOST_HAS_NVIDIA" ; NVsel="None" ; GPUMANAGERsel="None"
			if [[ "$HAS_NVIDIA" -eq 1 ]]; then _NvidiaDriverPrompt ; fi ;;
		"AMD / Radeon"*)
			HAS_AMD=1 ; HAS_NVIDIA=0 ; NVsel="None" ; GPUMANAGERsel="None" ;;
		"NVIDIA"*)
			HAS_AMD=0 ; HAS_NVIDIA=1 ; _NvidiaDriverPrompt ;;
		"AMD + NVIDIA"*)
			HAS_AMD=1 ; HAS_NVIDIA=1 ; _NvidiaDriverPrompt ;;
		*)
			HAS_AMD=0 ; HAS_NVIDIA=0 ; NVsel="None" ; GPUMANAGERsel="None" ;;
	esac
}
FORMFACTORsel () {
	local ff_choice="" host_ff="Desktop"
	if [[ "$HOST_IS_LAPTOP" -eq 1 ]]; then host_ff="Laptop" ; fi
	MenuSel "ff_choice" "Select Target Machine Type (Host detected: $host_ff)" \
		"Laptop (Battery power management, lid switch, no numlock)" \
		"Desktop (No battery/TLP, numlock enabled)"
	if [[ "$ff_choice" == "Laptop"* ]]; then IS_LAPTOP=1 ; else IS_LAPTOP=0 ; fi
}
VMMODEsel () {
	local vm_choice="" host_vm="Bare Metal"
	if [[ "$HOST_VBTsel" -eq 1 ]]; then host_vm="VM ($HOST_VM_TYPE)" ; fi
	MenuSel "vm_choice" "Select Target Environment (Host detected: $host_vm)" \
		"Bare Metal (Physical PC)" \
		"VMware Guest" \
		"VirtualBox Guest" \
		"QEMU / KVM Guest"
	case "$vm_choice" in
		"VMware"*)     VBTsel=1 ; VM_TYPE="vmware" ;;
		"VirtualBox"*) VBTsel=1 ; VM_TYPE="vbox" ;;
		"QEMU"*)       VBTsel=1 ; VM_TYPE="qemu" ;;
		*)             VBTsel=0 ; VM_TYPE="none" ;;
	esac
}
DRIVEsel () {
	udevadm settle || true
	local avail_disks=() display_options=() choice_str
	local -A p_size=() p_fstype=() p_label=() p_used=() p_valid=()
	local tmp_mnt="/tmp/drv_probe_$$"
	mkdir -p "$tmp_mnt"
	echo -e "\n--- Detected Drives & Partitions ---"
	while read -r name size type; do
		if [[ "$type" == "loop" || "$type" == "rom" ]]; then continue ; fi
		local model ; model=$(lsblk -dnpo MODEL "$name" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		avail_disks+=("$name") ; display_options+=("$name ($size${model:+ - $model})")
		echo "* $name ($size${model:+ - $model})"
		local has_p=0
		while read -r pname ptype psize; do
			if [[ "$ptype" != "part" ]]; then continue ; fi
			has_p=1
			local pfstype plabel pparttype used_str=""
			pfstype=$(lsblk -dnpo FSTYPE "$pname" 2>/dev/null | tr -d ' ')
			if [[ -z "$pfstype" ]]; then pfstype=$(blkid -s TYPE -o value "$pname" 2>/dev/null || true) ; fi
			plabel=$(lsblk -dnpo LABEL "$pname" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
			if [[ -z "$plabel" ]]; then plabel=$(blkid -s LABEL -o value "$pname" 2>/dev/null || true) ; fi
			pparttype=$(lsblk -dnpo PARTTYPE "$pname" 2>/dev/null | tr -d ' ')
			if [[ -n "$pfstype" && ! "$pfstype" =~ ^(swap|crypto_LUKS|LVM2_member)$ ]]; then
				if grep -qs "^$pname " /proc/mounts; then
					used_str=$(df -h "$pname" 2>/dev/null | awk 'NR==2 {printf "Used: %s / %s (%s)", $3, $2, $5}')
				elif mount -o ro "$pname" "$tmp_mnt" 2>/dev/null; then
					used_str=$(df -h "$tmp_mnt" 2>/dev/null | awk 'NR==2 {printf "Used: %s / %s (%s)", $3, $2, $5}')
					umount "$tmp_mnt" 2>/dev/null || true
				fi
			fi
			p_size["$pname"]="$psize" ; p_fstype["$pname"]="$pfstype" ; p_label["$pname"]="$plabel" ; p_used["$pname"]="$used_str"
			if [[ -n "$pfstype" && ! "$pfstype" =~ ^(swap|LVM2_member)$ && "${pparttype,,}" != "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" && "${pparttype,,}" != "21686148-6449-6e6f-744e-656564454649" ]] && ! [[ "$pfstype" == "vfat" && "${plabel^^}" =~ ^(EFI|ESP|BOOT)$ ]]; then
				p_valid["$pname"]=1
			fi
			echo "  └─ $pname [$psize${used_str:+ | $used_str} | ${pfstype:-unformatted} | ${plabel:-no-label}]"
		done < <(lsblk -lnpo NAME,TYPE,SIZE "$name" 2>/dev/null)
		if [[ "$has_p" -eq 0 ]]; then echo "  └─ [Empty / Unpartitioned]" ; fi
	done < <(lsblk -dpno NAME,SIZE,TYPE)
	rmdir "$tmp_mnt" 2>/dev/null || true
	echo "------------------------------------"
	if [[ ${#avail_disks[@]} -eq 0 ]]; then echo "No drives detected!" ; exit 1 ; fi
	MenuSel "choice_str" "Select Target Drive for OS" "${display_options[@]}"
	DRIVE="${choice_str%% *}"
	local add_avail=() add_disp=()
	for i in "${!avail_disks[@]}"; do
		if [[ "${avail_disks[$i]}" == "$DRIVE" ]]; then continue ; fi
		add_avail+=("${avail_disks[$i]}") ; add_disp+=("${display_options[$i]}")
	done
	ADD_SETUP=0 ; ADD_FORMAT=0 ; ADD_FS="" ; ADD_LABEL="" ; ADD_DRIVE="" ; ADD_PARTS=()
	if [[ ${#add_avail[@]} -gt 0 ]]; then
		local part_opts=() part_devs=()
		for d in "${add_avail[@]}"; do
			while read -r pname ptype; do
				if [[ "$ptype" == "part" && "${p_valid[$pname]:-0}" -eq 1 ]]; then
					part_devs+=("$pname")
					part_opts+=("$pname (${p_size[$pname]}${p_used[$pname]:+ | ${p_used[$pname]}} | ${p_fstype[$pname]}${p_label[$pname]:+ | ${p_label[$pname]}})")
				fi
			done < <(lsblk -lnpo NAME,TYPE "$d" 2>/dev/null)
		done
		local sec_mode sec_options=()
		if [[ ${#part_devs[@]} -gt 0 ]]; then
			sec_options=( "Format and mount a drive (Wipe data)" "Mount a single existing partition (Keep data)" "Mount ALL existing partitions (Keep data)" "Skip secondary drive(s)" )
		else
			echo -e "\n[i] No mountable data partitions found on secondary drive(s)."
			sec_options=( "Format and mount a drive (Wipe data)" "Skip secondary drive(s)" )
		fi
		MenuSel "sec_mode" "Secondary drive(s) detected: select action" "${sec_options[@]}"
		case "$sec_mode" in
			"Format"*)			ADD_SETUP=1 ; ADD_FORMAT=1
								MenuSel "choice_str" "Select Secondary Drive to Format" "${add_disp[@]}"
								ADD_DRIVE="${choice_str%% *}"
								MenuSel "ADD_FS" "Select the filesystem for the secondary drive" "ext4" "btrfs" "exfat" "ntfs"
								TextPromptSel "ADD_LABEL" "Enter label for the secondary drive (leave empty for 'DATA')" "DATA"
								;;
			"Mount a single"*)	ADD_SETUP=1 ; ADD_FORMAT=0
								MenuSel "choice_str" "Select Existing Partition to Mount" "${part_opts[@]}"
								ADD_PARTS=("${choice_str%% *}") ; ADD_DRIVE="${ADD_PARTS[0]}"
								;;
			"Mount ALL"*)		ADD_SETUP=1 ; ADD_FORMAT=0 ; ADD_PARTS=("${part_devs[@]}") ; ADD_DRIVE="${ADD_PARTS[*]}"
								;;
		esac
	fi
}
LUKSsel () {
	local pass2
	YesNoSel "Do you want to encrypt your system with LUKS (Full Disk Encryption)?"
	if [[ "$CC" -eq 1 ]]; then
		CRYPT=1
		while true; do
			read -rsp "Enter LUKS passphrase: " PASS ; echo
			read -rsp "Verify LUKS passphrase: " pass2 ; echo
			if [[ "$PASS" == "$pass2" && -n "$PASS" ]]; then echo "Passphrase confirmed." ; break ; else echo "Passphrases do not match or empty. Try again." ; fi
		done
	else CRYPT=0 ; PASS="" ; fi
}
LVMsel () {
	local lvm_prompt="Do you want to use LVM (Logical Volume Manager)?"
	if [[ "${CRYPT:-0}" -eq 1 ]]; then
		lvm_prompt="Do you want to use LVM on LUKS? (Single encrypted container with logical volumes for root & swap)"
	fi
	if [[ "${FS:-}" == "btrfs" ]]; then
		echo -e "\n[i] Note: Btrfs already supports subvolumes; LVM is optional (mainly useful for a block-level swap volume without resume_offset)."
	fi
	YesNoSel "$lvm_prompt"
	if [[ "$CC" -eq 1 ]]; then LVM=1 ; echo "LVM: Enabled"
	else LVM=0 ; echo "LVM: Disabled" ; fi
}
SwapDiskMetrics () {
	_SWAP_RAM_GB="${HOST_RAM_GB:-$(( ($(LC_ALL=C free -m | awk '/^Mem:/{print $2}') + 1023) / 1024 ))}"
	if (( _SWAP_RAM_GB <= 8 )); then _SWAP_AUTO_GB=$(( _SWAP_RAM_GB + 1 ))
	elif (( _SWAP_RAM_GB <= 32 )); then _SWAP_AUTO_GB="$_SWAP_RAM_GB"
	else _SWAP_AUTO_GB=32 ; fi

	_SWAP_ZRAM_GB=$(( _SWAP_RAM_GB / 2 ))
	if (( _SWAP_ZRAM_GB < 1 )); then _SWAP_ZRAM_GB=1 ; fi
	if (( _SWAP_ZRAM_GB > 16 )); then _SWAP_ZRAM_GB=16 ; fi
	_SWAP_ZRAM_MAX_GB=$(( _SWAP_RAM_GB * 2 ))
	if (( _SWAP_ZRAM_MAX_GB < 16 )); then _SWAP_ZRAM_MAX_GB=16 ; fi

	local disk_bytes ; disk_bytes=$(lsblk -bdnpo SIZE "$DRIVE" 2>/dev/null || echo 25769803776)
	_SWAP_DISK_GB=$(( disk_bytes / 1073741824 ))
	_SWAP_STD_GB=4
	if (( _SWAP_DISK_GB <= 15 )); then _SWAP_STD_GB=2 ; fi

	_SWAP_OS_BASE_GB=$(( _SWAP_DISK_GB - 1 ))
	if (( _SWAP_OS_BASE_GB < 1 )); then _SWAP_OS_BASE_GB=1 ; fi
	_SWAP_MAX_GB=$(( _SWAP_OS_BASE_GB - 5 ))
	if (( _SWAP_MAX_GB < 1 )); then _SWAP_MAX_GB=1 ; fi
}
SWAPSIZEsel () {
	local -n _ss_ref="$1" ; local default_gb="$2" ; local max_gb="$3" ; local label="${4:-Swap}" ; local custom_val=""
	if (( default_gb > max_gb )); then default_gb="$max_gb" ; fi
	while true; do
		TextPromptSel "custom_val" "Enter ${label} size in GiB (1-${max_gb}, default ${default_gb})" "$default_gb"
		if [[ "$custom_val" =~ ^[0-9]+$ ]] && (( custom_val >= 1 && custom_val <= max_gb )); then
			_ss_ref="$custom_val"
			break
		else
			echo "Invalid size: must be a number between 1 and ${max_gb} GiB."
		fi
	done
}
AutoPowerSwap () {
	SwapDiskMetrics
	if [[ "${IS_LAPTOP:-0}" -eq 1 && "${CAN_HIBERNATE:-0}" -eq 1 ]] && (( _SWAP_AUTO_GB <= _SWAP_MAX_GB )); then
		HIB=1
		SWAP_DIM="$_SWAP_AUTO_GB"
		ZRAM=1
		ZRAM_DIM="$_SWAP_ZRAM_GB"
		if [[ "${HAS_RTC_WAKE:-0}" -eq 1 ]]; then HIB_DELAY=30 ; else HIB_DELAY=0 ; fi
		if [[ "${LVM:-0}" -eq 1 ]]; then SWAP="lvm"
		elif [[ "${CRYPT:-0}" -eq 1 ]]; then SWAP="swapfile"
		else SWAP="partition" ; fi
		local d_note="manual only (no RTC wakealarm)"
		if (( HIB_DELAY > 0 )); then d_note="suspend-then-hibernate after ${HIB_DELAY}min on battery" ; fi
		echo -e "\n[i] Auto Power/Swap (Laptop): Hibernation ENABLED (${SWAP}, ${SWAP_DIM} GiB) + Zram (${ZRAM_DIM} GiB) | ${d_note}."
	else
		HIB=0 ; HIB_DELAY=0 ; SWAP="zram" ; SWAP_DIM=0 ; ZRAM=1 ; ZRAM_DIM="$_SWAP_ZRAM_GB"
		if [[ "${IS_LAPTOP:-0}" -eq 1 ]]; then
			if [[ "${LOCKDOWN_ACTIVE:-0}" -eq 1 ]]; then
				echo -e "\n[!] Auto Power/Swap: Secure Boot / Kernel Lockdown blocks hibernation -> falling back to Zram (${ZRAM_DIM} GiB)."
			elif [[ "${CAN_HIBERNATE:-0}" -eq 0 ]]; then
				echo -e "\n[!] Auto Power/Swap: Firmware does not expose disk/S4 hibernation -> falling back to Zram (${ZRAM_DIM} GiB)."
			else
				echo -e "\n[!] Auto Power/Swap: Drive $DRIVE too small for ${_SWAP_AUTO_GB} GiB hibernation swap -> falling back to Zram (${ZRAM_DIM} GiB)."
			fi
		else
			echo -e "\n[i] Auto Power/Swap (Desktop): Hibernation disabled -> Zram (${ZRAM_DIM} GiB) enabled."
		fi
	fi
}
HIBERNATIONsel () {
	SwapDiskMetrics
	local os_after_auto_gb=$(( _SWAP_OS_BASE_GB - _SWAP_AUTO_GB ))
	if (( os_after_auto_gb < 1 )); then os_after_auto_gb=1 ; fi

	local hib_stat="Supported" rtc_stat="OK"
	if [[ "${LOCKDOWN_ACTIVE:-0}" -eq 1 ]]; then hib_stat="Blocked by Lockdown"
	elif [[ "${HOST_CAN_HIBERNATE:-0}" -eq 0 ]]; then hib_stat="Not exposed by host" ; fi
	if [[ "${HOST_HAS_RTC_WAKE:-0}" -eq 0 ]]; then rtc_stat="No" ; fi
	echo -e "\n[i] Host Power Capabilities | Sleep: ${SYS_MEM_SLEEP:-N/A} | Hibernate: ${hib_stat} | RTC Wake: ${rtc_stat}"
	if [[ "${INSTALL_MODE:-host}" == "host" && "${LOCKDOWN_ACTIVE:-0}" -eq 1 ]]; then
		echo "[!] Warning: Secure Boot / Kernel Lockdown is active on this machine and will prevent hibernation unless disabled."
	fi

	local hib_choice=""
	local prompt_hdr="Hibernation Setup | RAM: ${_SWAP_RAM_GB} GiB | Target Drive ($DRIVE): ~${_SWAP_DISK_GB} GiB"
	MenuSel "hib_choice" "$prompt_hdr" \
		"Enable Hibernation - Auto (${_SWAP_AUTO_GB} GiB Swap -> ~${os_after_auto_gb} GiB left for OS)" \
		"Enable Hibernation - Custom Size (Specify Swap GiB)" \
		"Disable Hibernation"

	case "$hib_choice" in
		"Enable Hibernation - Auto"*)
			HIB=1
			SWAP_DIM="$_SWAP_AUTO_GB"
			if (( SWAP_DIM > _SWAP_MAX_GB )); then
				echo "[!] Auto swap (${SWAP_DIM} GiB) exceeds safe disk space (max ${_SWAP_MAX_GB} GiB). Please choose a custom size."
				SWAPSIZEsel "SWAP_DIM" "$_SWAP_MAX_GB" "$_SWAP_MAX_GB" "Swap"
			fi
			;;
		"Enable Hibernation - Custom"*)
			HIB=1
			SWAPSIZEsel "SWAP_DIM" "$_SWAP_AUTO_GB" "$_SWAP_MAX_GB" "Swap"
			;;
		*)
			HIB=0
			HIB_DELAY=0
			SWAP_DIM="$_SWAP_STD_GB"
			;;
	esac

	if [[ "$HIB" -eq 1 ]]; then
		local delay_choice="" custom_min=""
		MenuSel "delay_choice" "Suspend-then-Hibernate Policy (On battery; AC stays suspended)" \
			"Enable after 30 minutes (Recommended for laptops)" \
			"Custom delay (minutes)" \
			"Disable (Manual hibernation / normal suspend only)"
		case "$delay_choice" in
			"Enable after 30"*) HIB_DELAY=30 ;;
			"Custom"*)
				while true; do
					TextPromptSel "custom_min" "Enter suspend-then-hibernate delay in minutes (5-240, default 30)" "30"
					if [[ "$custom_min" =~ ^[0-9]+$ ]] && (( custom_min >= 5 && custom_min <= 240 )); then HIB_DELAY="$custom_min" ; break
					else echo "Invalid delay: enter a number between 5 and 240." ; fi
				done ;;
			*) HIB_DELAY=0 ;;
		esac
	fi
}

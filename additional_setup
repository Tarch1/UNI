#!/bin/bash
MenuSel () {
	local -n var_name="$1"; local question="$2" user_choice; shift 2; local options=("$@")
	while true; do
		echo -e "\n=== $question ==="
		for i in "${!options[@]}"; do echo "$((i+1))) ${options[$i]}"; done
		read -rp "Choice: " user_choice
		[[ "$user_choice" =~ ^[0-9]+$ && "$user_choice" -le "${#options[@]}" && "$user_choice" -gt 0 ]] && { var_name="${options[$((user_choice-1))]}"; echo "Selected: $var_name"; break; } || echo "Invalid choice, please try again."
	done
}
TextPromptSel () {
	local -n var_name="$1"; local prompt_msg="$2" input_val
	while true; do
		read -rp "$prompt_msg: " input_val
		YesNoSel "Confirm << $input_val >> is correct?"
		[[ "$CC" -eq 1 ]] && { var_name="$input_val"; break; } || echo "Let's try again..."
	done
}
YesNoSel () {
	local choice
	while true; do
		read -rp "$1 [yes/no]: " choice
		if [[ "${choice,,}" =~ ^(y|yes)$ ]]; then CC=1 ; break
		elif [[ "${choice,,}" =~ ^(n|no)$ ]]; then CC=0 ; break
		else echo "Please answer 'yes' (y) or 'no' (n)." ; fi
	done
}
AdditionalDriveSel() {
	local avail_disks=(); local display_options=()
	while read -r name size type; do
		[[ "$type" == "loop" || "$type" == "rom" || "$name" == "$DRIVE" ]] && continue
		avail_disks+=("$name"); display_options+=("$name ($size)")
	done < <(lsblk -dpno NAME,SIZE,TYPE)
	
	if [[ "${#avail_disks[@]}" -gt 0 ]]; then
		echo -e "\n=== Secondary drive(s) detected ==="
		YesNoSel "Do you want to format and mount a secondary drive? (All data will be lost)"
		if [[ "$CC" -eq 1 ]]; then
			ADD_SETUP=1; ADD_FORMAT=1
			while true; do
				echo -e "\n=== Select Secondary Drive ==="
				for i in "${!display_options[@]}"; do echo "$((i+1))) ${display_options[$i]}"; done
				read -rp "Choice: " choice
				[[ "$choice" =~ ^[0-9]+$ && "$choice" -le "${#display_options[@]}" && "$choice" -gt 0 ]] && { ADDITIONAL_DRIVE="${avail_disks[$((choice-1))]}"; echo "Selected: $ADDITIONAL_DRIVE"; break; } || echo "Invalid choice."
			done
			MenuSel "ADD_FS" "Select the filesystem for the secondary drive" "ext4" "btrfs" "exfat" "ntfs"
			TextPromptSel "ADD_LABEL" "Enter label for the secondary drive (leave empty for 'DATA')"; [[ -z "$ADD_LABEL" ]] && ADD_LABEL="DATA"
		else ADD_SETUP=0; ADD_FORMAT=0; ADD_FS=""; ADD_LABEL=""; ADDITIONAL_DRIVE=""; fi
	else ADD_SETUP=0; ADD_FORMAT=0; ADD_FS=""; ADD_LABEL=""; ADDITIONAL_DRIVE=""; fi
}
ArchRepoSetup () {
	local target_conf="$1"; local cmd=(); local mirror_file="/etc/pacman.d/mirrorlist-arch"
	[[ "$target_conf" == "/mnt/etc/pacman.conf" ]] && { cmd=( "$chroot" /mnt ); mirror_file="/mnt/etc/pacman.d/mirrorlist-arch"; }
	if [[ ${#cmd[@]} -eq 0 ]]; then rm -rf /etc/pacman.d/gnupg; mkdir -p /etc/pacman.d/gnupg; chmod 700 /etc/pacman.d/gnupg ; pacman-key --init; pacman-key --populate artix
	else "${cmd[@]}" pacman-key --init; "${cmd[@]}" pacman-key --populate artix ; fi
	sed -i '/\[universe\]/,/^[[:space:]]*$/d' "$target_conf"
	printf '\n[universe]\nServer = https://universe.artixlinux.org/$arch\nServer = https://mirror1.artixlinux.org/universe/$arch\nServer = https://mirror.pascalpuffke.de/artix-universe/$arch\nServer = https://artixlinux.qontinuum.space/artixlinux/universe/os/$arch\nServer = https://mirror1.cl.netactuate.com/artix/universe/$arch\nServer = https://ftp.crifo.org/artix-universe/$arch\n' >> "$target_conf"
	[[ ! -f "$mirror_file" ]] && "${cmd[@]}" $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" artix-keyring archlinux-keyring artix-archlinux-support || SHOWerror "Keyrings installation"
	grep -q 'mirrorlist-arch' "$target_conf" || printf '\n# Arch\n[extra]\nInclude = /etc/pacman.d/mirrorlist-arch\n\n[multilib]\nInclude = /etc/pacman.d/mirrorlist-arch\n' >> "$target_conf"
	"${cmd[@]}" pacman-key --populate artix archlinux || SHOWerror "Final pacman-key populate"
}
AutoOSsel () {
	local os_id; [[ -f /etc/os-release ]] && os_id=$(grep -i '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')
	[[ "${os_id,,}" =~ ^(arch|artix|void)$ ]] && OSsel="${os_id^}" || { echo "Automated OS detection failed or unsupported Live OS."; OperatingSystemSel; }
	echo "Detected Live OS: $OSsel"
}
CPUsel () {
	local cpu_info=$(grep -m1 -Ei 'GenuineIntel|AuthenticAMD' /proc/cpuinfo); [[ "$cpu_info" =~ Intel ]] && { echo 'Installing Intel microcode'; microcodepkg='intel-ucode'; }
	[[ "$cpu_info" =~ AMD ]] && { echo 'Installing AMD microcode'; [[ "${OSsel,,}" == "void" ]] && microcodepkg='amd-ucode-firmware' || microcodepkg='amd-ucode'; }
	[[ ! "$cpu_info" =~ (Intel|AMD) ]] && { echo 'No microcode needed or unknown CPU'; microcodepkg=""; }
}
GPUsel () {
	echo "Detecting video chipset..."
	local gpu_info=$(lspci | grep -Ei 'VGA|3D')
	[[ "$gpu_info" =~ (AMD|Radeon) ]] && { [[ "${OSsel,,}" == "void" ]] && amddrivers=(mesa-dri vulkan-loader mesa-vulkan-radeon) || amddrivers=(amdgpu mesa vulkan-radeon libva-mesa-driver); }
	[[ "$gpu_info" =~ (VMware|VirtualBox|Virtio|QXL) ]] && echo "VM detected: The default Mesa driver will be installed"
	[[ "$gpu_info" =~ NVIDIA ]] && [[ "${OSsel,,}" == "void" ]] && { [[ "$LIBsel" == "MUSL" ]] && { nvidiadrivers=(); echo 'MUSL selection detected, forcing Mesa/Nouveau.'; } || { nvidiadrivers=(nvidia nvidia-libs-32bit); MenuSel "GPUMANAGERsel" "Select NVIDIA Optimus Manager" "Native" "Envycontrol" "Cardwire"; echo 'NVIDIA selected'; }; }
	[[ "$gpu_info" =~ NVIDIA ]] && [[ "${OSsel,,}" != "void" ]] && { MenuSel "NVsel" "NVIDIA gpu found, choose driver" "OPEN" "NOUVEAU" "PROPRIETARY" "MESA";
		[[ "$NVsel" =~ (MESA|NOUVEAU) ]] && echo "Using default Mesa/Nouveau"
		[[ "$NVsel" =~ (OPEN|PROPRIETARY) ]] && { local nv_main="nvidia-dkms";
			[[ "$NVsel" == "OPEN" ]] && { [[ "$KSel" == "linux" ]] && nv_main="nvidia-open" || nv_main="nvidia-open-dkms"; }
			[[ "$NVsel" == "PROPRIETARY" ]] && { [[ "$KSel" == "linux" ]] && nv_main="nvidia"; [[ "$KSel" == "linux-lts" ]] && nv_main="nvidia-lts"; }
			nvidiadrivers=("${nv_main}" nvidia-prime nvidia-settings nvidia-utils lib32-nvidia-utils opencl-nvidia lib32-opencl-nvidia libxnvctrl libvdpau); echo "Setting up NVIDIA $NVsel Drivers"; MenuSel "GPUMANAGERsel" "Select NVIDIA Optimus Manager" "Native" "Envycontrol" "Cardwire"; } ; }
	[[ "$gpu_info" =~ NVIDIA ]] && command -v strings >/dev/null && [[ -f /sys/firmware/acpi/tables/DSDT ]] && AcpiOS="$(strings /sys/firmware/acpi/tables/DSDT | grep -i 'windows ' | sort | tail -1)"
	[[ ! "$gpu_info" =~ (AMD|Radeon|VMware|VirtualBox|Virtio|QXL|NVIDIA) ]] && echo "Generic/Intel GPU: Mesa will be installed"
}
LUKSSel () {
	YesNoSel "Do you want to encrypt your system with LUKS (Full Disk Encryption)?"
	if [[ "$CC" -eq 1 ]]; then LUKS_ENC=1
		while true; do
			read -rsp "Enter LUKS passphrase: " LUKS_PASS; echo
			read -rsp "Verify LUKS passphrase: " LUKS_PASS2; echo
			[[ "$LUKS_PASS" == "$LUKS_PASS2" && -n "$LUKS_PASS" ]] && { echo "Passphrase confirmed."; break; } || echo "Passphrases do not match or empty. Try again."
		done
	else LUKS_ENC=0; LUKS_PASS=""; fi
}
Pacman_Locked() {
	[[ -f /var/lib/pacman/db.lck || -f /mnt/var/lib/pacman/db.lck ]] && { echo -e "Pacman is blocked. Removing lockfiles..."; rm -f /var/lib/pacman/db.lck /mnt/var/lib/pacman/db.lck; } || echo "No locked database"
}
PrimaryDriveSel() {
	local avail_disks=(); local display_options=()
	while read -r name size type; do
		[[ "$type" == "loop" || "$type" == "rom" ]] && continue
		avail_disks+=("$name"); display_options+=("$name ($size)")
	done < <(lsblk -dpno NAME,SIZE,TYPE)
	[[ ${#avail_disks[@]} -eq 0 ]] && { echo "No drives detected!"; exit 1; }
	
	while true; do
		echo -e "\n=== Select Target Drive for OS ==="
		for i in "${!display_options[@]}"; do echo "$((i+1))) ${display_options[$i]}"; done
		read -rp "Choice: " choice
		[[ "$choice" =~ ^[0-9]+$ && "$choice" -le "${#display_options[@]}" && "$choice" -gt 0 ]] && { DRIVE="${avail_disks[$((choice-1))]}"; echo "Selected: $DRIVE"; break; } || echo "Invalid choice."
	done
}
TimezoneSel () {
	while true; do
		read -rp $'\n=== Select Timezone ===\nType \'1\' for the default Europe/Rome or write custom format (e.g. America/New_York) [\'q\' to quit]: ' input_val
		[[ -z "$input_val" ]] && { echo "Input cannot be empty."; continue; }
		[[ "$input_val" == "1" ]] && { TZsel="Europe/Rome"; break; }
		[[ "${input_val,,}" =~ ^(q|quit)$ ]] && { TZsel=""; break; }
		YesNoSel "Confirm timezone: $input_val ?"; [[ "$CC" -eq 1 ]] && { TZsel="$input_val"; break; }
	done
	echo "Selected Timezone: $TZsel"
}
UEFIsel () {
	[[ -d "/sys/firmware/efi/" ]] && { mount | grep -q "/sys/firmware/efi/efivars" || mount -t efivarfs efivarfs /sys/firmware/efi/efivars; UEFImode=1; echo 'UEFI Mode detected'; } || { UEFImode=0; echo 'BIOS Mode detected'; }
}
ArchRepoSel()        { YesNoSel "Do you want Arch repositories as well as Artix repositories?"; [[ "$CC" -eq 1 ]] && { ARCHrepo=1; echo "OK, adding Arch repositories!"; } || { ARCHrepo=''; echo "Proceeding without them..."; }; }
BootloaderSel()      { [[ "$UEFImode" -eq 0 ]] && { BLsel="grub"; echo "BIOS mode: GRUB selected automatically"; return 0; }; local bl_options=( "refind" "grub" "efistub" "limine" ); [[ "${OSsel,,}" == "arch" ]] && bl_options+=( "systemd-boot" "uki" ); MenuSel "BLsel" "Select Bootloader" "${bl_options[@]}"; }
DesktopEnvSel()      { MenuSel "DEsel" "Select Desktop Environment / Window Manager" "KDE" "GNOME" "LXQt" "COSMIC" "Hyprland" "Niri" "None"; }
DisplayManagerSel()  { MenuSel "DMsel" "Select Display Manager" "Ly" "Greetd" "SDDM" "GDM" "None"; }
FilesystemSel()      { MenuSel "FSsel" "Select filesystem for ROOT" "ext4" "btrfs"; }
HostnameSel()        { TextPromptSel "HNsel" "Enter preferred hostname"; }
InitSystemSel()      { [[ "${OSsel,,}" == "artix" ]] && MenuSel "INITsel" "Select preferred Init System for Artix" "OpenRC" "Runit" "s6" "dinit" || INITsel="systemd"; }
IRFsel()             { [[ "${OSsel,,}" == "void" ]] && { IRFSetup="dracut"; echo "Selected Initramfs: dracut"; } || MenuSel "IRFSetup" "Select preferred Initramfs Generator" "booster" "mkinitcpio" "dracut"; }
KernelSel()          { [[ "${OSsel,,}" == "void" ]] && MenuSel "KSel" "Select preferred Kernel" "linux" "linux-lts" || MenuSel "KSel" "Select preferred Kernel" "linux" "linux-lts" "linux-hardened" "linux-zen"; }
LibrarySel()         { MenuSel "LIBsel" "Select base library" "GLIBC" "MUSL"; }
LanguageSel()        { MenuSel "LANGsel" "Select preferred Language" "en_US.UTF-8" "en_GB.UTF-8" "it_IT.UTF-8"; }
LocalizationSel()    { MenuSel "LOCsel" "Select localization" "en_US.UTF-8" "en_GB.UTF-8" "it_IT.UTF-8"; }
OperatingSystemSel() { MenuSel "OSsel" "Select the distro to setup" "Arch" "Artix" "Void"; }
PartIDSel()          { MenuSel "PIDsel" "Select partition identifier" "UUID" "PARTUUID" "LABEL"; }
UsernameSel()        { TextPromptSel "UNsel" "Enter preferred username"; }
VoidInstMethod()     { MenuSel "VImethod" "Select installation type" "XBPS" "ROOTFS"; }

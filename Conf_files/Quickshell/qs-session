#!/bin/bash
AUTOLOGIN_USER="__USER__"

if [[ "${1:-}" == "--autologin" || ( "$EUID" -eq 0 && "${1:-}" != "--switch" ) ]]; then
	id "$AUTOLOGIN_USER" >/dev/null 2>&1 || AUTOLOGIN_USER="__USER__"
	exec /bin/login -f "$AUTOLOGIN_USER"
elif [[ "${1:-}" == "--switch" ]]; then
	target_user="${2,,}"
	[[ -n "$target_user" ]] && id "$target_user" >/dev/null 2>&1 || exit 1
	if [[ ! -f "/home/$target_user/.config/quickshell/shell.qml" && -d /etc/skel/.config ]]; then
		mkdir -p "/home/$target_user/.config" "/home/$target_user/Pictures/Screenshots" "/home/$target_user/Videos/Recordings"
		cp -r /etc/skel/.config/* "/home/$target_user/.config/" 2>/dev/null || true
		sed -i "s|/home/[^/\"]*|/home/$target_user|g" "/home/$target_user/.config/quickshell/colors.json" "/home/$target_user/.config/qt6ct/qt6ct.conf" "/home/$target_user/.config/swappy/config" 2>/dev/null || true
		chown -hR "$target_user":users "/home/$target_user" 2>/dev/null || chown -hR "$target_user":"$target_user" "/home/$target_user" 2>/dev/null || true
	fi
	sed -i "s|^AUTOLOGIN_USER=.*|AUTOLOGIN_USER=\"$target_user\"|" /usr/bin/qs-session
	if [[ -f /etc/greetd/config.toml ]]; then sed -i "s|^user = .*|user = \"$target_user\"|" /etc/greetd/config.toml; fi
	if [[ -f /etc/inittab ]]; then sed -i -E "/tty1/ s|^([^#].*agetty[[:space:]]+).*|\1-n -l /usr/bin/qs-session --noclear 38400 tty1 linux|" /etc/inittab; kill -HUP 1 2>/dev/null || true; fi
	if [[ -f /etc/conf.d/agetty.tty1 ]]; then sed -i "/^#*agetty_options=/d; /^#*respawn_delay=/d" /etc/conf.d/agetty.tty1; printf "agetty_options=\"-n -l /usr/bin/qs-session --noclear\"\nrespawn_delay=0\n" >> /etc/conf.d/agetty.tty1; fi
	for rconf in /etc/runit/sv/agetty-tty1/conf /etc/sv/agetty-tty1/conf; do
		if [[ -d "${rconf%/conf}" ]]; then printf "GETTY_ARGS=\"-n -l /usr/bin/qs-session --noclear\"\nBAUD_RATE=38400\nTERM_NAME=linux\n" > "$rconf"; fi
	done
	for dfile in /etc/dinit.d/tty1 /usr/lib/dinit.d/tty1 /etc/dinit.d/agetty-tty1 /usr/lib/dinit.d/agetty-tty1; do
		if [[ -f "$dfile" ]] && ! grep -q "qs-session" "$dfile"; then sed -i -E "s|(agetty[[:space:]]+)|\1-n -l /usr/bin/qs-session |" "$dfile"; fi
	done
	for s6f in /etc/s6/sv/tty1-srv/conf /etc/s6/current/service/tty1-srv/run; do
		if [[ -f "$s6f" ]] && ! grep -q "qs-session" "$s6f"; then sed -i -E "s|^(ARGS=[\"]?)|\1-n -l /usr/bin/qs-session |; s|(agetty[[:space:]]+)|\1-n -l /usr/bin/qs-session |" "$s6f"; fi
	done
	if command -v systemctl >/dev/null 2>&1; then
		mkdir -p /etc/systemd/system/getty@tty1.service.d
		printf "[Service]\nExecStart=\nExecStart=-/sbin/agetty -n -l /usr/bin/qs-session --noclear %%I \$TERM\n" > /etc/systemd/system/getty@tty1.service.d/autologin.conf
	fi
	touch "/tmp/qs_unlocked_$target_user"
	chown "$target_user":users "/tmp/qs_unlocked_$target_user" 2>/dev/null || chown "$target_user":"$target_user" "/tmp/qs_unlocked_$target_user" 2>/dev/null || true
	exit 0
elif [[ "${1:-}" == "--pipewire" ]]; then
	dbus-update-activation-environment --all 2>/dev/null || true
	command -v systemctl >/dev/null 2>&1 && exit 0
	exec 9>"/tmp/pw_start_$UID.lock"
	flock -n 9 || exit 0
	if ! pgrep -u "$UID" -x pipewire >/dev/null; then
		pipewire >/dev/null 2>&1 &
		for _ in {1..40}; do [[ -S "/run/user/$UID/pipewire-0" ]] && break; sleep 0.05; done
	fi
	pgrep -u "$UID" -x wireplumber >/dev/null || wireplumber >/dev/null 2>&1 &
	pgrep -u "$UID" -x pipewire-pulse >/dev/null || pipewire-pulse >/dev/null 2>&1 &
	for _ in {1..40}; do [[ -S "/run/user/$UID/pulse/native" ]] && break; sleep 0.05; done
	exit 0
elif [[ "${1:-}" == "--clipboard" ]]; then
	if command -v spice-vdagent >/dev/null 2>&1 && lspci 2>/dev/null | grep -qiE "Virtio|QXL"; then
		pkill -x spice-vdagent 2>/dev/null
		exec spice-vdagent
	else
		if command -v vmtoolsd >/dev/null 2>&1 && lspci 2>/dev/null | grep -qi "VMware"; then
			pkill -u "$UID" -f "vmtoolsd -n vmusr" 2>/dev/null || true
			for _ in {1..40}; do [[ -n "${DISPLAY:-}" && -S "/tmp/.X11-unix/X${DISPLAY#:}" ]] && break; sleep 0.1; done
			GDK_BACKEND=x11 vmtoolsd -n vmusr >/dev/null 2>&1 &
		elif command -v VBoxClient >/dev/null 2>&1; then
			pkill -x VBoxClient 2>/dev/null || true
			sleep 1
			VBoxClient --clipboard >/dev/null 2>&1 &
		fi
		old_x=""; old_w=""
		while sleep 0.5; do
			pgrep -u "$UID" -x "niri|Hyprland" >/dev/null || exit 0
			x=$(xclip -o -selection clipboard -t UTF8_STRING 2>/dev/null || true)
			w=$(wl-paste -n 2>/dev/null || true)
			if [[ -n "$x" && "$x" != "$old_x" ]]; then
				old_x="$x"; old_w="$x"; printf "%s" "$x" | wl-copy
			elif [[ -n "$w" && "$w" != "$old_w" ]]; then
				old_w="$w"; old_x="$w"; printf "%s" "$w" | xclip -selection clipboard -t UTF8_STRING
			fi
		done
	fi
	exit 0
fi

cleanup_session() {
	rm -f "/tmp/qs_lock_active_$UID" 2>/dev/null || true
	pkill -u "$UID" -x "quickshell|waybar|swaync|hyprpaper|awww-daemon|fuzzel|hypridle|wlsunset|wf-recorder" 2>/dev/null || true
	pkill -u "$UID" -f "[t]heming --daemon|[q]s-session --clipboard" 2>/dev/null || true
	command -v systemctl >/dev/null 2>&1 || pkill -u "$UID" -x "wireplumber|pipewire-pulse|pipewire" 2>/dev/null || true
}
cleanup_session
trap cleanup_session EXIT INT TERM

if [[ ! -f "$HOME/.config/niri/config.kdl" && ! -f "$HOME/.config/hypr/hyprland.conf" && -d /etc/skel/.config ]]; then
	mkdir -p "$HOME/.config" "$HOME/Pictures/Screenshots" "$HOME/Videos/Recordings"
	cp -rn /etc/skel/.config/* "$HOME/.config/" 2>/dev/null || true
	sed -i "s|/home/[^/\"]*|/home/$USER|g" "$HOME/.config/quickshell/colors.json" "$HOME/.config/qt6ct/qt6ct.conf" "$HOME/.config/swappy/config" 2>/dev/null || true
fi

if [[ -f "/tmp/qs_unlocked_$USER" ]]; then
	rm -f "/tmp/qs_unlocked_$USER"
	export QS_START_LOCKED=0
elif [[ "${1:-}" == "--locked" ]]; then
	export QS_START_LOCKED=1
	touch "/tmp/qs_lock_active_$UID"
else
	export QS_START_LOCKED=0
fi

__WM_CMD__

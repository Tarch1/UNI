// ============================================================================
// USER CONFIGURATION & TUNING VARIABLES (NIRI)
// ============================================================================
// 1. Default Window Width:
//    Options: proportion 1.0 (Full width) | proportion 0.5 (Half width)
// 2. Preset Column Widths (cycled with Super + X):
//    Options: proportion 0.5, proportion 0.66667, proportion 1.0
// 3. Window Gaps & Focus Ring:
//    gaps: 8 (Compact) | 16 (Standard) | 24 (Wide)
//    focus-ring width: 1 - 4 pixels
// 4. Animations:
//    workspace-switch: spring damping-ratio=0.15 stiffness=1000 epsilon=0.0001
//    window-open: duration-ms 150, curve "ease-out-expo" | "ease-out-cubic" | "linear"
// ============================================================================

input {
    keyboard {
        xkb {
            layout "it"
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// --- STARTUP PROCESSES ---
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "awww-daemon"
spawn-at-startup "hypridle"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-at-startup "bash" "-c" "~/.config/wallpapers/theme-switcher.sh"

// --- LAYOUT & AESTHETICS ---
layout {
    gaps 16
    center-focused-column "never"

    // Every application starts at 100% width by default
    default-column-width { proportion 1.0; }

    // Super + X cycles between 50% split width and 100% full width
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }

    focus-ring {
        width 2
        active-color "#89b4fa"
        inactive-color "#585b70"
    }

    border {
        off
    }
}

// --- ANIMATIONS ---
animations {
    workspace-switch {
        spring damping-ratio=0.15 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

// --- WINDOW & LAYER RULES ---
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Firefox always opens at 100% width
window-rule {
    match app-id="^firefox$"
    default-column-width { proportion 1.0; }
}

// Floating Calculator (Super + C)
window-rule {
    match app-id="^floating-calc$"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 360; }
}

layer-rule {
    match namespace="^waybar$"
    place-within-backdrop false
}

// --- KEYBINDINGS ---
binds {
    // Core Session & Applications
    Mod+Q           { close-window; }
    Mod+L           { spawn "hyprlock"; }
    Mod+Shift+L     { spawn "bash" "-c" "(command -v quickshell >/dev/null && quickshell ipc call lock lock || hyprlock &) && sleep 0.3 && (loginctl suspend || zzz)"; }
    Mod+E           { spawn "pcmanfm-qt"; }
    Mod+T           { spawn "kitty"; }
    Mod+C           { spawn "kitty" "--class" "floating-calc" "-e" "qalc"; }
    Mod+B           { spawn "firefox"; }
    Mod+Space       { spawn "fuzzel"; }
    Mod+N           { spawn "swaync-client" "-t" "-sw"; }
    Ctrl+Shift+Escape { spawn "kitty" "-e" "btop"; }

    // Window States & Layout
    Mod+F           { fullscreen-window; }
    Mod+Shift+F     { toggle-window-floating; }
    Mod+X           { switch-preset-column-width; }
    Mod+M           { spawn "bash" "-c" "command -v quickshell >/dev/null && quickshell ipc call bar toggle || killall -SIGUSR1 waybar"; }
    Mod+Tab         { toggle-overview; }

    // LIFO Window Hide (Super + H) & Restore (Super + Shift + H)
    Mod+H           { spawn "bash" "-c" "id=$(niri msg -j focused-window 2>/dev/null | awk -F: '/\"id\":/{gsub(/[^0-9]/,\"\",$2); print $2; exit}'); [[ -n \"$id\" ]] && { echo \"$id\" >> /tmp/niri_hidden_$UID; niri msg action move-window-to-workspace --window-id \"$id\" --focus false 99; }"; }
    Mod+Shift+H     { spawn "bash" "-c" "id=$(tail -n 1 /tmp/niri_hidden_$UID 2>/dev/null); ws=$(niri msg -j workspaces 2>/dev/null | awk 'BEGIN{RS=\"}\"}/\"is_focused\":true/{match($0,/\"idx\":[0-9]+/); print substr($0,RSTART+6,RLENGTH-6)}'); if [[ -n \"$id\" && -n \"$ws\" ]]; then sed -i '$d' /tmp/niri_hidden_$UID; niri msg action move-window-to-workspace --window-id \"$id\" \"$ws\"; niri msg action focus-window --id \"$id\"; fi"; }

    // Smart Alt + Tab (Same-App Windows in Workspace -> All Windows in Workspace)
    Alt+Tab         { spawn "bash" "-c" "cur=$(niri msg -j focused-window 2>/dev/null); cid=$(echo \"$cur\" | awk -F: '/\"id\":/{gsub(/[^0-9]/,\"\",$2); print $2; exit}'); capp=$(echo \"$cur\" | awk -F\\\" '/\"app_id\":/{print $4; exit}'); cws=$(echo \"$cur\" | awk -F: '/\"workspace_id\":/{gsub(/[^0-9]/,\"\",$2); print $2; exit}'); next=$(niri msg -j windows 2>/dev/null | awk -v cid=\"$cid\" -v capp=\"$capp\" -v cws=\"$cws\" 'BEGIN{RS=\"}\"}/\"id\":/{match($0,/\"id\": *[0-9]+/); id=substr($0,RSTART+5,RLENGTH-5); gsub(/[^0-9]/,\"\",id); match($0,/\"workspace_id\": *[0-9]+/); ws=substr($0,RSTART+15,RLENGTH-15); gsub(/[^0-9]/,\"\",ws); match($0,/\"app_id\": *\"[^\"]*\"/); app=substr($0,RSTART+10,RLENGTH-11); gsub(/^\"|\"$/,\"\",app); if(ws==cws && id!=\"\"){all[++na]=id; if(app==capp) same[++ns]=id}} END{if(ns>1){for(i=1;i<=ns;i++) if(same[i]==cid){print same[(i%ns)+1]; exit}; print same[1]} else if(na>1){for(i=1;i<=na;i++) if(all[i]==cid){print all[(i%na)+1]; exit}; print all[1]}}'); [[ -n \"$next\" ]] && niri msg action focus-window --id \"$next\""; }

    // Screenshots & Screen Recording
    Mod+S           { spawn "bash" "-c" "grim - | swappy -f -"; }
    Mod+Shift+S     { spawn "bash" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }
    Mod+R           { spawn "bash" "-c" "if pgrep -u $UID -x wf-recorder >/dev/null; then pkill -INT -x wf-recorder && notify-send 'Screen Recorder' 'Saved in ~/Videos/Recordings'; else wf-recorder -f \"$HOME/Videos/Recordings/rec-$(date +%Y%m%d-%H%M%S).mp4\" & notify-send 'Screen Recorder' 'Recording started (No Audio)'; fi"; }
    Mod+Shift+R     { spawn "bash" "-c" "if pgrep -u $UID -x wf-recorder >/dev/null; then pkill -INT -x wf-recorder && notify-send 'Screen Recorder' 'Saved in ~/Videos/Recordings'; else sink=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk -F\\\" '/node.name/{print $2\".monitor\"; exit}'); wf-recorder -a\"${sink:+=$sink}\" -f \"$HOME/Videos/Recordings/rec-$(date +%Y%m%d-%H%M%S).mp4\" & notify-send 'Screen Recorder' 'Recording started (With Audio)'; fi"; }

    // Focus Movement (Super + Arrows)
    Mod+Left        { focus-column-left; }
    Mod+Right       { focus-column-right; }
    Mod+Up          { focus-window-up; }
    Mod+Down        { focus-window-down; }

    // Horizontal Strip Navigation (Alt + Arrows - Repeatable when held)
    Alt+Left        { focus-column-left; }
    Alt+Right       { focus-column-right; }
    Alt+Up          { focus-window-up; }
    Alt+Down        { focus-window-down; }

    // Window Snap / Half-Screen Positioning (Super + Shift + Arrows)
    Mod+Shift+Left  { spawn "sh" "-c" "niri msg action set-column-width 50% && niri msg action move-column-left"; }
    Mod+Shift+Right { spawn "sh" "-c" "niri msg action set-column-width 50% && niri msg action move-column-right"; }
    Mod+Shift+Up    { spawn "sh" "-c" "niri msg action consume-or-expel-window-left && niri msg action move-window-up"; }
    Mod+Shift+Down  { spawn "sh" "-c" "niri msg action consume-or-expel-window-left && niri msg action move-window-down"; }

    // Mouse Wheel Horizontal Window Scroll
    Mod+WheelScrollUp   { focus-column-left; }
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }

    // Workspaces (Vertical in Niri: 1-9 and 0 -> 10)
    Mod+1           { focus-workspace 1; }
    Mod+2           { focus-workspace 2; }
    Mod+3           { focus-workspace 3; }
    Mod+4           { focus-workspace 4; }
    Mod+5           { focus-workspace 5; }
    Mod+6           { focus-workspace 6; }
    Mod+7           { focus-workspace 7; }
    Mod+8           { focus-workspace 8; }
    Mod+9           { focus-workspace 9; }
    Mod+0           { focus-workspace 10; }

    // Move Active Window to Workspace (Super + Shift + [0-9])
    Mod+Shift+1     { move-column-to-workspace 1; }
    Mod+Shift+2     { move-column-to-workspace 2; }
    Mod+Shift+3     { move-column-to-workspace 3; }
    Mod+Shift+4     { move-column-to-workspace 4; }
    Mod+Shift+5     { move-column-to-workspace 5; }
    Mod+Shift+6     { move-column-to-workspace 6; }
    Mod+Shift+7     { move-column-to-workspace 7; }
    Mod+Shift+8     { move-column-to-workspace 8; }
    Mod+Shift+9     { move-column-to-workspace 9; }
    Mod+Shift+0     { move-column-to-workspace 10; }

    // Hardware Media & Brightness Keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp  allow-when-locked=true { spawn "brightnessctl" "s" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "s" "5%-"; }
}

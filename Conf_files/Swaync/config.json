{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"positionX": "center",
	"positionY": "top",
	"layer": "overlay",
	"control-center-layer": "top",
	"layer-shell": true,
	"cssPriority": "application",
	"control-center-margin-top": 15,
	"control-center-margin-bottom": 150,
	"control-center-margin-right": 15,
	"control-center-margin-left": 15,
	"notification-icon-size": 64,
	"notification-body-image-height": 100,
	"notification-body-image-width": 200,
	"timeout": 10,
	"timeout-low": 5,
	"timeout-critical": 0,
	"fit-to-screen": false,
	"control-center-width": 400,
	"control-center-height": 850,
	"notification-window-width": 400,
	"keyboard-shortcuts": true,
	"image-visibility": "when-available",
	"transition-length": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"script-fail-notify": true,
	"widgets": [
		"title",
		"notifications",
		"buttons-grid",
		"mpris",
		"volume",
		"backlight"
	],
	"widget-config": {
		"title": {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": "󰎟 Clear"
		},
		"buttons-grid": {
			"actions": [
				{
					"label": "󰖖",
					"command": "swaync-client -d"
				},
				{
					"label": "󰄄",
					"command": "grim -g \"$(slurp)\" - | swappy -f -"
				},
				{
					"label": "󰍬",
					"command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
				},
				{
					"label": "󰌾",
					"command": "bash -c 'sleep 0.2; hyprlock'"
				},
				{
					"label": "󰐥",
					"command": "bash -c 'sleep 0.2; res=$(echo -e \"󰐥 Poweroff\\n󰑐 Reboot\\n󰤄 Suspend\\n󰒲 Hibernate\\n󰌾 Lock\" | fuzzel -d -p \"Power: \" -l 5); case \"$res\" in *Poweroff) loginctl poweroff;; *Reboot) loginctl reboot;; *Suspend) loginctl suspend;; *Hibernate) loginctl hibernate;; *Lock) hyprlock;; esac'"
				}
			]
		},
		"mpris": {
			"image-size": 96,
			"image-radius": 12
		},
		"volume": {
			"label": "󰕾",
			"show-per-app": true,
			"show-per-app-icon": true,
			"show-per-app-label": true,
			"command": "pavucontrol"
		},
		"backlight": {
			"label": "󰃠"
		}
	}
}

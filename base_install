#!/bin/bash
[[ "$(id -u)" -ne 0 ]] && { echo 'Please run as root.' >&2; exit 1; }
ping -c 1 -W 3 8.8.8.8 &>/dev/null || { echo "Network connection required. Please connect to the internet."; exit 1; }
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec &> >(stdbuf -oL -eL tee -a /tmp/install_$(date +%Y%m%d_%H%M%S).log)
SHOWerror () {
	echo "$1" >> Errors
	YesNoSel "Found an error in $1 would you like to continue the installation?"
	[[ "$CC" -eq 1 ]] && echo "OK, still going, see Errors file in this directory" || { echo "OK, then exit"; exit 1; }
}
Check_required_files () {
	local files=( additional_setup Bootloader/Refind/themes/Blur-theme/theme.conf Bootloader/Grub-Sekiro/{theme.txt,sekiro_1920x1080.png,select_c.png} Bootloader/Grub-Eiffel/{theme.txt,eiffel_tower_under_construction.png,select_c.png} )
	local miss=(); for a in "${files[@]}"; do [[ ! -f "${SCRIPT_DIR}/$a" ]] && miss+=("$a"); done
	[[ ${#miss[@]} -gt 0 ]] && { echo 'Required file(s) missing:' "${miss[@]}"; exit 1; } || source additional_setup
}
DiskPartition () {
	if grep -qs '/mnt' /proc/mounts; then echo "[i] Found active mount point in /mnt. Unmounting..."; umount -R /mnt || SHOWerror "DiskPartition: umount /mnt"; fi
	if [[ $(wc -l < /proc/swaps) -gt 1 ]]; then echo "[i] Found active Swap. Disabling..."; swapoff -a || SHOWerror "DiskPartition: swapoff"; fi
	local mapper_devs=( 'cryptroot' 'cryptswap' 'cryptdata' )
	for dev in "${mapper_devs[@]}"; do [[ -b "/dev/mapper/$dev" ]] && { echo "[i] Found active LUKS volume (/dev/mapper/$dev). Closing..."; cryptsetup close "$dev" || SHOWerror "DiskPartition: cryptsetup close $dev"; }; done
	$PKGmanager$PKGchk ntfs-3g &>/dev/null && $PKGmanager$PKGrmv$PKGfrc "${PKGrsk[@]}" ntfs-3g || true
	$PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${fs[@]}" || SHOWerror "Sync fs utilities"
	local dialog_list=(); while read -r n s; do dialog_list+=("$n" "$s"); done < <(lsblk -dlnp -o NAME,SIZE)
	DRIVE=$(dialog --title "OS INSTALLATION" --stdout --menu "Select preferred drive" 0 0 0 "${dialog_list[@]}")
	[[ -z "$DRIVE" ]] && exit 1
	if [[ "$VBTsel" -eq 0 && "$ADD_SETUP" -eq 1 ]]; then
		local add_dialog_list=(); while read -r n s; do [[ "$n" != "$DRIVE" ]] && add_dialog_list+=("$n" "$s"); done < <(lsblk -dlnp -o NAME,SIZE)
		ADDITIONAL_DRIVE="$(dialog --title "ADDITIONAL" --stdout --menu "Select secondary partition/drive (Optional - Cancel to skip)" 0 0 0 "${add_dialog_list[@]}")"
	fi
	for p in "$DRIVE"?*; do if grep -qs "^$p " /proc/mounts; then echo "[i] Unmounting active partition $p..."; umount "$p" || SHOWerror "DiskPartition: umount $p"; fi; done
	sgdisk -ozZ "$DRIVE" || SHOWerror "Zapping drive partition table"
	local total_ram_gb=$(( ($(free -m | awk '/^Mem:/{print $2}') + 1023) / 1024 )) swap_gb
	[[ "$total_ram_gb" -le 8 ]] && swap_gb=$(( total_ram_gb + 1 )) || { [[ "$total_ram_gb" -le 32 ]] && swap_gb=$total_ram_gb || swap_gb=32; }
	parted -sf "$DRIVE" -- mktable gpt mkpart "ESP" fat32 1MiB 513MiB mkpart "LINUX-ROOT" 513MiB -"${swap_gb}GiB" mkpart "SWAP" -"${swap_gb}GiB" 100% set 1 esp on set 3 swap on || SHOWerror "Parted GPT execution"
	udevadm settle || sleep 1
	local p=""; [[ "$DRIVE" =~ [0-9]$ ]] && p="p"; BOOT_PART="${DRIVE}${p}1"; ROOT_PART="${DRIVE}${p}2"; SWAP_PART="${DRIVE}${p}3"
	DEVICE="${DRIVE##*/}"; echo "DRIVE=$DRIVE DEVICE=$DEVICE"
	[[ -z "$DRIVE" || -z "$DEVICE" ]] && { echo "No partition were created, check the installer. Closing installation!"; exit 1; } || echo 'We can proceed with the formatting of file system'
	sleep 1; echo -e " BP=$BOOT_PART RP=$ROOT_PART PID=$PIDsel"; lsblk -f
}
FileSystemFormat () {
	BootLabel='EFI'; RootLabel='ROOT'; mkfs.fat -F32 -n "$BootLabel" "$BOOT_PART" || SHOWerror "mkfs.fat EFI"
	BOOTID="$(blkid -s "$PIDsel" -o value "$BOOT_PART")" || SHOWerror "blkid BOOTID"
	if [[ "$LUKS_ENC" -eq 1 ]]; then
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$ROOT_PART" -d - || SHOWerror "LUKS ROOT format"
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$ROOT_PART" cryptroot -d - || SHOWerror "LUKS ROOT open"
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$SWAP_PART" -d - || SHOWerror "LUKS SWAP format"
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$SWAP_PART" cryptswap -d - || SHOWerror "LUKS SWAP open"
		TARGET_ROOT="/dev/mapper/cryptroot"; TARGET_SWAP="/dev/mapper/cryptswap"
		CRYPT_ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"; CRYPT_SWAP_UUID="$(blkid -s UUID -o value "$SWAP_PART")"
	else TARGET_ROOT="$ROOT_PART"; TARGET_SWAP="$SWAP_PART"; fi
	mkswap "$TARGET_SWAP" || SHOWerror "mkswap"; SWAPID="$(blkid -s "$PIDsel" -o value "$TARGET_SWAP")" || SHOWerror "blkid SWAPID"
	UNIfstab="$PIDsel=$BOOTID /boot vfat defaults 0 2\n$PIDsel=$SWAPID none swap defaults 0 0\n"
	case "$FSsel" in
		ext4)	mkfs.ext4 -L "$RootLabel" "$TARGET_ROOT" || SHOWerror "mkfs.ext4 ROOT"; ROOTID="$(blkid -s "$PIDsel" -o value "$TARGET_ROOT")" || SHOWerror "blkid ROOTID ext4"
				mount "$TARGET_ROOT" /mnt || SHOWerror "mount ext4 root"; UNIfstab+="$PIDsel=$ROOTID / ext4 defaults 0 1\n" ;;
		btrfs)	modules=(btrfs); binaries='btrfs'; local SUBVolumes=( 'home' 'var_log' 'var_cache' 'snapshots' ); local options='noatime,compress=zstd,space_cache=v2,discard=async'
				mkfs.btrfs -fL "$RootLabel" "$TARGET_ROOT" || SHOWerror "mkfs.btrfs ROOT"; ROOTID="$(blkid -s "$PIDsel" -o value "$TARGET_ROOT")" || SHOWerror "blkid ROOTID btrfs"
				mkdir -p /tmp/btrpool; mount "$TARGET_ROOT" /tmp/btrpool || SHOWerror "mount btrfs pool"
				btrfs su cr /tmp/btrpool/@ || SHOWerror "btrfs subvol @"; mount -o defaults,"$options",subvol=@ "$TARGET_ROOT" /mnt || SHOWerror "mount btrfs root"
				UNIfstab+="$PIDsel=$ROOTID / btrfs $options,subvol=@ 0 0\n"
				for c in "${SUBVolumes[@]}"; do
					btrfs su cr /tmp/btrpool/@"$c" || SHOWerror "btrfs subvol @$c"
					local d_path="/$c"; [[ "$c" == "snapshots" ]] && d_path="/.$c"; [[ "$c" == "var_log" ]] && d_path="/var/log"; [[ "$c" == "var_cache" ]] && d_path="/var/cache"
					mkdir -p "/mnt$d_path" && mount -o defaults,"$options",subvol=@"$c" "$TARGET_ROOT" "/mnt$d_path" || SHOWerror "mount @$c"
					UNIfstab+="$PIDsel=$ROOTID $d_path btrfs $options,subvol=@$c 0 0\n"
				done ; umount /tmp/btrpool && rmdir /tmp/btrpool ;;
		*) 		SHOWerror "Unsupported file system selection" ;;
	esac
	export BOOTID ROOTID SWAPID TARGET_ROOT TARGET_SWAP CRYPT_ROOT_UUID CRYPT_SWAP_UUID
	swapon "$TARGET_SWAP" || SHOWerror "swapon"; mkdir -p /mnt/boot; mount "$BOOT_PART" /mnt/boot || SHOWerror "mount boot partition"; lsblk -f
}
AdditionalDriveSetup () {
	[[ "$ADD_SETUP" -ne 1 || -z "$ADDITIONAL_DRIVE" || "$ADDITIONAL_DRIVE" == "$DRIVE" ]] && return 0
	local TARGET_ADD="$ADDITIONAL_DRIVE"
	if [[ "$LUKS_ENC" -eq 1 && "$ADD_FORMAT" -eq 1 ]]; then
		echo -n "$LUKS_PASS" | cryptsetup luksFormat --type luks2 -q "$ADDITIONAL_DRIVE" -d - || SHOWerror "LUKS ADD format"
		echo -n "$LUKS_PASS" | cryptsetup luksOpen "$ADDITIONAL_DRIVE" cryptdata -d - || SHOWerror "LUKS ADD open"
		TARGET_ADD="/dev/mapper/cryptdata"; CRYPT_ADD_UUID="$(blkid -s UUID -o value "$ADDITIONAL_DRIVE")"; export CRYPT_ADD_UUID
	elif [[ "$LUKS_ENC" -eq 1 ]]; then TARGET_ADD="/dev/mapper/cryptdata"; fi
	[[ "$ADD_FORMAT" -eq 1 ]] && {
		[[ ! "$ADD_FS" =~ ^(ext4|btrfs|exfat|ntfs)$ ]] && echo "Unsupported filesystem for additional drive: $ADD_FS" || {
			local flags=(-f -L); [[ "$ADD_FS" == "ext4" ]] && flags=(-F -L); [[ "$ADD_FS" == "exfat" ]] && flags=(-n)
			mkfs."$ADD_FS" "${flags[@]}" "$ADD_LABEL" "$TARGET_ADD" || SHOWerror "mkfs.$ADD_FS additional drive"; } ; }
	mkdir -p /mnt/media/HDD && mount "$TARGET_ADD" /mnt/media/HDD || SHOWerror "Mount additional drive"
	UNIfstab+="$PIDsel=$(blkid -s $PIDsel -o value $TARGET_ADD || echo $TARGET_ADD) /media/HDD $(blkid -s TYPE -o value $TARGET_ADD || echo auto) defaults,noatime 0 2\n"
}
ArchTixSystemInstall () {
	local BasePKG=( "${kernel[@]}" "${baselinux[@]}" "${elogind[@]}" )
	[[ "$FSsel" == "btrfs" ]] && BasePKG+=( "${btrfsutility[@]}" )
	"$PKGstrap" /mnt "$microcodepkg" "${BasePKG[@]}" || SHOWerror "Arch/Artix strap base installation"
	[[ -f /mnt/etc/pacman.conf ]] && sed -i 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' /mnt/etc/pacman.conf || true
}
VoidSystemInstall () {
	local void_repo="https://voidlinux.org"
	[[ "${LIBsel}" == "MUSL" ]] && void_repo="${void_repo}/musl"
	[[ "${VImethod}" == "XBPS" ]] && { mkdir -p /mnt/var/db/xbps/keys && cp -r /var/db/xbps/keys/* /mnt/var/db/xbps/keys/ || true; $PKGstrap base-system || SHOWerror "XBPS base-system bootstrap" ; }
	[[ "${VImethod}" == "ROOTFS" ]] && { local tarball="void-x86_64-ROOTFS.tar.xz"; [[ "${LIBsel}" == "MUSL" ]] && tarball="void-x86_64-musl-ROOTFS.tar.xz";
				if [ -f "${SCRIPT_DIR}/Conf_files/${tarball}" ]; then tar -xJf "${SCRIPT_DIR}/Conf_files/${tarball}" -C /mnt || SHOWerror "ROOTFS extraction"
				else curl -Lo "/tmp/${tarball}" "${void_repo}/static/${tarball}" || SHOWerror "ROOTFS download"; tar -xJf "/tmp/${tarball}" -C /mnt && rm -f "/tmp/${tarball}" || SHOWerror "ROOTFS downloaded extraction"; fi ; }
	for d in dev proc sys run; do mkdir -p /mnt/$d && mount --bind /$d /mnt/$d || SHOWerror "Mounting /$d filesystem"; done
	mount --make-rslave /mnt/sys || SHOWerror "Setting sys rslave"
	[[ "$UEFImode" -eq 1 ]] && { mkdir -p /mnt/sys/firmware/efi/efivars; mount --bind /sys/firmware/efi/efivars /mnt/sys/firmware/efi/efivars || SHOWerror "Mounting efivars filesystem"; } || true
}
CrypttabGen () {
	[[ "$LUKS_ENC" -ne 1 ]] && return 0
	echo -n "$LUKS_PASS" > /mnt/etc/crypt_key.bin; chmod 600 /mnt/etc/crypt_key.bin
	echo -n "$LUKS_PASS" | cryptsetup luksAddKey -q "$SWAP_PART" /mnt/etc/crypt_key.bin -d - || SHOWerror "LUKS AddKey SWAP"
	echo "cryptswap UUID=$CRYPT_SWAP_UUID /etc/crypt_key.bin luks" > /mnt/etc/crypttab
	[[ -n "$CRYPT_ADD_UUID" ]] && { echo -n "$LUKS_PASS" | cryptsetup luksAddKey -q "$ADDITIONAL_DRIVE" /mnt/etc/crypt_key.bin -d - || SHOWerror "LUKS AddKey ADD"; echo "cryptdata UUID=$CRYPT_ADD_UUID /etc/crypt_key.bin luks" >> /mnt/etc/crypttab; } || true
}
FStabGen () {
	[[ -f /mnt/etc/fstab ]] && { mv -f /mnt/etc/fstab /mnt/etc/old-fstab || SHOWerror "Backup existing fstab"; }
	if [[ "${OSsel,,}" == "void" ]]; then echo -e "$UNIfstab" > /mnt/etc/fstab || SHOWerror "Writing Void native fstab"
	elif [[ -v PIDsel ]]; then "$FSTABgen" -t "$PIDsel" /mnt >> /mnt/etc/fstab || SHOWerror "Generating Arch/Artix fstab"
	else SHOWerror "PIDsel variable missing during fstab generation"; fi
	cat /mnt/etc/fstab
}
SetupEnvironment () {
	local keymap_val="${keylayout:-KEYMAP=it}"
	[[ "$keymap_val" != KEYMAP=* ]] && keymap_val="KEYMAP=$keymap_val"
	[[ "${OSsel,,}" == "void" ]] && { echo "LANG=$LOCsel" > /mnt/etc/locale.conf; echo "$keymap_val" > /mnt/etc/vconsole.conf; echo 'HARDWARECLOCK="UTC"' >> /mnt/etc/rc.conf; "$chroot" /mnt ln -sf /usr/share/zoneinfo/"$TZsel" /etc/localtime ; }
	[[ "${OSsel,,}" != "void" ]] && { sed -i "/\($LOCsel\|$LANGsel\)/ s/#//g" /mnt/etc/locale.gen; echo -e "LANG=$LOCsel\nLANGUAGE=$LANGsel\nLC_TIME=$LOCsel\nLC_ADDRESS=$LOCsel\nLC_MESSAGES=$LOCsel\nLC_CTYPE=C" >> /mnt/etc/locale.conf;
		echo "$keymap_val" > /mnt/etc/vconsole.conf; [[ -n "$keypath" ]] && echo "$keymap_val" > /mnt/"$keypath"; "$chroot" /mnt bash -c "ln -sf /usr/share/zoneinfo/$TZsel /etc/localtime; hwclock --systohc --utc || true; locale-gen" ; }
	echo "$HNsel" > /mnt/etc/hostname
	echo -e "127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t$HNsel.localdomain\t$HNsel" >> /mnt/etc/hosts
}
PackageConfig () {
	[[ "${OSsel,,}" == "void" ]] && { local v_repos=(void-repo-nonfree); [[ "$LIBsel" == "GLIBC" ]] && v_repos+=(void-repo-multilib void-repo-multilib-nonfree); "$chroot" /mnt $PKGmanager$PKGinst "${PKGskp[@]}" xbps-allow-references "${v_repos[@]}"; }
	[[ "${OSsel,,}" == "arch" ]] && sed -i '/\[multilib]/,/mirrorlist/ s/#//' /mnt/etc/pacman.conf
	[[ "${OSsel,,}" == "artix" ]] && { sed -i '/\[lib32]/,/mirrorlist/ s/#//' /mnt/etc/pacman.conf; [[ "$ARCHrepo" == "1" ]] && ArchRepoSetup /mnt/etc/pacman.conf; }
	[[ -f /mnt/etc/pacman.conf ]] && sed -i -e '/\(Color\|ParallelDownloads\)/ s/#//' -e '/ParallelDownloads/a ILoveCandy' /mnt/etc/pacman.conf
	"$chroot" /mnt $PKGmanager$PKGinst$PKGupd
}
PackageInstall () {
	local VBTboot=(); [[ "${BLsel,,}" =~ ^(efistub|limine|systemd-boot|uki)$ ]] && VBTboot+=(efibootmgr); [[ "${BLsel,,}" == "grub" ]] && VBTboot+=(grub); [[ "${BLsel,,}" == "refind" ]] && VBTboot+=(refind); [[ "${BLsel,,}" == "limine" ]] && VBTboot+=(limine); [[ "${BLsel,,}" == "uki" ]] && VBTboot+=(systemd-ukify); [[ "$FSsel" == "btrfs" ]] && VBTboot+=(btrfs-progs)
	if [[ "$VBTsel" -eq 1 ]]; then [[ "${OSsel,,}" == "void" ]] && "$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${VBTboot[@]}" || "$chroot" /mnt $PKGmanager$PKGinst$PKGupd"u" "${PKGskp[@]}" "${baselinux[@]}" "${baseutils[@]}" "${elogind[@]}" "${net[@]}" "${bluetooth[@]}" "${print[@]}" "${VBTboot[@]}" "${desktoppkg[@]}" "${displaymanagerpkg[@]}"
	else    local FullPKGs=( "${microcode[@]}" "${kernel[@]}" "${baseutils[@]}" "${fs[@]}" "${bootloaderutility[@]}" "${btrfsutility[@]}" "${grubpkg[@]}" "${refindpkg[@]}" "${liminepkg[@]}" "${ukipkg[@]}" "${net[@]}" "${audio[@]}" "${bluetooth[@]}" "${print[@]}" "${apps[@]}" "${utility[@]}" "${hardwareacceleration[@]}" "${vulkan[@]}" "${filemanager[@]}" "${archive[@]}" "${desktoppkg[@]}" "${displaymanagerpkg[@]}" )
			[[ ${#nvidiadrivers[@]} -gt 0 ]] && FullPKGs+=( "${nvidiadrivers[@]}" )
			[[ -v amddrivers && ${#amddrivers[@]} -gt 0 ]] && FullPKGs+=( "${amddrivers[@]}" )
			[[ "${OSsel,,}" == "void" ]] || FullPKGs+=( "${baselinux[@]}" "${elogind[@]}" "${grubbtrfs[@]}" )
			[[ "${OSsel,,}" == "void" ]] && "$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${FullPKGs[@]}" || "$chroot" /mnt $PKGmanager$PKGinst$PKGupd"u" "${PKGskp[@]}" "${FullPKGs[@]}"
	fi
}
PKGcheck () {
	echo "Initializing package groups..."
	microcode=(); [[ -n "$microcodepkg" ]] && microcode=("$microcodepkg")
	grubpkg=(); [[ "${BLsel,,}" == "grub" ]] && grubpkg=(grub)
	refindpkg=(); [[ "${BLsel,,}" == "refind" ]] && refindpkg=(refind)
	liminepkg=(); [[ "${BLsel,,}" == "limine" ]] && liminepkg=(limine)
	ukipkg=(); [[ "${BLsel,,}" == "uki" ]] && ukipkg=(systemd-ukify)
	btrfsutility=(); grubbtrfs=(); [[ "$FSsel" == "btrfs" ]] && { btrfsutility=(snapper btrfs-progs); [[ "${OSsel,,}" != "void" ]] && grubbtrfs=(grub-btrfs); }
	booster=(); [[ "${OSsel,,}" != "void" ]] && booster=(booster)
	[[ ! -v nvidiadrivers ]] && nvidiadrivers=(); [[ ! -v amddrivers ]] && amddrivers=()
	[[ "${OSsel,,}" == "void" ]] && { local v_live_repos=(void-repo-nonfree); [[ "$LIBsel" == "GLIBC" ]] && v_live_repos+=(void-repo-multilib void-repo-multilib-nonfree); $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${v_live_repos[@]}" || true; }
	desktoppkg=(); [[ "$DEsel" == "KDE" ]] && desktoppkg=(plasma-meta dolphin konsole xdg-desktop-portal-kde)
	[[ "$DEsel" == "GNOME" ]] && desktoppkg=(gnome gnome-tweaks xdg-desktop-portal-gnome)
	[[ "$DEsel" == "LXQt" ]] && desktoppkg=(lxqt xdg-desktop-portal-lxqt)
	[[ "$DEsel" == "COSMIC" ]] && desktoppkg=(cosmic xdg-desktop-portal-cosmic)
	[[ "$DEsel" == "Hyprland" ]] && desktoppkg=(hyprland fuzzel waybar swaync hyprlock hypridle polkit-kde-agent xdg-desktop-portal-hyprland xdg-desktop-portal-gtk)
	[[ "$DEsel" == "Niri" ]] && desktoppkg=(niri fuzzel waybar swaync hyprlock hypridle polkit-kde-agent xdg-desktop-portal-gnome xdg-desktop-portal-gtk)
	displaymanagerpkg=(); [[ "${DMsel,,}" == "ly" ]] && displaymanagerpkg=(ly); [[ "${DMsel,,}" == "greetd" ]] && displaymanagerpkg=(greetd tuigreet); [[ "${DMsel,,}" == "sddm" ]] && displaymanagerpkg=(sddm); [[ "${DMsel,,}" == "gdm" ]] && displaymanagerpkg=(gdm)
	kernel=("${KSel}" "${KSel}-headers"); [[ "${OSsel,,}" == "void" ]] && kernel+=(linux-firmware-network) || kernel+=(linux-firmware)
	baselinux=(base-devel); [[ "${OSsel,,}" == "void" ]] && baselinux+=(base-system) || baselinux+=(base)
	baseutils=(bash-completion vim nano wget git binutils cryptsetup); [[ "${OSsel,,}" == "void" ]] && baseutils+=(man-pages) || baseutils+=(man-db)
	net=(iwd chrony); [[ "${OSsel,,}" == "void" ]] && net+=(NetworkManager) || net+=(networkmanager)
	bluetooth=(bluez); [[ "${OSsel,,}" != "void" ]] && bluetooth+=(bluez-utils bluetui blueman)
	print=(cups cups-pdf avahi); [[ "${OSsel,,}" == "void" ]] && print+=(cups-filters) || print+=(system-config-printer)
	audio=(pipewire wireplumber); [[ "${OSsel,,}" != "void" ]] && audio+=(pipewire-pulse pipewire-alsa pipewire-jack sof-firmware)
	fs=(dialog mtools parted gptfdisk dosfstools ntfsprogs)
	archive=(bzip2 cpio gzip xz 7zip tar unrar zip unzip zstd)
	utility=(imv featherpad libqalculate fd btop fwupd); [[ "${OSsel,,}" != "void" ]] && utility+=(lact cowfortune)
	if ls /sys/class/power_supply/BAT* &>/dev/null; then [[ "${OSsel,,}" == "arch" ]] && utility+=(power-profiles-daemon) || utility+=(tlp); [[ "$microcodepkg" == "intel-ucode" ]] && utility+=(thermald); fi
	[[ "${GPUMANAGERsel,,}" == "envycontrol" ]] && utility+=(envycontrol)
	[[ "${GPUMANAGERsel,,}" == "cardwire" ]] && utility+=(cardwire)
	apps=(kitty telegram-desktop firefox); [[ "${OSsel,,}" != "void" ]] && apps+=(profile-sync-daemon)
	bootloaderutility=(efibootmgr os-prober); [[ "${OSsel,,}" != "void" ]] && bootloaderutility+=(sbsigntools)
	[[ "${OSsel,,}" == "void" ]] && hardwareacceleration=(mesa-dri mesa-vaapi mesa-vulkan-radeon) || hardwareacceleration=(intel-media-driver vkd3d)
	[[ "${OSsel,,}" == "void" ]] && vulkan=(vulkan-loader) || vulkan=(vulkan-icd-loader vulkan-intel vulkan-mesa-layers)
	filemanager=(yazi pcmanfm tumbler file-roller android-tools); [[ "${OSsel,,}" != "void" ]] && filemanager+=(gvfs-mtp)
	elogind=(); [[ "${OSsel,,}" == "artix" ]] && { local init_s="${init_sys,,}"; elogind=(elogind elogind-"$init_s" "${init_s}"-settingsd); net+=("chrony-${init_s}" "networkmanager-${init_s}"); bluetooth+=("bluez-${init_s}" bluez-cups); print+=("avahi-${init_s}" "cups-${init_s}"); }
	echo "Downloading remote package indexes..."; local remote_repo_list="/tmp/remote_pkgs.list"
	[[ "${OSsel,,}" == "void" ]] && $PKGmanager$PKGchk -R -s "" | awk '{print $2}' | sed 's/-[0-9].*//' | sort -u > "$remote_repo_list" || $PKGmanager$PKGinst$PKGupd"lq" | sort -u > "$remote_repo_list"
	local y="microcode amddrivers nvidiadrivers kernel baselinux baseutils fs bootloaderutility btrfsutility elogind grubpkg grubbtrfs refindpkg liminepkg ukipkg net audio bluetooth print apps utility hardwareacceleration vulkan filemanager archive booster desktoppkg displaymanagerpkg" miss=()
	for group in $y; do
		local -n current_group="$group"; local valid_pkgs=()
		for pkg in "${current_group[@]}"; do grep -qx "$pkg" "$remote_repo_list" && valid_pkgs+=("$pkg") || miss+=("$pkg"); done
		current_group=("${valid_pkgs[@]}")
	done
	rm -f "$remote_repo_list"
	if [[ ${#miss[@]} -gt 0 ]]; then
		echo -e "\n[!] WARNING: Unavailable packages:\n$(printf ' - %s\n' "${miss[@]}" | sort -u)\n"; printf '%s\n' "${miss[@]}" | sort -u > pkg_missed
		YesNoSel "Are these packages CRITICAL for installation? (Yes = Abort / No = Skip and continue)"
		[[ "$CC" -eq 1 ]] && { echo "[-] Installation aborted by user."; exit 0; } || echo "[*] Missing packages removed."
	fi
}
KernelSetup () {
	[[ "$microcodepkg" == "intel-ucode" ]] && { mkdir -p /mnt/etc/modprobe.d && echo 'options i915 enable_fbc=1 fastboot=0 enable_dc=4' > /mnt/etc/modprobe.d/i915.conf || SHOWerror "i915 modprobe options"; }
	if [[ ${#nvidiadrivers[@]} -gt 0 ]]; then
		[[ "${OSsel,,}" == "artix" ]] && { "$chroot" /mnt $PKGmanager$PKGinst$PKGupd"u" "${PKGskp[@]}" nvidia-utils-openrc || SHOWerror "artix nvidia-utils-openrc"; }
		ln -s /dev/null /mnt/etc/udev/rules.d/61-gdm.rules || SHOWerror "61-gdm udev rule link"; modules+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
		echo -e "options nvidia-drm modeset=1 fbdev=1\noptions nvidia NVreg_DynamicPowerManagement=0x02 NVreg_UsePageAttributeTable=1 NVreg_EnablePCIeGen3=1" > /mnt/etc/modprobe.d/nvidia.conf || SHOWerror "nvidia modprobe options"
	fi
	case "$IRFSetup" in
		dracut)		mkdir -p /mnt/etc/dracut.conf.d || SHOWerror "mkdir dracut.conf.d"
					[[ "$LUKS_ENC" -eq 1 ]] && echo -e 'add_dracutmodules+=" crypt "\ninstall_items+=" /etc/crypttab /etc/crypt_key.bin "' > /mnt/etc/dracut.conf.d/crypt.conf
					[[ "${OSsel,,}" == "void" ]] && { "$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" dracut || SHOWerror "Void dracut install"; }
					[[ "$FSsel" == "btrfs" ]] && echo 'add_dracutmodules+=" btrfs "' > /mnt/etc/dracut.conf.d/btrfs.conf
					[[ ${#nvidiadrivers[@]} -gt 0 ]] && echo 'force_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "' > /mnt/etc/dracut.conf.d/nvidia.conf
					if [[ "${OSsel,,}" == "void" ]]; then "$chroot" /mnt xbps-reconfigure -f "$KSel" || SHOWerror "xbps-reconfigure dracut"
					else local r_kver; r_kver="$(basename "$(find /mnt/usr/lib/modules/ -maxdepth 1 -mindepth 1 -type d | head -n 1)")"; "$chroot" /mnt dracut --kver "$r_kver" --force /boot/initramfs-"$KSel".img || SHOWerror "dracut build"; fi ;;
		booster)	[[ ${#booster[@]} -gt 0 ]] && { "$chroot" /mnt $PKGmanager$PKGinst$PKGupd"u" "${PKGskp[@]}" "${booster[@]}" || SHOWerror "install booster"; }
					[[ "${OSsel,,}" != "void" ]] && { "$chroot" /mnt $PKGmanager$PKGrmv"n"$PKGdpn "${PKGrsk[@]}" mkinitcpio || SHOWerror "purge mkinitcpio"; }
					local b_opts="mount_timeout: 3m\nvconsole: true\nresume: /dev/disk/by-uuid/${SWAPID}\nmodules: ahci,ata_piix,sd_mod,nvme"
					[[ "$FSsel" == "btrfs" ]] && b_opts="${b_opts},btrfs"
					[[ ${#nvidiadrivers[@]} -gt 0 ]] && b_opts="${b_opts},nvidia,nvidia_modeset,nvidia_uvm,nvidia_drm"
					echo -e "$b_opts" > /mnt/etc/booster.yaml || SHOWerror "booster.yaml write"
					if [[ "${OSsel,,}" != "void" ]]; then
						mkdir -p /mnt/etc/pacman.d/hooks || SHOWerror "mkdir pacman hooks"
						printf '[Trigger]\nOperation = Install\nOperation = Upgrade\nType = Package\nTarget = %s\n\n[Action]\nDescription = Forcing Booster initramfs update...\nWhen = PostTransaction\nDepends = booster\nExec = /usr/bin/booster build --force --universal /boot/initramfs-%s.img\n' "$KSel" "$KSel" > /mnt/etc/pacman.d/hooks/95-booster-force.hook || SHOWerror "booster-force hook creation"
					fi
					local real_kver; real_kver=$(basename "$(find /mnt/usr/lib/modules/ -maxdepth 1 -mindepth 1 -type d ! -name 'extramodules*' | head -n 1)") || SHOWerror "find real_kver"
					"$chroot" /mnt /bin/bash -c "booster build --force --universal --kernel-version=${real_kver} /boot/initramfs-${KSel}.img" || SHOWerror "booster build" ;;
		*)			local HOOKS=(base udev autodetect keyboard keymap modconf block); [[ "$LUKS_ENC" -eq 1 ]] && HOOKS+=(encrypt); HOOKS+=(resume filesystems fsck); [[ ${#nvidiadrivers[@]} -gt 0 ]] && HOOKS+=(kms)
					sed -i -e "/MODULES/ s/()/(${modules[*]})/" -e "/BINARIES/ s/()/($binaries)/" -e "s/^HOOKS.*/HOOKS=(${HOOKS[*]})/" /mnt/etc/mkinitcpio.conf || SHOWerror "mkinitcpio config inject"
					"$chroot" /mnt mkinitcpio -p "$KSel" || SHOWerror "mkinitcpio build" ;;
	esac
}

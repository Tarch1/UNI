BootloaderSetup () {
	local osi_version="${AcpiOS:-Windows 2020}"; local kname; kname=$(basename "$(find /mnt/boot/ -type f -name 'vmlinuz-*' | head -n 1)") || kname="vmlinuz-$KSel"
	local irfs initrd_flags rootflags="" nvdrm="" nvosi="" luks_flags=""
	[[ "${OSsel,,}" == "void" ]] && irfs="initramfs-${kname#vmlinuz-}.img" || irfs="initramfs-$KSel.img"
	[[ "$FSsel" == "btrfs" ]] && rootflags='rootflags=subvol=@'
	[[ ${#nvidiadrivers[@]} -gt 0 ]] && { nvdrm="nvidia-drm.modeset=1 nvidia-drm.fbdev=1"; nvosi="acpi_osi=\"$osi_version\""; }
	[[ "${GPUMANAGERsel,,}" == "cardwire" ]] && nvosi="$nvosi lsm=lockdown,capability,landlock,bpf"
	[[ -n "$microcodepkg" && -f "/mnt/boot/${microcodepkg}.img" ]] && initrd_flags="initrd=\\${microcodepkg}.img initrd=\\${irfs}" || initrd_flags="initrd=\\${irfs}"
	[[ "$LUKS_ENC" -eq 1 ]] && luks_flags="cryptdevice=UUID=${CRYPT_ROOT_UUID}:cryptroot rd.luks.uuid=${CRYPT_ROOT_UUID} rd.luks.name=${CRYPT_ROOT_UUID}=cryptroot root=/dev/mapper/cryptroot" || luks_flags="root=${PIDsel}=$ROOTID"
	
	case "${BLsel,,}" in
		refind)
			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${refindpkg[@]}" || SHOWerror "rEFInd package install"
			"$chroot" /mnt refind-install || SHOWerror "rEFInd execution"; [[ "$UEFImode" -eq 1 ]] && efifolder='refind' || efifolder='BOOT'
			mkdir -p /mnt/boot/EFI/"$efifolder"/themes || SHOWerror "mkdir rEFInd themes"
			cp -r "${SCRIPT_DIR}/Bootloader/Refind/themes/"* /mnt/boot/EFI/"$efifolder"/themes/ || SHOWerror "Copy rEFInd themes"
			local ref_res="max"; [[ "$VBTsel" -eq 1 ]] && ref_res="1024 768"
			echo -e "timeout 3\nshowtools shell, gdisk, apple_recovery, windows_recovery, mok_tool, bootorder, firmware, shutdown\nenable_mouse\nalso_scan_dirs +,@/boot\nscanfor internal,external,optical,manual,firmware\nextra_kernel_version_strings linux-hardened,linux-rt-lts,linux-zen,linux-lts,linux-rt,linux\ninclude themes/Blur-theme/theme.conf\nresolution $ref_res" >> /mnt/boot/EFI/"$efifolder"/refind.conf
			local rl_flags="rw $luks_flags resume=${PIDsel}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi"
			echo -e "\"Boot Standard\"\t\"$rl_flags $initrd_flags\"\n\"Boot Terminal\"\t\"$rl_flags $initrd_flags systemd.unit=multi-user.target\"" > /mnt/boot/refind_linux.conf || SHOWerror "Write refind_linux.conf"
			echo '!!!Refind config and theme changed!!!' ;;
		grub)
			[[ "$FSsel" == "btrfs" ]] && grubpkg+=("${grubbtrfs[@]}")
			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${grubpkg[@]}" || SHOWerror "GRUB package install"
			[[ "$UEFImode" -eq 0 ]] && "$chroot" /mnt grub-install --target=i386-pc --recheck --debug "$DRIVE" || "$chroot" /mnt grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB || SHOWerror "GRUB install"
			local g_theme="Grub-Sekiro"
			mkdir -p /mnt/boot/grub/themes /mnt/usr/share/grub/themes/ || SHOWerror "mkdir GRUB themes"
			cp -r "${SCRIPT_DIR}/Bootloader/$g_theme" /mnt/boot/grub/themes/ && cp -r "${SCRIPT_DIR}/Bootloader/$g_theme" /mnt/usr/share/grub/themes/ || SHOWerror "Copy GRUB theme"
			local g_res="1920x1080,1024x768,auto"; [[ "$VBTsel" -eq 1 ]] && g_res="1024x768,auto"
			sed -i -e "/GRUB_DISABLE_OS_PROBER=/ s/#//g" -e "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/" -e "s/^#GRUB_GFXMODE=.*/GRUB_GFXMODE=$g_res/" -e '/GRUB_THEME=/c GRUB_THEME="/boot/grub/themes/'"$g_theme"'/theme.txt"' -e "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$nvosi $luks_flags\"|" /mnt/etc/default/grub
			[[ ${#nvidiadrivers[@]} -gt 0 ]] && sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 quiet splash $nvdrm\"/" /mnt/etc/default/grub
			"$chroot" /mnt grub-mkconfig -o /boot/grub/grub.cfg || SHOWerror "GRUB mkconfig execution" ;;
		efistub)
			local boot_label="${OSsel^} Linux ($FSsel)"
			local BLflags="$initrd_flags ro $luks_flags resume=${PIDsel}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi"
			local efi_dev="$DRIVE"; local efi_num="$(echo "$BOOT_PART" | grep -o '[0-9]*$')"
			"$chroot" /mnt efibootmgr -d "$efi_dev" -p "${efi_num:-1}" -c -L "$boot_label" -l "\\$kname" -u "$BLflags" --verbose || SHOWerror "Efibootmgr execution" ;;
		limine)
			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${liminepkg[@]}" || SHOWerror "Limine package install"
			local efi_dev="$DRIVE"; local efi_num="$(echo "$BOOT_PART" | grep -o '[0-9]*$')"
			mkdir -p /mnt/boot/EFI/BOOT || SHOWerror "mkdir Limine EFI"
			cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/ || SHOWerror "Copy Limine EFI binary"
			local lim_ucode=""; [[ -n "$microcodepkg" ]] && lim_ucode="module_path: boot():/${microcodepkg}.img\n    "
			local lim_flags="rw $luks_flags resume=${PIDsel}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi"
			echo -e "timeout: 3\n\n/Linux (${OSsel^})\n    protocol: linux\n    kernel_path: boot():/${kname}\n    ${lim_ucode}module_path: boot():/${irfs}\n    cmdline: ${lim_flags}" > /mnt/boot/limine.conf || SHOWerror "Write limine.conf"
			"$chroot" /mnt efibootmgr -c -d "$efi_dev" -p "${efi_num:-1}" -L "Limine Bootloader" -l '\EFI\BOOT\BOOTX64.EFI' || SHOWerror "Efibootmgr Limine" ;;
		systemd-boot)
			"$chroot" /mnt bootctl --path=/boot install || SHOWerror "bootctl install execution"
			echo -e "default arch.conf\ntimeout 3\nconsole-mode max\neditor no" > /mnt/boot/loader/loader.conf || SHOWerror "Write loader.conf"
			local sd_ucode=""; [[ -n "$microcodepkg" ]] && sd_ucode="initrd /${microcodepkg}.img\n"
			local sd_flags="rw $luks_flags resume=${PIDsel}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi"
			echo -e "title Arch Linux\nlinux /${kname}\n${sd_ucode}initrd /${irfs}\noptions ${sd_flags}" > /mnt/boot/loader/entries/arch.conf || SHOWerror "Write arch.conf" ;;
		uki)
			"$chroot" /mnt $PKGmanager$PKGinst$PKGupd "${PKGskp[@]}" "${ukipkg[@]}" || SHOWerror "Systemd-ukify package install"
			local efi_dev="$DRIVE"; local efi_num="$(echo "$BOOT_PART" | grep -o '[0-9]*$')"
			mkdir -p /mnt/boot/EFI/BOOT || SHOWerror "mkdir UKI EFI"
			echo "rw $luks_flags resume=${PIDsel}=$SWAPID rootfstype=$FSsel $rootflags $nvdrm $nvosi" > /mnt/boot/cmdline.txt || SHOWerror "Write UKI cmdline"
			local uki_ucode=""; [[ -n "$microcodepkg" ]] && uki_ucode="--microcode=/boot/${microcodepkg}.img"
			"$chroot" /mnt ukify build --linux=/boot/${kname} --initrd=/boot/${irfs} ${uki_ucode} --cmdline=@/boot/cmdline.txt --output=/boot/EFI/BOOT/BOOTX64.EFI || SHOWerror "Ukify build execution"
			rm -f /mnt/boot/cmdline.txt
			"$chroot" /mnt efibootmgr -c -d "$efi_dev" -p "${efi_num:-1}" -L "Arch Linux (UKI)" -l '\EFI\BOOT\BOOTX64.EFI' || SHOWerror "Efibootmgr UKI" ;;
	esac
}
InstallationSetup () {
	VBTsel=0; [[ "$(lspci | grep -Ei 'VGA|3D')" =~ (VMware|VirtualBox|Virtio|QXL) ]] && VBTsel=1
	SetupAvaible=1; CheckandSetup=( Check_required_files UEFIsel KernelSel IRFsel BootloaderSel Pacman_Locked )
	if command -v timedatectl >/dev/null; then timedatectl set-ntp true || true
	elif command -v chronyd >/dev/null; then chronyd -q "pool pool.ntp.org iburst" || true
	elif command -v ntpdate >/dev/null; then ntpdate pool.ntp.org || true; fi
	echo 'List of all errors occurred during the installation process:' > Errors
	for c in "${CheckandSetup[@]}"; do "$c" || SHOWerror "$c"; done
	if [[ -s config ]]; then
		while true; do
			cat config && YesNoSel "It's correct?"
			if [[ "$CC" -eq 1 ]]; then SetupAvaible=0; source config; break
			else YesNoSel "Would you like to edit config file?"; [[ "$CC" -eq 1 ]] && { nano config; source config; } || { SetupAvaible=1; echo "Repeat the setup"; break; }; fi
		done
	fi
	if [[ "$SetupAvaible" == "1" ]]; then AutoOSsel
		[[ "${OSsel,,}" == "artix" ]] && ArchRepoSel
		[[ "${OSsel,,}" == "void" ]] && { VoidInstMethod && LibrarySel; }
		if [[ "$VBTsel" == "1" ]]; then LANGsel='en_GB.UTF-8'; LOCsel='it_IT.UTF-8'; HNsel=tarch1; UNsel=tarch1; TZsel='Europe/Rome'; PIDsel=UUID; FSsel=btrfs; ADD_SETUP=0; ADD_FORMAT=0; ADD_FS=""; ADD_LABEL=""; LUKSSel; [[ "${OSsel,,}" == "void" ]] && { LIBsel="GLIBC"; VImethod="XBPS"; }
		else local Personalization=( LocalizationSel LanguageSel TimezoneSel HostnameSel UsernameSel PartIDSel FilesystemSel AdditionalDriveSel LUKSSel DesktopEnvSel DisplayManagerSel )
			for s in "${Personalization[@]}"; do "$s" || SHOWerror "$s"; done; fi
		Steps=( "OSsel=$OSsel" "ARCHrepo=$ARCHrepo" "LANGsel=$LANGsel" "LOCsel=$LOCsel" "HNsel=$HNsel" "UNsel=$UNsel" "TZsel=$TZsel" "PIDsel=$PIDsel" "FSsel=$FSsel" "BLsel=$BLsel" "IRFSetup=$IRFSetup" "ADD_SETUP=$ADD_SETUP" "ADD_FORMAT=$ADD_FORMAT" "ADD_FS=$ADD_FS" "ADD_LABEL=$ADD_LABEL" "LUKS_ENC=$LUKS_ENC" "DEsel=$DEsel" "DMsel=$DMsel" )
		[[ -n "$GPUMANAGERsel" ]] && Steps+=( "GPUMANAGERsel=$GPUMANAGERsel" )
		[[ "${OSsel,,}" == "void" ]] && Steps+=( "LIBsel=$LIBsel" "VImethod=$VImethod" )
		rm -f config; for a in "${Steps[@]}"; do echo "$a" >> config; done; cat config
		while true; do
			YesNoSel "It's correct?"
			if [[ "$CC" -eq 1 ]]; then echo 'Proceeding...'; break
			else YesNoSel "Would you like to edit config file? (CRTL+S to save)"; [[ "$CC" -eq 1 ]] && { nano config; source config; cat config; } || { echo "Then start again"; SHOWerror "Second attempt"; }; fi
		done
	elif [[ "$SetupAvaible" == "0" && -s config ]]; then echo 'Setup loaded'
	else SHOWerror InstallationSetup; fi
	CPUsel && GPUsel
	local s_step; [[ "${OSsel,,}" == "void" ]] && s_step='VoidSystemInstall' || s_step='ArchTixSystemInstall'
	local ArchTixSteps=( 'DiskPartition' 'FileSystemFormat' )
	[[ "$VBTsel" -eq 0 ]] && ArchTixSteps+=( 'AdditionalDriveSetup' )
	ArchTixSteps+=( "$s_step" 'CrypttabGen' 'FStabGen' 'SetupEnvironment' 'PackageConfig' 'PackageInstall' 'KernelSetup' 'ServiceSetup' 'UserSetup' )
	[[ "$VBTsel" -eq 0 ]] && ArchTixSteps+=( 'AudioSetup' )
	ArchTixSteps+=( 'BootloaderSetup' )
	if [[ "${OSsel,,}" != "void" ]]; then
		PKGmanager="pacman"; PKGinst=" -S"; PKGupd="y"; PKGchk=" -Q"; PKGrmv=" -R"; PKGdpn="s"; PKGfrc="dd"
		PKGskp=( --needed --noconfirm ); PKGrsk=( --noconfirm ); keylayout='KEYMAP=it'; chroot="${OSsel,,}-chroot"
		if [[ "${OSsel,,}" == "arch" ]]; then keypath='etc/vconsole.conf'; PKGstrap=pacstrap; FSTABgen=genfstab; initc0=systemctl; initc1=enable
			sed -i -e 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' -e '/\[multilib]/,/mirrorlist/ s/#//' /etc/pacman.conf; $PKGmanager$PKGinst$PKGupd"lq" core extra multilib | sort > pacman_db || true
		elif [[ "${OSsel,,}" == "artix" ]]; then keypath='etc/conf.d/keymaps'; PKGstrap=basestrap; FSTABgen=fstabgen; initc0='rc-update'; initc1=add
			[[ "$initc0" == "rc-update" ]] && init_sys="openrc" || init_sys="runit"; sed -i -e 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' -e '/\[lib32]/,/mirrorlist/ s/#//' /etc/pacman.conf
			[[ "$ARCHrepo" == "1" ]] && ArchRepoSetup /etc/pacman.conf; $PKGmanager$PKGinst$PKGupd"lq" system world galaxy lib32 $([[ "$ARCHrepo" == "1" ]] && echo "universe extra multilib") | sort > pacman_db || true
		fi
	else
		PKGmanager="xbps"; PKGinst="-install"; PKGupd=" -S"; PKGchk="-query"; PKGrmv="-remove"; PKGdpn=" -R"; PKGfrc=" -F"
		PKGskp=( -y -y ); PKGrsk=( -y ); keylayout='KEYMAP=it'; keypath='etc/rc.conf'; [[ "$LIBsel" == "GLIBC" ]] && VoidArch="x86_64" || VoidArch="x86_64-musl"
		VoidRepo="https://voidlinux.org$([[ "$LIBsel" == "MUSL" ]] && echo "/musl")"; PKGstrap="$PKGmanager$PKGinst$PKGupd -R $VoidRepo -r /mnt ${PKGskp[*]}"; chroot="chroot"
	fi
	
	echo 'Running check for missing packages'; PKGcheck
	for a in "${ArchTixSteps[@]}"; do "$a" || SHOWerror "$a"; done
	
	echo -e "\n=== INSTALLATION COMPLETED ==="
	"$chroot" /mnt chown -hR "$UNsel":users /home/"$UNsel" || SHOWerror "Chown Home Directory"
	[[ "$(wc -l < Errors)" -gt 1 ]] && { echo -e "\n[!] Some errors logged during installation:" && cat Errors && cp Errors /mnt/var/log/installer_errors.log; } || echo "[+] Clean installation: zero errors detected."
	YesNoSel "Reboot system"
	[[ "$CC" -eq 1 ]] && { umount -R -l /mnt || true; reboot; } || { echo "OK"; exit 0; }
}

